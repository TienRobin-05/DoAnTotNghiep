@model DoAnTotNghiep.Models.Thong_Tin_Ca_Nhan_View_Model

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="profile-page">
    <div class="profile-card">
        <h1>Thông tin cá nhân</h1>
        <p>Cập nhật thông tin hồ sơ sức khỏe cơ bản.</p>

        @if (ViewBag.ThanhCong != null)
        {
            <div class="alert alert-success">@ViewBag.ThanhCong</div>
        }

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">@ViewBag.ThongBao</div>
        }

        <form asp-controller="Tai_Khoan" asp-action="ThongTinCaNhan" method="post">
            <div class="mb-3">
                <label class="form-label">Họ tên</label>
                <input asp-for="hoTen" class="form-control" />
                <span asp-validation-for="hoTen" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Ngày tháng năm sinh</label>
                <input asp-for="ngaySinh" type="date" class="form-control" />
                <span asp-validation-for="ngaySinh" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Giới tính</label>
                <select asp-for="gioiTinh" class="form-select">
                    <option value="">Chọn giới tính</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
                <span asp-validation-for="gioiTinh" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Số điện thoại</label>
                @* Số điện thoại lấy từ tài khoản đăng ký, chỉ hiển thị và không cho sửa. *@
                <input asp-for="soDienThoai" class="form-control" readonly />
            </div>

            <button type="submit" class="btn lc-save-btn">Lưu thông tin</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
