@* Khu vực giao diện của view Index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@{
    Layout = null;
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
    var daDangNhap = !string.IsNullOrWhiteSpace(hoTen);
    var trangSauDangNhap = vaiTro == "Admin"
        ? "/Admin/Index"
        : "/NguoiDung/Index";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HỒ SƠ SỨC KHỎE VÀ TIÊM CHỦNG</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Arial, Helvetica, sans-serif; background: linear-gradient(180deg, #e4f6f8, #f1f5ff); color: #102f38; }
        a { color: inherit; text-decoration: none; }
        .topbar { background: linear-gradient(90deg, #02aaa5, #05b7a8); color: #fff; }
        .topbar-inner { max-width: 1520px; height: 68px; margin: 0 auto; padding: 0 28px; display: grid; grid-template-columns: 225px minmax(260px, 600px) 164px 210px; gap: 16px; align-items: center; }
        .brand { display: flex; align-items: center; gap: 10px; font-weight: 900; font-size: 24px; line-height: 1.05; }
        .brand-mark { width: 46px; height: 30px; border-radius: 8px; background: linear-gradient(135deg, #2b62db 0 33%, #ff7d1a 33% 66%, #4fbd38 66%); box-shadow: inset 0 -8px 0 rgba(255,255,255,.12); }
        .search-box { height: 50px; border-radius: 28px; background: #fff; display: flex; align-items: center; padding: 0 8px 0 20px; box-shadow: 0 2px 0 rgba(0,0,0,.04); }
        .search-box input { flex: 1; border: 0; outline: 0; font-size: 17px; color: #425d67; }
        .search-box button { width: 42px; height: 42px; border: 0; border-radius: 50%; background: #e7f8fb; color: #057f90; font-size: 22px; cursor: pointer; }
        .login-btn, .consult-btn { height: 50px; border-radius: 28px; color: #fff; display: flex; align-items: center; justify-content: center; gap: 10px; font-weight: 800; white-space: nowrap; }
        .login-btn { background: #078989; }
        .consult-btn { background: #ff921f; }
        .login-dot, .headset-dot { width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,.95); color: #078989; display: grid; place-items: center; font-size: 13px; font-weight: 900; }
        .headset-dot { color: #ff921f; }
        .menu { background: rgba(255,255,255,.94); border-bottom: 1px solid #d8e7ee; }
        .menu-inner { max-width: 1520px; height: 50px; margin: 0 auto; display: flex; justify-content: center; overflow-x: auto; }
        .menu a { min-width: 150px; padding: 15px 22px; text-align: center; font-size: 17px; font-weight: 800; border-left: 1px solid #e2edf3; white-space: nowrap; }
        .page { max-width: 1520px; margin: 0 auto; padding: 44px 28px; }
        .hero-layout { display: grid; grid-template-columns: minmax(0, 2.08fr) minmax(410px, .95fr); gap: 18px; align-items: stretch; }
        .hero-card { min-height: 374px; border: 3px solid #fff; border-radius: 14px; overflow: hidden; position: relative; background: radial-gradient(circle at 72% 18%, #d7ffce 0, transparent 28%), linear-gradient(135deg, #d2fff3 0%, #42dde6 48%, #066ff0 100%); box-shadow: 0 12px 34px rgba(9, 92, 125, .14); }
        .hero-card:before { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, transparent 0 54px, rgba(255,255,255,.13) 55px 56px), linear-gradient(90deg, rgba(255,255,255,.15), transparent 45%); }
        .hero-content { position: relative; z-index: 2; width: 58%; padding: 34px 42px; }
        .hero-brand { display: inline-flex; align-items: center; gap: 10px; color: #075aa4; font-weight: 900; }
        .hero-brand span { width: 34px; height: 20px; border-radius: 5px; background: linear-gradient(135deg, #2b62db 0 33%, #ff7d1a 33% 66%, #4fbd38 66%); }
        .green-sm { color: #11bfa9; font-size: 23px; margin-left: 20px; }
        .hero-card h1 { margin: 32px 0 18px; font-size: 48px; line-height: 1.03; color: #0662bd; text-transform: uppercase; text-shadow: 0 3px 0 rgba(255,255,255,.55); }
        .hero-card h1 strong { display: block; font-size: 62px; color: #027ad5; }
        .coupon { display: inline-grid; grid-template-columns: 1fr auto; align-items: center; gap: 12px; padding: 10px 18px; background: #ffe44b; color: #0860b6; border: 4px solid #fff; border-radius: 14px; font-weight: 900; font-size: 24px; transform: rotate(-4deg); box-shadow: 0 9px 0 rgba(0,0,0,.08); }
        .coupon b { font-size: 42px; }
        .clinic { position: absolute; right: 52px; top: 70px; width: 286px; height: 160px; background: linear-gradient(180deg, #06c4e8, #0374cb); border: 5px solid rgba(255,255,255,.85); border-radius: 16px; transform: perspective(700px) rotateY(-10deg); box-shadow: 0 16px 30px rgba(1, 77, 135, .28); color: #fff; display: grid; place-items: center; text-align: center; font-size: 24px; font-weight: 900; }
        .vehicle { position: absolute; right: 80px; bottom: 44px; width: 330px; height: 86px; border-radius: 44px 52px 18px 18px; background: linear-gradient(135deg, #00b9b4, #89e9df); box-shadow: 0 12px 0 rgba(0,0,0,.12); }
        .vehicle:before, .vehicle:after { content: ""; position: absolute; bottom: -22px; width: 54px; height: 54px; border-radius: 50%; background: #26394a; border: 9px solid #d9f5f7; }
        .vehicle:before { left: 48px; }
        .vehicle:after { right: 46px; }
        .rider { position: absolute; right: 270px; bottom: 126px; width: 64px; height: 90px; border-radius: 40px 40px 16px 16px; background: #f6f6ff; box-shadow: 76px 0 0 #e9f7fb; }
        .rider:before { content: ""; position: absolute; left: 17px; top: -28px; width: 30px; height: 30px; border-radius: 50%; background: #ffcfad; box-shadow: 76px 0 0 #ffcfad; }
        .dots { position: absolute; left: 50%; bottom: 17px; display: flex; gap: 8px; transform: translateX(-50%); }
        .dots span { width: 9px; height: 9px; border-radius: 50%; background: rgba(0,93,179,.25); }
        .dots span:first-child { background: #ffb21f; }
        .warning { background: #fff; border-radius: 14px; padding: 18px; overflow: hidden; }
        .warning h2 { margin: 0 0 15px; color: #ff781b; font-size: 18px; }
        .warning-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
        .warning-card { min-height: 320px; border-radius: 10px; overflow: hidden; color: #fff; position: relative; display: flex; flex-direction: column; justify-content: flex-end; padding: 12px; background: linear-gradient(180deg, #ffc8b8 0%, #163653 68%, #071f34 100%); }
        .warning-card:nth-child(2) { background: linear-gradient(180deg, #b9d4de 0%, #25445b 65%, #071f34 100%); }
        .warning-card:nth-child(3) { background: linear-gradient(180deg, #b9edf5 0%, #1b5870 65%, #071f34 100%); }
        .warning-card:before { content: ""; position: absolute; left: 14px; top: 14px; right: 14px; height: 118px; border-radius: 12px; background: rgba(255,255,255,.35); }
        .play { position: absolute; top: 22px; left: 22px; width: 28px; height: 28px; border-radius: 50%; background: #fff; color: #0a6c8a; display: grid; place-items: center; font-size: 12px; font-weight: 900; }
        .warning-card small, .warning-card strong { position: relative; z-index: 2; }
        .warning-card small { color: #f7d45c; font-weight: 800; }
        .warning-card strong { display: block; margin-top: 8px; line-height: 1.35; font-size: 17px; }
        .benefits { margin-top: 0; background: #fff; border-radius: 0 0 14px 14px; display: grid; grid-template-columns: repeat(4, 1fr); }
        .benefit { padding: 14px 18px; display: grid; grid-template-columns: 46px 1fr; gap: 12px; align-items: center; border-right: 1px dashed #cbdce4; }
        .benefit-icon { width: 42px; height: 42px; border-radius: 50%; background: #ddfbf6; color: #0797a8; display: grid; place-items: center; font-weight: 900; }
        .benefit strong { display: block; font-size: 16px; }
        .benefit small { color: #4a6470; }
        .quick-grid { margin-top: 12px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
        .quick-card { background: #fff; min-height: 150px; border-radius: 10px; display: grid; place-items: center; text-align: center; padding: 16px; font-size: 18px; font-weight: 900; box-shadow: 0 10px 22px rgba(30, 73, 103, .07); transition: .18s; }
        .quick-card:hover { transform: translateY(-2px); box-shadow: 0 14px 28px rgba(30, 73, 103, .12); }
        .quick-icon { width: 66px; height: 66px; border-radius: 18px; background: linear-gradient(135deg, #d6fbf6, #e9f4ff); color: #0696a5; display: grid; place-items: center; font-size: 18px; font-weight: 900; }
        .section-head { margin: 34px 0 14px; display: flex; align-items: center; gap: 16px; color: #ff7716; text-transform: uppercase; font-size: 20px; font-weight: 900; }
        .section-head a { color: #4d6470; font-size: 15px; text-transform: none; font-weight: 700; }
        .doctor-row, .guide-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
        .doctor-card, .guide-card { background: #fff; border-radius: 12px; padding: 18px; box-shadow: 0 8px 18px rgba(30, 73, 103, .06); }
        .doctor-card .avatar { height: 96px; border-radius: 12px; margin-bottom: 12px; background: linear-gradient(135deg, #d4fbf4, #edf4ff); position: relative; }
        .doctor-card .avatar:after { content: "BS"; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 48px; height: 48px; border-radius: 50%; background: #fff; color: #0797a8; display: grid; place-items: center; font-weight: 900; }
        .guide-card p { color: #4a6470; }
        .footer { margin-top: 34px; padding: 24px; border-radius: 12px; background: #073b4c; color: #e8fcff; display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
        .footer-links { display: flex; gap: 18px; flex-wrap: wrap; }
        @@media (max-width: 1100px) { .topbar-inner { height: auto; padding: 12px 18px; grid-template-columns: 1fr; } .hero-layout, .doctor-row, .guide-row { grid-template-columns: 1fr; } .quick-grid { grid-template-columns: repeat(2, 1fr); } .benefits { grid-template-columns: repeat(2, 1fr); } .clinic, .vehicle, .rider { opacity: .28; } .hero-content { width: 78%; } }
        @@media (max-width: 640px) { .page { padding: 24px 12px; } .menu-inner { justify-content: flex-start; } .hero-card h1 { font-size: 32px; } .hero-card h1 strong { font-size: 42px; } .hero-content { width: 100%; padding: 24px; } .warning-grid, .benefits, .quick-grid { grid-template-columns: 1fr; } .coupon { font-size: 18px; } .coupon b { font-size: 28px; } }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="/">
                <span class="brand-mark"></span>
                <span>HỒ SƠ SỨC KHỎE<br />VÀ TIÊM CHỦNG</span>
            </a>
            @* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
            <form class="search-box" action="/Vaccine/TraCuu" method="get">
                <input name="tuKhoa" placeholder="Bạn cần tìm gì?" />
                <button type="submit">⌕</button>
            </form>
            @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
            @if (daDangNhap)
            {
                <a class="login-btn" href="@trangSauDangNhap"><span class="login-dot">TK</span>@hoTen</a>
            }
            else
            {
                <a class="login-btn" href="/TaiKhoan/DangNhap"><span class="login-dot">TK</span>Đăng nhập</a>
            }
            <a class="consult-btn" href="/TaiKhoan/DangNhap"><span class="headset-dot">TV</span>Yêu cầu tư vấn</a>
        </div>
    </header>

    <nav class="menu">
        <div class="menu-inner">
            <a href="/Vaccine/TraCuu">Vắc xin phòng bệnh</a>
            <a href="/TaiKhoan/DangNhap">Gói vắc xin</a>
            <a href="/BaiVietCamNang/Index">Khuyến mãi</a>
            <a href="/">Hệ thống tiêm chủng</a>
            <a href="/Vaccine/TraCuu">Tôi nên tiêm gì</a>
            <a href="/TaiKhoan/DangNhap">Đội ngũ chuyên môn</a>
            <a href="/BaiVietCamNang/Index">Kiến thức tiêm chủng</a>
        </div>
    </nav>

    <main class="page">
        <section class="hero-layout">
            <div>
                <article class="hero-card">
                    <div class="hero-content">
                        <div class="hero-brand"><span></span>HỒ SƠ SỨC KHỎE VÀ TIÊM CHỦNG <b class="green-sm">GREEN SM</b></div>
                        <h1>Tiêm chủng TIẾN <strong>Đón đưa</strong></h1>
                        <div class="coupon"><span>Ưu đãi đến 20%</span><b>50K</b></div>
                    </div>
                    <div class="clinic">TIÊM CHỦNG<br />SỨC KHỎE</div>
                    <div class="vehicle"></div>
                    <div class="rider"></div>
                    <div class="dots"><span></span><span></span><span></span><span></span><span></span></div>
                </article>
                <div class="benefits">
                    <div class="benefit"><span class="benefit-icon">GSP</span><div><strong>Bảo quản chuẩn GSP</strong><small>Vắc xin luôn được đảm bảo chất lượng...</small></div></div>
                    <div class="benefit"><span class="benefit-icon">BS</span><div><strong>Đội ngũ bác sĩ giàu kinh nghiệm</strong><small>Từ bệnh viện Nhi Đồng, Pasteur,...</small></div></div>
                    <div class="benefit"><span class="benefit-icon">Sổ</span><div><strong>Sổ tiêm chủng điện tử</strong><small>Nhắc lịch hẹn khoa học cho cả gia...</small></div></div>
                    <div class="benefit"><span class="benefit-icon">%</span><div><strong>Mua vắc xin giảm giá mua thuốc</strong><small>Cùng những ưu đãi hấp dẫn</small></div></div>
                </div>
            </div>

            <aside class="warning">
                <h2>CẢNH BÁO QUAN TRỌNG</h2>
                <div class="warning-grid">
                    <a class="warning-card" href="/BaiVietCamNang/Index"><span class="play">▶</span><small>Radar sức khỏe</small><strong>Khánh Hòa ghi nhận hơn 2.200 ca tay chân miệng...</strong></a>
                    <a class="warning-card" href="/BaiVietCamNang/Index"><span class="play">▶</span><small>Khuyến cáo</small><strong>Ebola có thể khởi phát giống cảm cúm nhưng diễn tiến rất...</strong></a>
                    <a class="warning-card" href="/BaiVietCamNang/Index"><span class="play">▶</span><small>Virus mới</small><strong>Nhóm virus corona mới vừa được phát hiện...</strong></a>
                </div>
            </aside>
        </section>

        <section class="quick-grid">
            <a class="quick-card" href="/Vaccine/TraCuu"><span class="quick-icon">?</span><span>Tôi nên tiêm gì?</span></a>
            <a class="quick-card" href="/TaiKhoan/DangNhap"><span class="quick-icon">BS</span><span>Chat với bác sĩ</span></a>
            <a class="quick-card" href="/Vaccine/TraCuu"><span class="quick-icon">VX</span><span>Danh mục vắc xin</span></a>
            <a class="quick-card" href="/TaiKhoan/DangNhap"><span class="quick-icon">Sổ</span><span>Sổ tiêm của tôi</span></a>
            <a class="quick-card" href="/TaiKhoan/DangNhap"><span class="quick-icon">TT</span><span>Trung tâm gần tôi</span></a>
            <a class="quick-card" href="/BaiVietCamNang/Index"><span class="quick-icon">KN</span><span>Kiến thức tiêm chủng</span></a>
        </section>

        <div class="section-head"><span>Đội ngũ chuyên môn</span><a href="/TaiKhoan/DangNhap">Xem tất cả</a></div>
        <section class="doctor-row">
            <article class="doctor-card"><div class="avatar"></div><strong>Tư vấn lịch tiêm phù hợp</strong><p>Hỗ trợ giải đáp câu hỏi về hồ sơ và mũi tiêm.</p></article>
            <article class="doctor-card"><div class="avatar"></div><strong>Theo dõi sau tiêm</strong><p>Ghi nhận lịch sử và tình trạng sức khỏe sau tiêm.</p></article>
            <article class="doctor-card"><div class="avatar"></div><strong>Nhắc lịch khoa học</strong><p>Giúp người dùng không bỏ sót các mũi tiêm quan trọng.</p></article>
            <article class="doctor-card"><div class="avatar"></div><strong>Cẩm nang sức khỏe</strong><p>Cung cấp kiến thức cơ bản về phòng bệnh.</p></article>
        </section>

        <div class="section-head"><span>Kiến thức tiêm chủng</span><a href="/BaiVietCamNang/Index">Xem tất cả</a></div>
        <section class="guide-row">
            <article class="guide-card"><h3>Những điều cần biết trước khi tiêm vaccine</h3><p>Chuẩn bị thông tin sức khỏe và tiền sử dị ứng trước khi tiêm.</p><a href="/BaiVietCamNang/Index">Xem bài viết</a></article>
            <article class="guide-card"><h3>Cách theo dõi sau tiêm</h3><p>Ghi nhận phản ứng sau tiêm và liên hệ tư vấn khi cần.</p><a href="/BaiVietCamNang/Index">Xem bài viết</a></article>
            <article class="guide-card"><h3>Vì sao cần tiêm đúng lịch?</h3><p>Tiêm đúng lịch giúp duy trì hiệu quả phòng bệnh tốt hơn.</p><a href="/BaiVietCamNang/Index">Xem bài viết</a></article>
            <article class="guide-card"><h3>Quản lý hồ sơ sức khỏe gia đình</h3><p>Lưu hồ sơ để theo dõi chỉ số và lịch tiêm thuận tiện hơn.</p><a href="/TaiKhoan/DangNhap">Xem hồ sơ</a></article>
        </section>

        <footer class="footer">
            <div><strong>HỒ SƠ SỨC KHỎE VÀ TIÊM CHỦNG</strong><p>Trang chủ công khai cho hệ thống quản lý hồ sơ sức khỏe và tiêm chủng.</p></div>
            <div class="footer-links">
                <a href="/TaiKhoan/DangNhap">Hồ sơ sức khỏe</a>
                <a href="/TaiKhoan/DangNhap">Lịch tiêm</a>
                <a href="/TaiKhoan/DangNhap">Tư vấn</a>
                <a href="/TaiKhoan/DangNhap">Đăng nhập</a>
            </div>
        </footer>
    </main>
</body>
</html>
