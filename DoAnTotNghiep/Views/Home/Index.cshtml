@* Trang giới thiệu công khai trước khi người dùng đăng nhập. *@
@{
    Layout = null;
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
    var daDangNhap = !string.IsNullOrWhiteSpace(hoTen);
    var trangSauDangNhap = vaiTro == "Admin" ? "/Admin/Index" : "/NguoiDung/Index";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hệ thống quản lý sức khỏe và lịch tiêm chủng</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: #102a43;
            background: #f4f8ff;
        }
        a { text-decoration: none; }

        .header {
            background: #ffffff;
            border-bottom: 1px solid #dbe7f5;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .05);
        }
        .header-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 16px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #0b63ce;
            font-size: 24px;
            font-weight: bold;
        }
        .brand-icon {
            width: 46px;
            height: 48px;
            border-radius: 12px 12px 22px 22px;
            background: linear-gradient(180deg, #2f80ff 0%, #0b63ce 100%);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            font-weight: bold;
            line-height: 1;
            box-shadow: 0 8px 18px rgba(11, 99, 206, 0.22);
        }
        .header-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .btn {
            display: inline-block;
            min-width: 120px;
            padding: 12px 20px;
            border-radius: 8px;
            border: 1px solid #0b63ce;
            color: #0b63ce;
            background: #ffffff;
            font-weight: bold;
            text-align: center;
        }
        .btn-primary {
            color: #ffffff;
            background: #0b63ce;
        }

        .main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 42px 24px 28px;
        }
        .hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 36px;
            align-items: center;
        }
        .tag {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 20px;
            background: #e1efff;
            color: #0b63ce;
            font-weight: bold;
            margin-bottom: 18px;
        }
        h1 {
            margin: 0 0 16px;
            font-size: 44px;
            line-height: 1.15;
            color: #102a43;
        }
        h1 span { color: #0b63ce; }
        .hero p {
            margin: 0 0 24px;
            color: #52616b;
            font-size: 18px;
            line-height: 1.6;
        }
        .hero-actions {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }
        .hero-image {
            text-align: center;
        }
        .hero-image img {
            max-width: 100%;
            height: auto;
        }

        .features {
            margin-top: 34px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }
        .feature-card {
            background: #ffffff;
            border: 1px solid #dbe7f5;
            border-radius: 10px;
            padding: 22px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, .05);
        }
        .feature-card h2 {
            margin: 0 0 10px;
            color: #102a43;
            font-size: 20px;
        }
        .feature-card p {
            margin: 0;
            color: #52616b;
            line-height: 1.5;
        }

        .note {
            margin-top: 24px;
            padding: 20px;
            border-radius: 10px;
            background: #eaf4ff;
            color: #24435c;
            line-height: 1.5;
        }
        .note strong {
            display: block;
            margin-bottom: 6px;
            color: #0b63ce;
            font-size: 20px;
        }

        .footer {
            margin-top: 30px;
            background: #0b63ce;
            color: #ffffff;
        }
        .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }
        .footer a {
            color: #ffffff;
            margin-left: 16px;
        }

        @@media (max-width: 900px) {
            .header-inner, .footer-inner { align-items: flex-start; flex-direction: column; }
            .hero { grid-template-columns: 1fr; }
            .features { grid-template-columns: 1fr; }
            h1 { font-size: 34px; }
            .brand { font-size: 20px; }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="header-inner">
            <a class="brand" href="/">
                <span class="brand-icon">+</span>
                <span>Hệ thống quản lý sức khỏe và lịch tiêm chủng</span>
            </a>
            <div class="header-actions">
                @if (daDangNhap)
                {
                    <a class="btn" href="@trangSauDangNhap">Vào hệ thống</a>
                    <a class="btn btn-primary" href="/TaiKhoan/DangXuat">Đăng xuất</a>
                }
                else
                {
                    <a class="btn" href="/TaiKhoan/DangNhap">Đăng nhập</a>
                    <a class="btn btn-primary" href="/TaiKhoan/DangKy">Đăng ký</a>
                }
            </div>
        </div>
    </header>

    <main class="main">
        <section class="hero">
            <div>
                <div class="tag">An toàn - Chính xác - Tiện lợi</div>
                <h1>Theo dõi sức khỏe và <span>lịch tiêm chủng</span> dễ dàng</h1>
                <p>
                    Hệ thống hỗ trợ người dùng quản lý hồ sơ sức khỏe, theo dõi lịch tiêm,
                    nhận thông báo nhắc lịch và tra cứu thông tin vaccine.
                </p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="/TaiKhoan/DangKy">Đăng ký</a>
                    <a class="btn" href="/TaiKhoan/DangNhap">Đăng nhập</a>
                </div>
            </div>
            <div class="hero-image">
                <img src="/images/home-hero-health-vaccine.png" alt="Minh họa quản lý sức khỏe và lịch tiêm chủng" />
            </div>
        </section>

        <section class="features">
            <article class="feature-card">
                <h2>Quản lý hồ sơ sức khỏe</h2>
                <p>Lưu thông tin sức khỏe của bản thân hoặc người thân trong cùng một tài khoản.</p>
            </article>
            <article class="feature-card">
                <h2>Theo dõi lịch tiêm</h2>
                <p>Xem danh sách vaccine, mũi tiêm, ngày dự kiến và trạng thái tiêm.</p>
            </article>
            <article class="feature-card">
                <h2>Nhắc lịch tự động</h2>
                <p>Nhận thông báo khi có mũi tiêm sắp đến hạn hoặc cần cập nhật trạng thái.</p>
            </article>
        </section>

        <section class="note">
            <strong>Vì sức khỏe của bạn và gia đình</strong>
            Hệ thống tập trung vào việc quản lý hồ sơ, lịch tiêm, lịch sử tiêm và thông báo nhắc lịch.
            Các thông tin trong hệ thống chỉ mang tính hỗ trợ, người dùng vẫn cần đến cơ sở y tế để được tư vấn và tiêm chủng thực tế.
        </section>
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <div>
                <strong>Hệ thống quản lý sức khỏe và lịch tiêm chủng</strong><br />
                <span>© 2025. Đồ án tốt nghiệp.</span>
            </div>
            <div>
                <a href="/">Giới thiệu</a>
                <a href="/Home/Privacy">Chính sách</a>
                <a href="/CauHoiTuVan/Index">Liên hệ</a>
            </div>
        </div>
    </footer>
</body>
</html>
