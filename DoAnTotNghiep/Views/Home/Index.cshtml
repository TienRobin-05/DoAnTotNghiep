@* Trang landing công khai của Pharmacy City. *@
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý sức khỏe và lịch tiêm chủng Pharmacy City</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/images/logo/pharmacy-favicon.png")" />
    <link rel="shortcut icon" type="image/png" href="@Url.Content("~/images/logo/pharmacy-favicon.png")" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --pc-primary: #0066CC;
            --pc-primary-dark: #0056B3;
            --pc-green: #43A047;
            --pc-page: #F4FAFF;
            --pc-surface: #FFFFFF;
            --pc-footer: #052C48;
            --pc-text: #0F172A;
            --pc-muted: #64748B;
            --pc-border: #DCEBFA;
            --pc-soft-blue: #EAF3FF;
            --pc-shadow: 0 12px 35px rgba(15, 23, 42, 0.10);
            --pc-shadow-soft: 0 4px 14px rgba(15, 23, 42, 0.05);
        }

        * { box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            background: var(--pc-page);
            color: var(--pc-text);
            font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        }

        a { color: inherit; text-decoration: none; }
        button, input { font: inherit; }

        .pc-topbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: #ffffff;
            border-bottom: 1px solid #E5EDF7;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        }

        .pc-container { max-width: 1440px; margin: 0 auto; padding: 0 32px; }

        .pc-topbar-inner {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .pc-brand { display: flex; align-items: center; gap: 18px; min-width: 0; }
        .pc-brand-logo { width: auto; height: 52px; flex-shrink: 0; object-fit: contain; }
        .pc-brand-divider { width: 1px; height: 34px; flex-shrink: 0; background: var(--pc-border); }
        .pc-brand-title { color: #004EA8; font-size: 19px; font-weight: 700; line-height: 1.35; white-space: nowrap; }
        .pc-topbar-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }

        .pc-btn {
            min-width: 118px;
            min-height: 42px;
            border: 1px solid var(--pc-primary);
            border-radius: 8px;
            padding: 0 22px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--pc-primary);
            background: #ffffff;
            font-weight: 700;
            line-height: 1.2;
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .pc-btn:hover { background: var(--pc-soft-blue); color: var(--pc-primary); }
        .pc-btn-primary { background: var(--pc-primary); color: #ffffff; }
        .pc-btn-primary:hover { background: var(--pc-primary-dark); color: #ffffff; }

        .pc-hero {
            overflow: hidden;
            background: linear-gradient(180deg, #F4FAFF 0%, #FFFFFF 100%);
            padding: 34px 0 24px;
        }

        .pc-hero-inner {
            display: grid;
            grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.5fr);
            align-items: center;
            gap: 32px;
        }

        .pc-trust-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
            border-radius: 999px;
            background: var(--pc-soft-blue);
            color: var(--pc-primary);
            padding: 8px 14px;
            font-weight: 700;
        }

        .pc-hero-title {
            margin: 0 0 14px;
            color: var(--pc-primary);
            font-size: clamp(38px, 4vw, 52px);
            font-weight: 800;
            line-height: 1.12;
            letter-spacing: 0;
        }

        .pc-hero-desc { max-width: 560px; margin: 0 0 22px; color: #475569; font-size: 16px; line-height: 1.65; }

        .pc-hero-chips {
            display: flex;
            align-items: stretch;
            max-width: 560px;
            overflow: hidden;
            border: 1px solid var(--pc-border);
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        }

        .pc-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            border-right: 1px solid #E5EDF7;
            padding: 14px 16px;
            color: var(--pc-text);
            font-size: 14px;
            font-weight: 700;
            line-height: 1.35;
        }

        .pc-chip:last-child { border-right: none; }
        .pc-chip-mark { color: var(--pc-primary); font-size: 18px; font-weight: 800; line-height: 1; }

        .pc-hero-visual {
            position: relative;
            min-height: 330px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pc-visual-card { width: 100%; max-width: 760px; }
        .pc-hero-image { display: block; width: 100%; height: auto; object-fit: contain; }

        .pc-feature-arrow { display: flex; align-items: center; justify-content: center; }

        .pc-features { background: #ffffff; }
        .pc-feature-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; padding-top: 26px; padding-bottom: 18px; }

        .pc-feature-card {
            position: relative;
            min-height: 150px;
            display: flex;
            align-items: flex-start;
            gap: 18px;
            border: 1px solid var(--pc-border);
            border-radius: 14px;
            background: #ffffff;
            color: var(--pc-text);
            padding: 22px;
            box-shadow: var(--pc-shadow-soft);
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .pc-feature-card:hover { border-color: #8BB8F3; box-shadow: 0 8px 22px rgba(0, 102, 204, 0.10); transform: translateY(-2px); }
        .pc-feature-icon { width: 56px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #ffffff; font-size: 24px; font-weight: 800; }
        .pc-blue { background: var(--pc-primary); }
        .pc-green { background: var(--pc-green); }
        .pc-feature-card h3 { margin: 0 0 8px; color: var(--pc-text); font-size: 17px; font-weight: 800; line-height: 1.35; }
        .pc-feature-card p { margin: 0; color: var(--pc-muted); font-size: 14px; line-height: 1.55; }
        .pc-feature-arrow { position: absolute; right: 18px; bottom: 18px; width: 28px; height: 28px; border-radius: 999px; background: var(--pc-soft-blue); color: var(--pc-primary); font-weight: 800; }

        .pc-trust-strip-section { background: #ffffff; padding: 8px 0 28px; }
        .pc-trust-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: hidden; border: 1px solid var(--pc-border); border-radius: 14px; background: #ffffff; box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04); }
        .pc-trust-item { display: flex; align-items: center; gap: 18px; border-right: 1px solid #E5EDF7; padding: 22px; }
        .pc-trust-item:last-child { border-right: none; }
        .pc-trust-icon { color: var(--pc-green); font-size: 34px; font-weight: 800; line-height: 1; }
        .pc-trust-item h4 { margin: 0 0 6px; color: var(--pc-text); font-size: 16px; font-weight: 800; }
        .pc-trust-item p { margin: 0; color: var(--pc-muted); font-size: 14px; line-height: 1.45; }

        .pc-footer { background: var(--pc-footer); color: #ffffff; padding: 0; }
        .pc-footer-bottom { max-width: 1440px; margin: 0 auto; padding: 16px 32px; border-top: 1px solid rgba(255,255,255,.18); color: #D7E8F7; font-size: 14px; font-weight: 700; text-align: center; }

        @@media (max-width: 1200px) {
            .pc-hero-inner { grid-template-columns: 1fr; }
            .pc-feature-grid, .pc-trust-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .pc-brand-title { white-space: normal; font-size: 17px; }
        }

        @@media (max-width: 768px) {
            .pc-container { padding: 0 18px; }
            .pc-topbar-inner { align-items: flex-start; flex-direction: column; padding: 14px 0; }
            .pc-brand { gap: 12px; }
            .pc-brand-logo { height: 46px; }
            .pc-topbar-actions { width: 100%; justify-content: flex-end; }
            .pc-btn { min-width: 104px; padding: 0 16px; }
            .pc-hero { padding-top: 40px; }
            .pc-hero-title { font-size: 38px; }
            .pc-hero-chips { flex-direction: column; }
            .pc-chip { border-right: none; border-bottom: 1px solid #E5EDF7; }
            .pc-chip:last-child { border-bottom: none; }
            .pc-feature-grid, .pc-trust-strip { grid-template-columns: 1fr; }
            .pc-trust-item { border-right: none; border-bottom: 1px solid #E5EDF7; }
            .pc-trust-item:last-child { border-bottom: none; }
        }
    </style>
</head>
<body>
    <header class="pc-topbar">
        <div class="pc-container pc-topbar-inner">
            <a class="pc-brand" href="/" aria-label="Pharmacy City">
                <img src="@Url.Content("~/images/logo/pharmacy-logo.png")" alt="Pharmacy City" class="pc-brand-logo" />
                <div class="pc-brand-divider"></div>
                <div class="pc-brand-title">Quản lý sức khỏe và lịch tiêm chủng Pharmacy City</div>
            </a>

            <div class="pc-topbar-actions">
                <a class="pc-btn" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                <a class="pc-btn pc-btn-primary" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a>
            </div>
        </div>
    </header>

    <main>
        <section class="pc-hero">
            <div class="pc-container pc-hero-inner">
                <div class="pc-hero-content">
                    <div class="pc-trust-badge"><span>✓</span><span>An toàn - Chính xác - Tiện lợi</span></div>
                    <h1 class="pc-hero-title">Đúng lịch tiêm -<br />An tâm khỏe</h1>
                    <p class="pc-hero-desc">
                        Pharmacy City giúp bạn lưu trữ hồ sơ sức khỏe, theo dõi lịch tiêm chủng,
                        nhận nhắc lịch tự động và tra cứu thông tin vaccine dễ dàng, chính xác.
                    </p>
                    <div class="pc-hero-chips">
                        <div class="pc-chip"><span class="pc-chip-mark">+</span><span>Lưu hồ sơ thông minh</span></div>
                        <div class="pc-chip"><span class="pc-chip-mark">!</span><span>Nhắc lịch tự động</span></div>
                        <div class="pc-chip"><span class="pc-chip-mark">?</span><span>Tra cứu vaccine nhanh chóng</span></div>
                    </div>
                </div>

                <div class="pc-hero-visual">
                    <div class="pc-visual-card">
                        <img src="@Url.Content("~/images/hero/health-hero.png")" alt="Theo dõi sức khỏe và lịch tiêm chủng" class="pc-hero-image" />
                    </div>
                </div>
            </div>
        </section>

        <section class="pc-features">
            <div class="pc-container pc-feature-grid">
                <a href="/HoSoSucKhoe/Index" class="pc-feature-card">
                    <div class="pc-feature-icon pc-blue">+</div>
                    <div><h3>Quản lý hồ sơ sức khỏe</h3><p>Lưu trữ và quản lý hồ sơ sức khỏe của bạn và gia đình một cách khoa học, dễ dàng.</p></div>
                    <span class="pc-feature-arrow">›</span>
                </a>
                <a href="/LichTiem/ChonHoSo" class="pc-feature-card">
                    <div class="pc-feature-icon pc-green">✓</div>
                    <div><h3>Theo dõi lịch tiêm</h3><p>Xem lịch tiêm, mũi tiêm, ngày dự kiến và trạng thái tiêm theo từng hồ sơ.</p></div>
                    <span class="pc-feature-arrow">›</span>
                </a>
                <a href="/vaccine/TraCuu" class="pc-feature-card">
                    <div class="pc-feature-icon pc-blue">i</div>
                    <div><h3>Tra cứu vaccine</h3><p>Tìm kiếm thông tin vaccine và kiến thức cần thiết trước khi sử dụng, tiêm.</p></div>
                    <span class="pc-feature-arrow">›</span>
                </a>
                <a href="/ThongBao/Index" class="pc-feature-card">
                    <div class="pc-feature-icon pc-green">!</div>
                    <div><h3>Nhắc lịch tự động</h3><p>Nhận thông báo khi có mũi tiêm sắp đến hạn hoặc cần cập nhật trạng thái.</p></div>
                    <span class="pc-feature-arrow">›</span>
                </a>
            </div>
        </section>

        <section class="pc-trust-strip-section">
            <div class="pc-container">
                <div class="pc-trust-strip">
                    <div class="pc-trust-item"><div class="pc-trust-icon">✓</div><div><h4>Bảo mật tuyệt đối</h4><p>Bảo vệ thông tin cá nhân với tiêu chuẩn cao nhất.</p></div></div>
                    <div class="pc-trust-item"><div class="pc-trust-icon">●</div><div><h4>Dữ liệu an toàn</h4><p>Mã hóa và lưu trữ an toàn, không chia sẻ bên thứ ba.</p></div></div>
                    <div class="pc-trust-item"><div class="pc-trust-icon">✓</div><div><h4>Chính xác - Tin cậy</h4><p>Thông tin vaccine được cập nhật từ nguồn chính thống.</p></div></div>
                    <div class="pc-trust-item"><div class="pc-trust-icon">+</div><div><h4>Đồng hành cùng bạn</h4><p>Pharmacy City luôn đồng hành vì sức khỏe của gia đình bạn.</p></div></div>
                </div>
            </div>
        </section>
    </main>

    <footer class="pc-footer">
        <div class="pc-footer-bottom">© 2026 Pharmacy City – Hệ thống quản lý sức khỏe và lịch tiêm chủng</div>
    </footer>
</body>
</html>
