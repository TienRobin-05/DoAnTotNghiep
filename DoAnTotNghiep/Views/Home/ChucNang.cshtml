@{
    ViewData["Title"] = "Chức năng";

    var id = (ViewBag.MaChucNang as string) ?? "";
    var tenChucNang = id switch
    {
        "quan-ly-vaccine" => "Quản lý Vaccine",
        "quan-ly-mui-tiem" => "Quản lý mũi tiêm",
        "quan-ly-bai-viet" => "Quản lý bài viết cẩm nang",
        "quan-ly-tu-van" => "Quản lý câu hỏi tư vấn",
        "quan-ly-du-lieu" => "Quản lý dữ liệu hệ thống",
        "ho-so-suc-khoe" => "Quản lý hồ sơ sức khỏe",
        "lich-tiem" => "Xem lịch tiêm",
        "cap-nhat-tiem" => "Cập nhật trạng thái tiêm",
        "lich-su-tiem" => "Xem lịch sử tiêm",
        "thong-bao" => "Thông báo nhắc lịch",
        "tra-cuu-vaccine" => "Tra cứu Vaccine",
        "hoi-dap-tu-van" => "Hỏi đáp tư vấn",
        _ => "Chức năng hệ thống"
    };
}

<section class="module-page">
    <a class="back-link" asp-controller="Home" asp-action="Index">Quay lại trang chủ</a>
    <h1>@tenChucNang</h1>
    <p>
        Màn hình này đã được nối từ trang chủ. Bước tiếp theo là tạo controller, model và view xử lý dữ liệu tương ứng.
    </p>
</section>
