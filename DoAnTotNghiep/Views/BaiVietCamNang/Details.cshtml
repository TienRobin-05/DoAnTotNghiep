@* Khu vực giao diện của view Details.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model BaiVietCamNang
@{
    ViewData["Title"] = Model.TieuDe;
}

<h1 class="user-page-title">@Model.TieuDe</h1>
<p class="text-muted">
    <span class="article-type-pill">@Model.LoaiBaiViet</span>
    Tác giả: @Model.TenTacGia - @Model.NgayTao.ToString("dd/MM/yyyy")
</p>

<section class="article-detail-card">
    @if (!string.IsNullOrWhiteSpace(Model.AnhDaiDien))
    {
        <div class="article-cover article-cover-inside">
            <img src="@Model.AnhDaiDien" alt="@Model.TieuDe" />
        </div>
    }
    <div class="article-content article-content-inside">@Model.NoiDung</div>
</section>

<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
