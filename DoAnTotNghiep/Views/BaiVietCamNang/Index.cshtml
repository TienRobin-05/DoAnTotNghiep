@{
    ViewData["Title"] = "Tin tức & Cẩm nang sức khỏe";
}

<style>
    body.site-page-shell {
        background: #f3f8ff;
    }

    body.site-page-shell > main.page {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
        background: transparent;
    }

    .knowledge-page {
        color: #0f2544;
        background: #f3f8ff;
    }

    .knowledge-hero {
        background: linear-gradient(135deg, #f1f7ff 0%, #eaf5ff 100%);
        border-bottom: 1px solid #dbe6f3;
    }

    .knowledge-container {
        width: min(100%, 1440px);
        margin: 0 auto;
        padding: 0 48px;
    }

    .knowledge-hero-inner {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 32px;
        align-items: center;
        min-height: 210px;
        padding-top: 28px;
        padding-bottom: 28px;
        overflow: hidden;
    }

    .knowledge-hero-inner::after {
        content: "";
        position: absolute;
        inset: 18px 350px auto auto;
        width: 220px;
        height: 130px;
        border-radius: 999px 999px 40px 999px;
        background: rgba(37, 99, 235, .06);
        transform: rotate(-12deg);
        pointer-events: none;
    }

    .knowledge-heading {
        position: relative;
        z-index: 1;
    }

    .knowledge-heading h1 {
        margin: 0 0 14px;
        color: #0f2544;
        font-size: 48px;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: 0;
    }

    .knowledge-heading p {
        max-width: 720px;
        margin: 0;
        color: #64748b;
        font-size: 20px;
        line-height: 1.5;
    }

    .knowledge-total-card {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 58px minmax(0, 1fr);
        gap: 16px;
        align-items: center;
        padding: 24px;
        border: 1px solid #cfe1f6;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 16px 36px rgba(15, 37, 68, .08);
    }

    .knowledge-total-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        border-radius: 14px;
        color: #2563eb;
        background: #eaf2ff;
        font-size: 25px;
    }

    .knowledge-total-number {
        display: flex;
        align-items: baseline;
        gap: 7px;
        color: #0f2544;
        font-weight: 800;
    }

    .knowledge-total-number strong {
        font-size: 34px;
        line-height: 1;
    }

    .knowledge-total-card small {
        display: block;
        margin-top: 7px;
        color: #64748b;
        font-weight: 650;
    }

    .knowledge-filter-band {
        background: #fff;
        border-bottom: 1px solid #dbe6f3;
    }

    .knowledge-filterbar {
        display: grid;
        grid-template-columns: 390px minmax(0, 1fr) 190px;
        gap: 16px;
        align-items: center;
        padding-top: 20px;
        padding-bottom: 20px;
    }

    .knowledge-search {
        position: relative;
    }

    .knowledge-search i {
        position: absolute;
        top: 50%;
        left: 16px;
        color: #64748b;
        transform: translateY(-50%);
    }

    .knowledge-search input,
    .knowledge-sort {
        width: 100%;
        height: 52px;
        border: 1px solid #dbe6f3;
        border-radius: 12px;
        color: #0f2544;
        background: #fff;
        font: inherit;
        font-weight: 650;
        outline: none;
    }

    .knowledge-search input {
        padding: 0 16px 0 44px;
    }

    .knowledge-sort {
        padding: 0 14px;
        cursor: pointer;
    }

    .knowledge-tabs {
        display: flex;
        gap: 10px;
        min-width: 0;
        overflow-x: auto;
        scrollbar-width: none;
    }

    .knowledge-tabs::-webkit-scrollbar {
        display: none;
    }

    .knowledge-tab {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 52px;
        padding: 0 18px;
        border: 1px solid #dbe6f3;
        border-radius: 12px;
        color: #0f2544;
        background: #fff;
        font: inherit;
        font-weight: 750;
        white-space: nowrap;
        cursor: pointer;
    }

    .knowledge-tab.is-active {
        border-color: #2563eb;
        color: #fff;
        background: #2563eb;
        box-shadow: 0 10px 20px rgba(37, 99, 235, .18);
    }

    .knowledge-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 24px;
        padding-top: 28px;
        padding-bottom: 46px;
    }

    .article-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .article-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 344px;
        overflow: hidden;
        border: 1px solid #dbe6f3;
        border-radius: 16px;
        color: inherit;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15, 37, 68, .06);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    .article-card:hover {
        border-color: #b8cef0;
        box-shadow: 0 14px 34px rgba(15, 37, 68, .1);
        transform: translateY(-2px);
    }

    .article-image,
    .side-thumb {
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: linear-gradient(135deg, #eaf2ff, #eefcf4);
        color: #2563eb;
    }

    .article-image {
        height: 136px;
        font-size: 34px;
    }

    .article-image img,
    .side-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .article-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 16px;
    }

    .article-badge {
        display: inline-flex;
        width: fit-content;
        padding: 6px 10px;
        border-radius: 999px;
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .article-badge.news {
        background: #2563eb;
    }

    .article-badge.guide {
        background: #22c55e;
    }

    .article-title {
        display: -webkit-box;
        min-height: 48px;
        margin: 13px 0 8px;
        overflow: hidden;
        color: #0f2544;
        font-size: 17px;
        font-weight: 800;
        line-height: 1.35;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .article-excerpt {
        display: -webkit-box;
        min-height: 41px;
        margin: 0;
        overflow: hidden;
        color: #64748b;
        font-size: 14px;
        line-height: 1.45;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .article-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: auto;
        padding-top: 16px;
        color: #64748b;
        font-size: 13px;
        font-weight: 650;
    }

    .article-meta span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }

    .knowledge-sidebar {
        display: grid;
        align-content: start;
        gap: 18px;
    }

    .side-card {
        border: 1px solid #dbe6f3;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15, 37, 68, .05);
        overflow: hidden;
    }

    .side-card h2 {
        margin: 0;
        padding: 18px 18px 4px;
        color: #0f2544;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: 0;
    }

    .featured-list,
    .category-list {
        display: grid;
        gap: 0;
        padding: 12px;
    }

    .featured-item,
    .category-item {
        display: grid;
        color: inherit;
        border-radius: 12px;
        cursor: pointer;
    }

    .featured-item {
        grid-template-columns: 78px minmax(0, 1fr);
        gap: 12px;
        padding: 10px;
    }

    .featured-item:hover,
    .category-item:hover,
    .category-item.is-active {
        background: #f1f7ff;
    }

    .side-thumb {
        width: 78px;
        height: 62px;
        border-radius: 10px;
        font-size: 21px;
    }

    .featured-title {
        display: -webkit-box;
        margin: 0 0 7px;
        overflow: hidden;
        color: #0f2544;
        font-size: 14px;
        font-weight: 800;
        line-height: 1.35;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .featured-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        color: #64748b;
        font-size: 12px;
        font-weight: 650;
    }

    .category-item {
        grid-template-columns: 34px minmax(0, 1fr) auto 18px;
        gap: 10px;
        align-items: center;
        padding: 12px 10px;
        border: 0;
        background: transparent;
        font: inherit;
        text-align: left;
    }

    .category-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        color: #2563eb;
        background: #eaf2ff;
    }

    .category-name {
        color: #0f2544;
        font-weight: 760;
    }

    .category-count {
        color: #64748b;
        font-weight: 760;
    }

    .pagination-bar {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 26px;
    }

    .page-btn {
        min-width: 40px;
        height: 40px;
        border: 1px solid #dbe6f3;
        border-radius: 10px;
        color: #0f2544;
        background: #fff;
        font: inherit;
        font-weight: 750;
        cursor: pointer;
    }

    .page-btn.is-active {
        border-color: #2563eb;
        color: #fff;
        background: #2563eb;
    }

    .page-btn:disabled {
        cursor: not-allowed;
        opacity: .45;
    }

    .state-box {
        display: grid;
        min-height: 220px;
        place-items: center;
        border: 1px dashed #bfd3ef;
        border-radius: 16px;
        color: #64748b;
        background: #fff;
        font-weight: 750;
    }

    .skeleton {
        position: relative;
        overflow: hidden;
    }

    .skeleton::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .72), transparent);
        animation: shimmer 1.1s infinite;
    }

    @@keyframes shimmer {
        from { transform: translateX(-100%); }
        to { transform: translateX(100%); }
    }

    @@media (max-width: 1180px) {
        .knowledge-filterbar {
            grid-template-columns: 1fr;
        }

        .article-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .knowledge-content {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 820px) {
        .knowledge-container {
            padding: 0 20px;
        }

        .knowledge-hero-inner {
            grid-template-columns: 1fr;
        }

        .knowledge-heading h1 {
            font-size: 32px;
        }

        .knowledge-heading p {
            font-size: 17px;
        }

        .article-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="knowledge-page" data-knowledge-page>
    <section class="knowledge-hero" aria-labelledby="knowledgeTitle">
        <div class="knowledge-container knowledge-hero-inner">
            <div class="knowledge-heading">
                <h1 id="knowledgeTitle" class="user-page-title">Tin tức &amp; Cẩm nang sức khỏe</h1>
                <p class="user-page-subtitle">Cập nhật những thông tin mới nhất và kiến thức hữu ích về chăm sóc sức khỏe cho bạn và gia đình.</p>
            </div>
            <aside class="knowledge-total-card" aria-label="Tổng số bài viết">
                <span class="knowledge-total-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>
                <span>
                    <span class="knowledge-total-number"><strong data-total-count>...</strong><span>bài viết</span></span>
                    <small>Tổng số bài viết</small>
                </span>
            </aside>
        </div>
    </section>

    <section class="knowledge-filter-band" aria-label="Tìm kiếm và lọc bài viết">
        <div class="knowledge-container knowledge-filterbar">
            <label class="knowledge-search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input data-search-input type="search" placeholder="Tìm kiếm bài viết..." aria-label="Tìm kiếm bài viết" />
            </label>
            <div class="knowledge-tabs" role="tablist" aria-label="Loại bài viết">
                <button type="button" class="knowledge-tab is-active" data-type="all"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>Tất cả bài viết</button>
                <button type="button" class="knowledge-tab" data-type="news"><i class="bi bi-newspaper" aria-hidden="true"></i>Tin tức</button>
                <button type="button" class="knowledge-tab" data-type="guide"><i class="bi bi-book" aria-hidden="true"></i>Cẩm nang sức khỏe</button>
            </div>
            <select class="knowledge-sort" data-sort-select aria-label="Sắp xếp bài viết">
                <option value="newest">Mới nhất</option>
                <option value="oldest">Cũ nhất</option>
                <option value="most_viewed">Xem nhiều nhất</option>
            </select>
        </div>
    </section>

    <section class="knowledge-container knowledge-content" aria-label="Danh sách bài viết">
        <div>
            <div class="article-grid" data-article-grid></div>
            <div class="pagination-bar" data-pagination></div>
        </div>

        <aside class="knowledge-sidebar">
            <section class="side-card" data-featured-card>
                <h2>Bài viết nổi bật</h2>
                <div class="featured-list" data-featured-list></div>
            </section>
            <section class="side-card">
                <h2>Danh mục bài viết</h2>
                <div class="category-list">
                    <button type="button" class="category-item is-active" data-category="all">
                        <span class="category-icon"><i class="bi bi-grid" aria-hidden="true"></i></span>
                        <span class="category-name">Tất cả bài viết</span>
                        <span class="category-count" data-count-all>0</span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="category-item" data-category="news">
                        <span class="category-icon"><i class="bi bi-newspaper" aria-hidden="true"></i></span>
                        <span class="category-name">Tin tức</span>
                        <span class="category-count" data-count-news>0</span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="category-item" data-category="guide">
                        <span class="category-icon"><i class="bi bi-book" aria-hidden="true"></i></span>
                        <span class="category-name">Cẩm nang sức khỏe</span>
                        <span class="category-count" data-count-guide>0</span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </section>
        </aside>
    </section>
</div>

<script>
    (() => {
        const state = {
            type: "all",
            keyword: "",
            sort: "newest",
            page: 1,
            limit: 6,
            pagination: { page: 1, total_pages: 1, total: 0 }
        };

        const grid = document.querySelector("[data-article-grid]");
        const pagination = document.querySelector("[data-pagination]");
        const searchInput = document.querySelector("[data-search-input]");
        const sortSelect = document.querySelector("[data-sort-select]");
        const tabs = [...document.querySelectorAll("[data-type]")];
        const categories = [...document.querySelectorAll("[data-category]")];
        const featuredList = document.querySelector("[data-featured-list]");
        const featuredCard = document.querySelector("[data-featured-card]");
        const totalCount = document.querySelector("[data-total-count]");
        let searchTimer;

        const formatDate = (value) => {
            if (!value) return "";
            return new Intl.DateTimeFormat("vi-VN").format(new Date(value));
        };

        const formatNumber = (value) => new Intl.NumberFormat("vi-VN").format(value || 0);
        const typeLabel = (type) => type === "news" ? "Tin tức" : "Cẩm nang sức khỏe";
        const placeholder = '<i class="bi bi-image" aria-hidden="true"></i>';

        const buildUrl = (featured = false) => {
            const params = new URLSearchParams({
                page: featured ? "1" : String(state.page),
                limit: featured ? "3" : String(state.limit),
                sort: featured ? "most_viewed" : state.sort
            });
            if (state.type !== "all" && !featured) params.set("type", state.type);
            if (state.keyword.trim() && !featured) params.set("keyword", state.keyword.trim());
            if (featured) params.set("featured", "true");
            return `/api/knowledge/articles?${params.toString()}`;
        };

        const setActiveType = (type) => {
            state.type = type;
            tabs.forEach(tab => tab.classList.toggle("is-active", tab.dataset.type === type));
            categories.forEach(item => item.classList.toggle("is-active", item.dataset.category === type));
        };

        const articleHref = (article) => `/BaiVietCamNang/Details?maBaiViet=${article.id}`;

        const renderArticles = (articles) => {
            if (!articles.length) {
                const message = state.keyword.trim()
                    ? "Không tìm thấy bài viết phù hợp."
                    : "Hiện chưa có bài viết nào.";
                grid.innerHTML = `<div class="state-box" style="grid-column:1/-1">${message}</div>`;
                return;
            }

            grid.innerHTML = articles.map(article => `
                <a class="article-card" href="${articleHref(article)}">
                    <span class="article-image">
                        ${article.thumbnail_url ? `<img src="${article.thumbnail_url}" alt="${escapeHtml(article.title)}">` : placeholder}
                    </span>
                    <span class="article-body">
                        <span class="article-badge ${article.type}">${typeLabel(article.type)}</span>
                        <strong class="article-title">${escapeHtml(article.title)}</strong>
                        <span class="article-excerpt">${escapeHtml(article.excerpt || "")}</span>
                        <span class="article-meta">
                            <span><i class="bi bi-calendar3" aria-hidden="true"></i>${formatDate(article.published_at)}</span>
                            <span><i class="bi bi-eye" aria-hidden="true"></i>${formatNumber(article.view_count)} lượt xem</span>
                        </span>
                    </span>
                </a>
            `).join("");
        };

        const renderPagination = () => {
            const totalPages = state.pagination.total_pages || 1;
            if (totalPages <= 1) {
                pagination.innerHTML = "";
                return;
            }

            const current = state.pagination.page;
            const maxButtons = 5;
            const start = Math.max(1, Math.min(current - 2, totalPages - maxButtons + 1));
            const end = Math.min(totalPages, start + maxButtons - 1);
            const pageButtons = [];
            for (let page = start; page <= end; page++) {
                pageButtons.push(`<button type="button" class="page-btn ${page === current ? "is-active" : ""}" data-page="${page}">${page}</button>`);
            }

            pagination.innerHTML = `
                <button type="button" class="page-btn" data-page="1" ${current === 1 ? "disabled" : ""}>«</button>
                <button type="button" class="page-btn" data-page="${current - 1}" ${current === 1 ? "disabled" : ""}>&lt;</button>
                ${pageButtons.join("")}
                <button type="button" class="page-btn" data-page="${current + 1}" ${current === totalPages ? "disabled" : ""}>&gt;</button>
                <button type="button" class="page-btn" data-page="${totalPages}" ${current === totalPages ? "disabled" : ""}>»</button>
            `;
        };

        const renderFeatured = (articles) => {
            if (!articles.length) {
                featuredCard.style.display = "none";
                return;
            }

            featuredCard.style.display = "";
            featuredList.innerHTML = articles.map(article => `
                <a class="featured-item" href="${articleHref(article)}">
                    <span class="side-thumb">${article.thumbnail_url ? `<img src="${article.thumbnail_url}" alt="">` : placeholder}</span>
                    <span>
                        <strong class="featured-title">${escapeHtml(article.title)}</strong>
                        <span class="featured-meta">
                            <span>${formatDate(article.published_at)}</span>
                            <span>${formatNumber(article.view_count)} lượt xem</span>
                        </span>
                    </span>
                </a>
            `).join("");
        };

        const renderLoading = () => {
            grid.innerHTML = Array.from({ length: 6 }).map(() => `
                <div class="article-card skeleton">
                    <span class="article-image"></span>
                    <span class="article-body">
                        <span class="article-badge news">&nbsp;</span>
                        <strong class="article-title">&nbsp;</strong>
                        <span class="article-excerpt">&nbsp;</span>
                    </span>
                </div>
            `).join("");
        };

        const loadStats = async () => {
            const res = await fetch("/api/knowledge/stats");
            if (!res.ok) return;
            const stats = await res.json();
            totalCount.textContent = formatNumber(stats.total);
            document.querySelector("[data-count-all]").textContent = formatNumber(stats.total);
            document.querySelector("[data-count-news]").textContent = formatNumber(stats.news);
            document.querySelector("[data-count-guide]").textContent = formatNumber(stats.guide);
        };

        const loadArticles = async () => {
            renderLoading();
            pagination.innerHTML = "";
            try {
                const res = await fetch(buildUrl());
                if (!res.ok) throw new Error("load failed");
                const payload = await res.json();
                state.pagination = payload.pagination || { page: 1, total_pages: 1, total: 0 };
                renderArticles(payload.data || []);
                renderPagination();
            } catch {
                grid.innerHTML = '<div class="state-box" style="grid-column:1/-1">Không thể tải danh sách bài viết. Vui lòng thử lại.</div>';
            }
        };

        const loadFeatured = async () => {
            const res = await fetch(buildUrl(true));
            if (!res.ok) return;
            const payload = await res.json();
            renderFeatured(payload.data || []);
        };

        const escapeHtml = (value) => String(value || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");

        tabs.forEach(tab => {
            tab.addEventListener("click", () => {
                setActiveType(tab.dataset.type);
                state.page = 1;
                loadArticles();
            });
        });

        categories.forEach(item => {
            item.addEventListener("click", () => {
                setActiveType(item.dataset.category);
                state.page = 1;
                loadArticles();
            });
        });

        sortSelect.addEventListener("change", () => {
            state.sort = sortSelect.value;
            state.page = 1;
            loadArticles();
        });

        searchInput.addEventListener("input", () => {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                state.keyword = searchInput.value;
                state.page = 1;
                loadArticles();
            }, 300);
        });

        pagination.addEventListener("click", (event) => {
            const button = event.target.closest("[data-page]");
            if (!button || button.disabled) return;
            state.page = Number(button.dataset.page);
            loadArticles();
        });

        loadStats();
        loadFeatured();
        loadArticles();
    })();
</script>
