@* Khu vực giao diện của view Index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<BaiVietCamNang>
@{
    ViewData["Title"] = "Cẩm nang sức khỏe";
}

<div class="list-page-head">
    <div>
        <h2>Cẩm nang sức khỏe</h2>
        <p>@Model.Count bài viết đang hiển thị</p>
    </div>
</div>

@* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
@if (Model.Count == 0)
{
    @* Khu vực thông báo phản hồi kết quả xử lý, ví dụ thành công, lỗi nhập liệu hoặc lỗi nghiệp vụ. *@
    <div class="alert alert-info">Chưa có bài viết nào.</div>
}
else
{
    <section class="list-card">
    @* Khu vực bảng dùng để hiển thị danh sách dữ liệu theo từng cột, giúp người dùng dễ theo dõi và thao tác. *@
    <table class="table list-table">
        <thead>
            <tr>
                <th>Bài viết</th>
                <th>Tác giả</th>
                <th>Ngày tạo</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="item-title">
                        <a asp-action="Details" asp-route-maBaiViet="@item.MaBaiViet">@item.TieuDe</a>
                    </div>
                    <div class="item-meta">Mã bài viết #@item.MaBaiViet</div>
                </td>
                <td>@item.TenTacGia</td>
                <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
                <td class="table-actions">
                    <a asp-action="Details" asp-route-maBaiViet="@item.MaBaiViet" class="btn btn-sm btn-primary">Đọc bài</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </section>
}
