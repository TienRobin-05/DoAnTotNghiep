@model HoSoSucKhoe
@{
    ViewData["Title"] = "Thêm hồ sơ sức khỏe";
}

@section Styles {
    <link rel="stylesheet" href="~/css/health-profile-create.css" asp-append-version="true" />
    <style>
        .date-input-wrap {
            position: relative;
        }

        .date-input-wrap .health-input {
            padding-right: 50px;
        }

        .calendar-picker-btn {
            position: absolute;
            right: 10px;
            top: 50%;
            width: 34px;
            height: 34px;
            transform: translateY(-50%);
            border: none;
            border-radius: 6px;
            background: transparent;
            color: #0d6efd;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            z-index: 2;
        }

        .calendar-picker-btn:hover {
            background: #eef6ff;
        }

        .hidden-date-picker {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
            pointer-events: none;
        }

        .text-danger {
            display: block;
            margin-top: 6px;
            color: #dc2626;
            font-size: 13px;
            font-weight: 600;
        }

        .field-validation-error {
            display: block;
            margin-top: 6px;
            color: #dc2626;
            font-size: 13px;
            font-weight: 600;
        }
    </style>
}

<div class="health-profile-page">
    <section class="health-hero">
        <div class="decor-shield" aria-hidden="true"></div>
        <div class="decor-plus" aria-hidden="true"></div>
        <div class="decor-plus decor-plus-2" aria-hidden="true"></div>
        <div class="decor-dots" aria-hidden="true"></div>

        <div class="cloud cloud-left" aria-hidden="true"></div>
        <div class="cloud cloud-right" aria-hidden="true"></div>

        <div class="health-container hero-content">
            <h1>Thêm hồ sơ sức khỏe</h1>
            <p>Nhập thông tin cá nhân và tình trạng sức khỏe để quản lý hồ sơ một cách chính xác và hiệu quả.</p>
        </div>
    </section>

    <section class="health-form-section">
        <form method="post" class="health-form-card">
            @Html.AntiForgeryToken()

            @if (ViewBag.ThongBao != null)
            {
                <div class="alert alert-danger" style="margin-bottom:20px;">@ViewBag.ThongBao</div>
            }

            <div id="ngaySinhError" class="text-danger" style="display:none;margin-bottom:12px;"></div>

            @if (ViewData.ModelState["NgaySinh"]?.Errors?.Count > 0)
            {
                <div class="alert alert-danger" style="margin-bottom:20px;">Vui lòng nhập ngày sinh hợp lệ theo định dạng dd/mm/yyyy.</div>
            }

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="HoTen">Họ tên</label>
                    <div class="input-wrap">
                        <i class="bi bi-person-fill field-icon-left"></i>
                        <input asp-for="HoTen" class="health-input" placeholder="Nhập họ và tên" />
                    </div>
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Ngày sinh</label>
                    <div class="input-wrap date-input-wrap">
                        <i class="bi bi-calendar3 field-icon-left"></i>

                        <input type="text" id="ngaySinhDisplay" name="NgaySinhDisplay" inputmode="numeric"
                               autocomplete="bday" placeholder="dd/mm/yyyy" maxlength="10" class="health-input" />

                        <button type="button" class="calendar-picker-btn" id="calendarPickerBtn" aria-label="Chọn ngày">
                            <i class="bi bi-calendar-week" style="font-size:16px;"></i>
                        </button>

                        <input type="date" id="hiddenDatePicker" class="hidden-date-picker" />
                        <input type="hidden" id="ngaySinhHidden" name="NgaySinh" value="" />
                    </div>
                    <span asp-validation-for="NgaySinh" class="text-danger"></span>
                    <small style="display:block;margin-top:4px;color:#6b7280;font-size:12px;">Định dạng: ngày/tháng/năm</small>
                </div>

                <div class="form-group">
                    <label asp-for="GioiTinh">Giới tính</label>
                    <div class="input-wrap">
                        <i class="bi bi-gender-ambiguous field-icon-left"></i>
                        <select asp-for="GioiTinh" class="health-select">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                        <i class="bi bi-chevron-down field-icon-right"></i>
                    </div>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label asp-for="ChieuCao">Chiều cao (cm)</label>
                        <div class="input-wrap">
                            <i class="bi bi-rulers field-icon-left"></i>
                            <input asp-for="ChieuCao" type="number" step="0.1" class="health-input" placeholder="Nhập chiều cao" />
                        </div>
                        <span asp-validation-for="ChieuCao" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CanNang">Cân nặng (kg)</label>
                        <div class="input-wrap">
                            <i class="bi bi-droplet-half field-icon-left"></i>
                            <input asp-for="CanNang" type="number" step="0.1" class="health-input" placeholder="Nhập cân nặng" />
                        </div>
                        <span asp-validation-for="CanNang" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="TienSuBenh">Tiền sử bệnh</label>
                    <div class="input-wrap textarea">
                        <i class="bi bi-clipboard2-pulse field-icon-left"></i>
                        <textarea asp-for="TienSuBenh" class="health-textarea" placeholder="Nhập tiền sử bệnh (nếu có)"></textarea>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="DiUng">Dị ứng</label>
                    <div class="input-wrap textarea">
                        <i class="bi bi-shield-exclamation field-icon-left"></i>
                        <textarea asp-for="DiUng" class="health-textarea" placeholder="Nhập dị ứng (nếu có)"></textarea>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save" id="btnLuuHoSo">
                    <i class="bi bi-floppy" style="font-size:17px;"></i>
                    Lưu hồ sơ
                </button>
                <a asp-action="Index" class="btn-back">
                    <i class="bi bi-arrow-left" style="font-size:17px;"></i>
                    Quay lại
                </a>
            </div>
        </form>
    </section>

    <div class="leaf-left" aria-hidden="true"><i class="bi bi-flower2"></i></div>
    <div class="leaf-right" aria-hidden="true"><i class="bi bi-flower2"></i></div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var display = document.getElementById("ngaySinhDisplay");
            var hidden = document.getElementById("ngaySinhHidden");
            var picker = document.getElementById("hiddenDatePicker");
            var pickerBtn = document.getElementById("calendarPickerBtn");
            var form = display && display.closest("form");
            var errorDiv = document.getElementById("ngaySinhError");

            if (!display || !hidden) return;

            function digits(v) { return String(v || "").replace(/\D/g, "").slice(0, 8); }

            function formatToDdMmYyyy(v) {
                var d = digits(v);
                if (d.length <= 2) return d;
                if (d.length <= 4) return d.slice(0, 2) + "/" + d.slice(2);
                return d.slice(0, 2) + "/" + d.slice(2, 4) + "/" + d.slice(4);
            }

            function ddMmYyyyToIso(v) {
                var d = digits(v);
                if (d.length !== 8) return "";
                return d.slice(4) + "-" + d.slice(2, 4) + "-" + d.slice(0, 2);
            }

            function isoToDdMmYyyy(v) {
                if (!v) return "";
                var dateOnly = v;
                if (v.indexOf("T") >= 0) dateOnly = v.split("T")[0];
                if (/^\d{4}-\d{2}-\d{2}$/.test(dateOnly)) {
                    var parts = dateOnly.split("-");
                    return parts[2] + "/" + parts[1] + "/" + parts[0];
                }
                return "";
            }

            function isValid(v) {
                var d = digits(v);
                if (d.length !== 8) return false;
                var day = parseInt(d.slice(0, 2), 10);
                var m = parseInt(d.slice(2, 4), 10);
                var y = parseInt(d.slice(4), 10);
                if (m < 1 || m > 12 || day < 1 || day > 31 || y < 1900) return false;
                var curY = new Date().getFullYear();
                if (y > curY) return false;
                var date = new Date(y, m - 1, day);
                if (date.getFullYear() !== y || date.getMonth() !== m - 1 || date.getDate() !== day) return false;
                var today = new Date(); today.setHours(0, 0, 0, 0);
                if (date > today) return false;
                return true;
            }

            function showError(msg) {
                if (errorDiv) {
                    errorDiv.textContent = msg;
                    errorDiv.style.display = "block";
                } else {
                    alert(msg);
                }
            }

            function hideError() {
                if (errorDiv) { errorDiv.style.display = "none"; errorDiv.textContent = ""; }
            }

            display.addEventListener("input", function () {
                hideError();
                var fmt = formatToDdMmYyyy(this.value);
                this.value = fmt;
                hidden.value = ddMmYyyyToIso(fmt);
            });

            display.addEventListener("blur", function () {
                if (!this.value) { return; }
                if (!isValid(this.value)) {
                    this.value = "";
                    hidden.value = "";
                    showError("Ngày sinh không hợp lệ. Vui lòng nhập theo định dạng dd/mm/yyyy.");
                }
            });

            if (pickerBtn && picker) {
                pickerBtn.addEventListener("click", function () {
                    if (typeof picker.showPicker === "function") {
                        picker.showPicker();
                    } else {
                        picker.click();
                    }
                });

                picker.addEventListener("change", function () {
                    if (!this.value) return;
                    var displayVal = isoToDdMmYyyy(this.value);
                    if (displayVal && isValid(displayVal)) {
                        display.value = displayVal;
                        hidden.value = this.value;
                        hideError();
                    }
                });

                picker.max = new Date().toISOString().split("T")[0];
            }

            if (form) {
                form.addEventListener("submit", function (e) {
                    if (!display.value || !hidden.value) {
                        e.preventDefault();
                        showError("Vui lòng nhập ngày sinh hợp lệ theo định dạng dd/mm/yyyy.");
                        display.focus();
                        return;
                    }
                    if (!isValid(display.value)) {
                        e.preventDefault();
                        display.value = "";
                        hidden.value = "";
                        showError("Ngày sinh không hợp lệ. Vui lòng nhập lại.");
                        display.focus();
                    }
                });
            }
        });
    </script>
}
