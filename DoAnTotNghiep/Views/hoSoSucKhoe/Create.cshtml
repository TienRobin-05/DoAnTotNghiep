@model HoSoSucKhoe
@{
    ViewData["Title"] = "Thêm hồ sơ sức khỏe";
}

@section Styles {
    <link rel="stylesheet" href="~/css/health-profile-create.css" asp-append-version="true" />
}

<div class="health-profile-page">
    <section class="health-hero">
        <div class="decor-shield" aria-hidden="true"></div>
        <div class="decor-plus" aria-hidden="true"></div>
        <div class="decor-plus decor-plus-2" aria-hidden="true"></div>
        <div class="decor-dots" aria-hidden="true"></div>

        <div class="cloud cloud-left" aria-hidden="true"></div>
        <div class="cloud cloud-right" aria-hidden="true"></div>

        <div class="health-container hero-content">
            <h1>Thêm hồ sơ sức khỏe</h1>
            <p>Nhập thông tin cá nhân và tình trạng sức khỏe để quản lý hồ sơ một cách chính xác và hiệu quả.</p>
        </div>
    </section>

    <section class="health-form-section">
        <form method="post" class="health-form-card">
            @Html.AntiForgeryToken()

            @if (ViewBag.ThongBao != null)
            {
                <div class="alert alert-danger" style="margin-bottom:20px;">@ViewBag.ThongBao</div>
            }

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="HoTen">Họ tên</label>
                    <div class="input-wrap">
                        <i class="bi bi-person-fill field-icon-left"></i>
                        <input asp-for="HoTen" class="health-input" placeholder="Nhập họ và tên" />
                    </div>
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NgaySinh">Ngày sinh</label>
                    <div class="input-wrap">
                        <i class="bi bi-calendar3 field-icon-left"></i>
                        <input asp-for="NgaySinh" type="date" class="health-input" />
                        <i class="bi bi-calendar-week field-icon-right"></i>
                    </div>
                    <span asp-validation-for="NgaySinh" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="GioiTinh">Giới tính</label>
                    <div class="input-wrap">
                        <i class="bi bi-gender-ambiguous field-icon-left"></i>
                        <select asp-for="GioiTinh" class="health-select">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                        <i class="bi bi-chevron-down field-icon-right"></i>
                    </div>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>

                <div class="form-row-2">
                    <div class="form-group">
                        <label asp-for="ChieuCao">Chiều cao (cm)</label>
                        <div class="input-wrap">
                            <i class="bi bi-rulers field-icon-left"></i>
                            <input asp-for="ChieuCao" type="number" step="0.1" class="health-input" placeholder="Nhập chiều cao" />
                        </div>
                        <span asp-validation-for="ChieuCao" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CanNang">Cân nặng (kg)</label>
                        <div class="input-wrap">
                            <i class="bi bi-droplet-half field-icon-left"></i>
                            <input asp-for="CanNang" type="number" step="0.1" class="health-input" placeholder="Nhập cân nặng" />
                        </div>
                        <span asp-validation-for="CanNang" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="TienSuBenh">Tiền sử bệnh</label>
                    <div class="input-wrap textarea">
                        <i class="bi bi-clipboard2-pulse field-icon-left"></i>
                        <textarea asp-for="TienSuBenh" class="health-textarea" placeholder="Nhập tiền sử bệnh (nếu có)"></textarea>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="DiUng">Dị ứng</label>
                    <div class="input-wrap textarea">
                        <i class="bi bi-shield-exclamation field-icon-left"></i>
                        <textarea asp-for="DiUng" class="health-textarea" placeholder="Nhập dị ứng (nếu có)"></textarea>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">
                    <i class="bi bi-floppy" style="font-size:17px;"></i>
                    Lưu hồ sơ
                </button>
                <a asp-action="Index" class="btn-back">
                    <i class="bi bi-arrow-left" style="font-size:17px;"></i>
                    Quay lại
                </a>
            </div>
        </form>
    </section>

    <div class="leaf-left" aria-hidden="true"><i class="bi bi-flower2"></i></div>
    <div class="leaf-right" aria-hidden="true"><i class="bi bi-flower2"></i></div>
</div>
