@* Trang danh sách hồ sơ sức khỏe của người dùng. *@
@model List<HoSoSucKhoe>
@{
    Layout = "_UserLayout";
    ViewData["Title"] = "Hồ sơ sức khỏe";
}

<section class="card">
    <div class="section-head">
        <h2 class="section-title">Hồ sơ sức khỏe</h2>
        <a asp-action="Create" class="btn btn-primary">Thêm hồ sơ</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty">Bạn chưa có hồ sơ sức khỏe nào.</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Ngày sinh</th>
                    <th>Giới tính</th>
                    <th>Chiều cao</th>
                    <th>Cân nặng</th>
                    <th>Ngày tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.HoTen</td>
                        <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                        <td>@item.GioiTinh</td>
                        <td>@(item.ChieuCao.HasValue ? item.ChieuCao.Value.ToString() : "")</td>
                        <td>@(item.CanNang.HasValue ? item.CanNang.Value.ToString() : "")</td>
                        <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.MaHoSo" class="btn">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.MaHoSo" class="btn">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.MaHoSo" class="btn btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
