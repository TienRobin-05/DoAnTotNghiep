@model HoSoSucKhoe

<div class="mb-3">
    <label asp-for="HoTen" class="form-label">Họ tên</label>
    <input asp-for="HoTen" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="NgaySinh" class="form-label">Ngày sinh</label>
    <input asp-for="NgaySinh" type="date" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="GioiTinh" class="form-label">Giới tính</label>
    <select asp-for="GioiTinh" class="form-select">
        <option value="">-- Chọn giới tính --</option>
        <option value="Nam">Nam</option>
        <option value="Nữ">Nữ</option>
        <option value="Khác">Khác</option>
    </select>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="ChieuCao" class="form-label">Chiều cao</label>
        <input asp-for="ChieuCao" type="number" step="0.1" class="form-control" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="CanNang" class="form-label">Cân nặng</label>
        <input asp-for="CanNang" type="number" step="0.1" class="form-control" />
    </div>
</div>
<div class="mb-3">
    <label asp-for="TienSuBenh" class="form-label">Tiền sử bệnh</label>
    <textarea asp-for="TienSuBenh" class="form-control"></textarea>
</div>
<div class="mb-3">
    <label asp-for="DiUng" class="form-label">Dị ứng</label>
    <textarea asp-for="DiUng" class="form-control"></textarea>
</div>
