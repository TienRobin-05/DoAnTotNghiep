@* Khu vực giao diện của view Details.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model ThongBao
@{
    ViewData["Title"] = "Chi tiết thông báo";
}

<h2>Chi tiết thông báo</h2>

<div class="detail-card">
    <div class="card-body">
        <p><strong>Tiêu đề:</strong> @Model.TieuDe</p>
        <p><strong>Nội dung:</strong> @Model.NoiDung</p>
        <p><strong>Ngày gửi:</strong> @Model.NgayGui.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Trạng thái:</strong> @Model.TrangThaiDoc</p>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Quay lại danh sách thông báo</a>
