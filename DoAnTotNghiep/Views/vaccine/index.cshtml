@model List<vaccineModels>
@{
    ViewData["Title"] = "Vaccine";
    var laAdmin = string.Equals(Context.Session.GetString("VaiTro"), "Admin", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Vaccine</h2>
    @if (laAdmin)
    {
        <a asp-action="them" class="btn btn-primary">Thêm vaccine</a>
    }
</div>

<table class="table table-bordered table-striped">
    <thead><tr><th>Tên vaccine</th><th>Nhóm</th><th>Độ tuổi</th><th>Đơn vị</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.tenVaccine</td>
            <td>@item.nhomVaccine</td>
            <td>@item.doTuoiToiThieu - @item.doTuoiToiDa</td>
            <td>@item.donViTuoi</td>
            <td>@(item.trangThai ? "Hoạt động" : "Ẩn")</td>
            <td>
                @if (laAdmin)
                {
                    <a asp-action="sua" asp-route-id="@item.maVaccine" class="btn btn-sm btn-outline-primary">Sửa</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
