@* Khu vực giao diện của view Index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<Vaccine>
@{
    ViewData["Title"] = ViewBag.LaTraCuu == true ? "Tra cứu vaccine" : "Quản lý vaccine";
    var laTraCuu = ViewBag.LaTraCuu == true;
    var tuKhoa = ViewBag.TuKhoa as string ?? string.Empty;
    var actionLamMoi = laTraCuu ? "TraCuu" : "Index";
    // Trang tra cứu dùng menu người dùng; trang quản lý vaccine vẫn giữ layout quản trị hiện tại.
    if (laTraCuu)
    {
        Layout = "_UserLayout";
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@ViewData["Title"]</h2>
    @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
    @if (!laTraCuu)
    {
        <a asp-action="Create" class="btn btn-primary">Thêm vaccine</a>
    }
</div>

@* Form tìm kiếm vaccine theo đúng dữ liệu có sẵn trong bảng Vaccine: tenVaccine và nhomVaccine. *@
<form method="get" class="card mb-3">
    <div class="row align-items-end">
        <div class="col-md-8">
            <label for="tuKhoa" class="form-label">Tìm kiếm vaccine</label>
            <input id="tuKhoa" name="tuKhoa" value="@tuKhoa" class="form-control" placeholder="Nhập tên vaccine hoặc nhóm vaccine" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <a asp-action="@actionLamMoi" class="btn btn-secondary">Làm mới</a>
        </div>
    </div>
</form>

<section class="card">
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Chưa có vaccine</div>
    }
    else
    {
    @* Khu vực bảng dùng để hiển thị danh sách dữ liệu theo từng cột, giúp người dùng dễ theo dõi và thao tác. *@
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên vaccine</th>
                <th>Nhóm</th>
                <th>Độ tuổi tối thiểu</th>
                <th>Độ tuổi tối đa</th>
                <th>Đơn vị tuổi</th>
                <th>Trạng thái</th>
                @if (!laTraCuu)
                {
                    <th>Thao tác</th>
                }
            </tr>
        </thead>
        <tbody>
        @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaVaccine</td>
                <td>
                    @if (laTraCuu)
                    {
                        <a asp-action="Details" asp-route-id="@item.MaVaccine">@item.TenVaccine</a>
                    }
                    else
                    {
                        @item.TenVaccine
                    }
                </td>
                <td>@item.NhomVaccine</td>
                <td>@item.DoTuoiToiThieu</td>
                <td>@item.DoTuoiToiDa</td>
                <td>@item.DonViTuoi</td>
                <td>@(item.TrangThai ? "Đang dùng" : "Đã ẩn")</td>
                @if (!laTraCuu)
                {
                    <td>
                        <a asp-action="Details" asp-route-id="@item.MaVaccine" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                        <a asp-controller="muiTiemVaccine" asp-action="IndexTheoVaccine" asp-route-maVaccine="@item.MaVaccine" class="btn btn-sm btn-outline-info">Mũi tiêm</a>
                        <a asp-action="Edit" asp-route-id="@item.MaVaccine" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaVaccine" class="btn btn-sm btn-outline-danger">Ẩn</a>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
    }
</section>
