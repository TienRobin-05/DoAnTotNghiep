        }

        .admin-vaccine-table td {
            padding: 16px 20px;
            border-bottom: 1px solid #edf2f7;
            color: #334155;
            vertical-align: middle;
        }

        .admin-vaccine-table tbody tr:hover {
            background: #f9fcff;
        }

        .admin-vaccine-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .admin-vaccine-identity {
            display: flex;
            align-items: center;
            gap: 13px;
            min-width: 260px;
        }

        .admin-vaccine-row-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            font-size: 20px;
        }

        .admin-vaccine-name {
            display: block;
            max-width: 360px;
            color: #0f172a;
            font-weight: 800;
            line-height: 1.35;
            overflow-wrap: anywhere;
            text-decoration: none;
        }

        .admin-vaccine-name:hover {
            color: #0d6efd;
        }

        .admin-vaccine-code {
            display: block;
            margin-top: 3px;
            color: #7b8a9d;
            font-size: 12px;
            font-weight: 700;
        }

        .admin-vaccine-group,
        .admin-vaccine-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 30px;
            padding: 5px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.25;
        }

        .admin-vaccine-group {
            color: #0b65a6;
            background: #e7f4ff;
        }

        .admin-vaccine-age {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #475569;
            font-weight: 700;
        }

        .admin-vaccine-age i {
            color: #0d6efd;
        }

        .admin-vaccine-status::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
        }

        .admin-vaccine-status.active {
            color: #14804a;
            background: #e7f8ee;
        }

        .admin-vaccine-status.inactive {
            color: #9f2f3d;
            background: #fff0f2;
        }

        .admin-vaccine-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .admin-vaccine-action {
            min-width: 38px;
            padding: 0 10px;
            color: #31506d;
            background: #fff;
            border-color: #d7e4f1;
            font-size: 13px;
        }

        .admin-vaccine-action:hover {
            color: #0d6efd;
            border-color: #acd0ff;
            background: #f0f7ff;
        }

        .admin-vaccine-action.delete {
            color: #d3263d;
            border-color: #f4c2ca;
        }

        .admin-vaccine-action.delete:hover {
            color: #fff;
            background: #d3263d;
            border-color: #d3263d;
        }

        .admin-vaccine-empty {
            padding: 52px 20px;
            text-align: center;
            color: #64748b;
        }

        .admin-vaccine-empty i {
            display: block;
            margin-bottom: 12px;
            color: #9cb6d4;
            font-size: 42px;
        }

        .admin-vaccine-empty strong {
            display: block;
            margin-bottom: 6px;
            color: #1e293b;
            font-size: 18px;
        }

        .admin-vaccine-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 16px 20px;
            border-top: 1px solid #edf2f7;
            color: #64748b;
            font-weight: 700;
            flex-wrap: wrap;
        }

        .admin-vaccine-footer-controls,
        .admin-vaccine-pages {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .admin-vaccine-page-size {
            width: 76px;
            height: 36px;
            border: 1px solid #ccdaea;
            border-radius: 8px;
            color: #1e293b;
            background: #fff;
            font-weight: 800;
        }

        .admin-vaccine-page-link {
            width: 38px;
            height: 36px;
            color: #31506d;
            background: #fff;
            border-color: #d7e4f1;
        }

        .admin-vaccine-page-link.active {
            color: #fff;
            background: #0d6efd;
            border-color: #0d6efd;
        }

        .admin-vaccine-page-link.disabled {
            color: #a2afbf;
            pointer-events: none;
            background: #f5f8fc;
        }

        @@media (max-width: 991.98px) {
            .admin-vaccine-hero {
                grid-template-columns: 1fr;
            }

            .admin-vaccine-summary {
                justify-content: flex-start;
            }

            .admin-vaccine-filter form {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 575.98px) {
            .admin-vaccine-hero,
            .admin-vaccine-filter {
                padding: 16px;
            }

            .admin-vaccine-title {
                align-items: flex-start;
            }

            .admin-vaccine-title h1 {
                font-size: 24px;
            }

            .admin-vaccine-summary,
            .admin-vaccine-stat,
            .admin-vaccine-add,
            .admin-vaccine-search-btn,
            .admin-vaccine-reset {
                width: 100%;
            }

            .admin-vaccine-filter form {
                grid-template-columns: 1fr;
            }

            .admin-vaccine-footer {
                align-items: stretch;
            }

            .admin-vaccine-footer-controls,
            .admin-vaccine-pages {
                width: 100%;
                justify-content: space-between;
            }
        }
    </style>

    <main class="admin-vaccine-page">
        <section class="admin-vaccine-hero">
            <div class="admin-vaccine-title">
                <span class="admin-vaccine-title-icon"><i class="bi bi-capsule-pill" aria-hidden="true"></i></span>
                <div>
                    <h1 class="admin-page-title">Quản lý vaccine</h1>
                    <p class="admin-page-subtitle">@Model.TotalItems vaccine trong danh sách</p>
            </div>
            <div class="admin-vaccine-summary">
                <div class="admin-vaccine-stat">
                    <span>Tổng vaccine đang dùng</span>
                    <strong>@Model.ActiveVaccines</strong>
                </div>
                <div class="admin-vaccine-stat">
                    <span>Cập nhật lần cuối</span>
                    <strong>@Model.LastUpdatedText</strong>
                </div>
                <a asp-action="Create" class="admin-vaccine-add">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    Thêm vaccine
                </a>
            </div>
        </section>

        <section class="admin-vaccine-filter" aria-label="Bộ lọc vaccine">
            <form method="get" asp-action="Index" class="admin-vaccine-search-form">
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="admin-vaccine-field">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="tuKhoaAdmin"
                           name="tuKhoa"
                           value="@tuKhoa"
                           class="admin-vaccine-input"
                           placeholder="Tìm tên, mã hoặc nhóm vaccine"
                           aria-label="Tìm tên, mã hoặc nhóm vaccine"
                           data-live-search />
                </div>
                <select name="nhom" class="admin-vaccine-select" aria-label="Lọc nhóm vaccine" data-live-search>
                    <option value="">Tất cả nhóm</option>
                    @foreach (var group in Model.VaccineGroups)
                    {
                        <option value="@group" selected="@(string.Equals(group, nhomDaChon, StringComparison.OrdinalIgnoreCase))">@group</option>
                    }
                </select>
                <select name="trangThai" class="admin-vaccine-select" aria-label="Lọc trạng thái" data-live-search>
                    <option value="">Tất cả trạng thái</option>
                    <option value="active" selected="@(trangThaiDaChon == "active")">Đang dùng</option>
                    <option value="inactive" selected="@(trangThaiDaChon == "inactive")">Ngừng dùng</option>
                </select>
                <a asp-action="@actionLamMoi" class="admin-vaccine-reset">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                    Làm mới
                </a>
            </form>
        </section>

        <section class="admin-vaccine-card" aria-label="Danh sách vaccine">
            @if (Model.Vaccines.Count == 0)
            {
                <div class="admin-vaccine-empty">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <strong>Chưa có vaccine phù hợp</strong>
                    <span>Thử đổi từ khóa, nhóm hoặc trạng thái để xem thêm kết quả.</span>
                </div>
            }
            else
            {
                <div class="admin-vaccine-table-wrap">
                    <table class="admin-vaccine-table">
                        <thead>
                            <tr>
                                <th scope="col">Vaccine</th>
                                <th scope="col">Nhóm</th>
                                <th scope="col">Độ tuổi</th>
                                <th scope="col">Trạng thái</th>
                                <th scope="col">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Vaccines)
                            {
                                var iconVaccine = GetVaccineIcon(item.TenVaccine, item.NhomVaccine);
                                <tr>
                                    <td>
                                        <div class="admin-vaccine-identity">
                                            <span class="admin-vaccine-row-icon"><i class="bi @iconVaccine" aria-hidden="true"></i></span>
                                            <div>
                                                <a asp-action="Details" asp-route-id="@item.MaVaccine" class="admin-vaccine-name table-main-text">@item.TenVaccine</a>
                                                <span class="admin-vaccine-code table-sub-text">Mã vaccine #@item.MaVaccine</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="admin-vaccine-group">@(string.IsNullOrWhiteSpace(item.NhomVaccine) ? "Chưa phân nhóm" : item.NhomVaccine)</span>
                                    </td>
                                    <td>
                                        <span class="admin-vaccine-age"><i class="bi bi-calendar3" aria-hidden="true"></i>@HienThiDoTuoi(item)</span>
                                    </td>
                                    <td>
                                        <span class="admin-vaccine-status @(item.TrangThai ? "active" : "inactive")">
                                            @(item.TrangThai ? "Đang dùng" : "Ngừng dùng")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="table-actions vaccine-actions">
                                            <a asp-action="Details" asp-route-id="@item.MaVaccine" class="table-action-btn vaccine-action-btn" title="Chi tiết">
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                                Chi tiết
                                            </a>
                                            <a asp-controller="muiTiemVaccine" asp-action="IndexTheoVaccine" asp-route-maVaccine="@item.MaVaccine" class="table-action-btn vaccine-action-btn" title="Quản lý mũi tiêm">
                                                <i class="bi bi-list-check" aria-hidden="true"></i>
                                                Mũi tiêm
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MaVaccine" class="table-action-btn vaccine-action-btn" title="Sửa vaccine">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                Sửa
                                            </a>
                                            <div class="table-more-menu">
                                                <button type="button" class="table-more-btn js-table-more-btn" title="Thêm thao tác">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <div class="table-more-dropdown">
                                                    <button type="button"
                                                            class="table-more-item danger js-delete-confirm"
                                                            data-delete-url="@Url.Action("Delete", new { id = item.MaVaccine })"
                                                            data-delete-title="Xóa vaccine">
                                                        <i class="bi bi-trash3"></i>
                                                        Xóa
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="admin-vaccine-footer">
                <div>
                    Hiển thị @Model.StartItem đến @Model.EndItem của @Model.TotalItems vaccine
                </div>
                <div class="admin-vaccine-footer-controls">
                    <label for="adminVaccinePageSize">Mỗi trang</label>
                    <select id="adminVaccinePageSize" class="admin-vaccine-page-size" data-page-size>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="20" selected="@(Model.PageSize == 20)">20</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                    <nav class="admin-vaccine-pages" aria-label="Phân trang vaccine">
                        <a class="admin-vaccine-page-link @(Model.Page <= 1 ? "disabled" : "")" href="@TaoUrlTrang(Model.Page - 1)" aria-label="Trang trước">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </a>
                        @for (var soTrang = 1; soTrang <= Model.TotalPages; soTrang++)
                        {
                            if (soTrang == 1 || soTrang == Model.TotalPages || Math.Abs(soTrang - Model.Page) <= 1)
                            {
                                <a class="admin-vaccine-page-link @(soTrang == Model.Page ? "active" : "")" href="@TaoUrlTrang(soTrang)">@soTrang</a>
                            }
                            else if (Math.Abs(soTrang - Model.Page) == 2)
                            {
                                <span class="admin-vaccine-page-link disabled">...</span>
                            }
                        }
                        <a class="admin-vaccine-page-link @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@TaoUrlTrang(Model.Page + 1)" aria-label="Trang sau">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                    </nav>
                </div>
            </div>
        </section>
    </main>

    <partial name="_ConfirmDeleteModal" />

    <script>
        (() => {
            document.querySelector("[data-page-size]")?.addEventListener("change", (event) => {
                const url = new URL(window.location.href);
                url.searchParams.set("pageSize", event.target.value);
                url.searchParams.set("page", "1");
                window.location.href = url.toString();
            });
        })();
    </script>
    <script>
        (function() {
            var timer = null;
            document.querySelectorAll("[data-live-search]").forEach(function(el) {
                var event = el.tagName === "SELECT" ? "change" : "input";
                el.addEventListener(event, function() {
                    clearTimeout(timer);
                    var form = el.closest("form");
                    if (!form) return;
                    timer = setTimeout(function() {
                        var url = new URL(form.action, window.location.origin);
                        new FormData(form).forEach(function(v, k) {
                            if (v) url.searchParams.set(k, v);
                        });
                        url.searchParams.set("page", "1");
                        window.location.href = url.toString();
                    }, 300);
                });
            });
        })();
    </script>
}
