@* Khu vực giao diện của view ChonHoSo.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<HoSoSucKhoe>
@{
    ViewData["Title"] = "Chọn hồ sơ xem lịch sử tiêm";
}

<div class="list-page-head">
    <div>
        <h2>Chọn hồ sơ xem lịch sử tiêm</h2>
        <p>Chọn một hồ sơ để xem các mũi đã hoàn thành.</p>
    </div>
    <a asp-controller="HoSoSucKhoe" asp-action="Create" class="btn btn-primary">Thêm hồ sơ</a>
</div>

@* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
@if (Model.Count == 0)
{
    @* Khu vực thông báo phản hồi kết quả xử lý, ví dụ thành công, lỗi nhập liệu hoặc lỗi nghiệp vụ. *@
    <div class="alert alert-info">
        Bạn chưa có hồ sơ sức khỏe. Vui lòng tạo hồ sơ trước khi xem lịch sử tiêm.
    </div>
}
else
{
    <section class="list-card">
    @* Khu vực bảng dùng để hiển thị danh sách dữ liệu theo từng cột, giúp người dùng dễ theo dõi và thao tác. *@
    <table class="table list-table">
        <thead>
            <tr>
                <th>Hồ sơ</th>
                <th>Ngày sinh</th>
                <th>Giới tính</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="item-title">@item.HoTen</div>
                    <div class="item-meta">Mã hồ sơ #@item.MaHoSo</div>
                </td>
                <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                <td><span class="soft-badge">@item.GioiTinh</span></td>
                <td class="table-actions">
                    <a asp-action="Index" asp-route-maHoSo="@item.MaHoSo" class="btn btn-sm btn-primary">Xem lịch sử tiêm</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </section>
}
