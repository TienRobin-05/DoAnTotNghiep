@* Khu vực giao diện của view Index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<LichSuTiem>
@{
    ViewData["Title"] = "Lịch sử tiêm";
}

<div class="list-page-head">
    <div>
        <h1 class="user-page-title">Lịch sử tiêm của @ViewBag.HoTenHoSo</h1>
        <p>@Model.Count mũi tiêm đã được ghi nhận</p>
    </div>
    <a asp-action="ChonHoSo" class="btn btn-link">Chọn hồ sơ khác</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state empty-action">
        <div>
            <strong>Chưa có lịch sử tiêm</strong>
            <span>Khi cập nhật một lịch tiêm là đã tiêm, thông tin sẽ xuất hiện ở màn hình này.</span>
        </div>
        <a asp-controller="LichTiem" asp-action="ChonHoSo" class="btn btn-primary">Xem lịch tiêm</a>
    </div>
}
else
{
    <div style="margin-bottom:14px;">
        <div style="position:relative;max-width:360px;">
            <i class="bi bi-search" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#94a3b8;"></i>
            <input id="lichSuSearch" type="search" placeholder="Tìm kiếm vaccine, mũi tiêm..." style="width:100%;height:42px;border:1px solid #dbe7f5;border-radius:10px;padding:0 14px 0 40px;outline:none;" />
        </div>
    </div>

    <section class="list-card">
    <table class="table list-table">
        <thead>
            <tr>
                <th>Vaccine</th>
                <th>Mũi tiêm</th>
                <th>Ngày dự kiến</th>
                <th>Ngày thực tế</th>
                <th>Ghi chú</th>
                <th>Ngày cập nhật</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var searchText = $"{item.TenVaccine} {item.TenMui} {item.HoTenHoSo} Mũi {item.SoMui}";
            <tr data-search="@searchText">
                <td>
                    <div class="item-title table-main-text">@item.TenVaccine</div>
                    <div class="item-meta table-sub-text">@item.HoTenHoSo</div>
                </td>
                <td>
                    <span class="soft-badge">Mũi @item.SoMui</span>
                    <div class="item-meta table-sub-text">@item.TenMui</div>
                </td>
                <td>@item.NgayTiemDuKien.ToString("dd/MM/yyyy")</td>
                <td><span class="status-badge status-ok">@item.NgayTiemThucTe.ToString("dd/MM/yyyy")</span></td>
                <td class="text-truncate-cell">@item.GhiChu</td>
                <td>@item.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
    <div id="lichSuSearchEmpty" style="display:none;text-align:center;padding:24px;color:#64748b;font-weight:700;">Không tìm thấy lịch sử phù hợp.</div>
    </section>
}

<script>
(function() {
    var input = document.getElementById("lichSuSearch");
    var rows = document.querySelectorAll("table tbody tr[data-search]");
    var empty = document.getElementById("lichSuSearchEmpty");
    if (!input || !rows.length) return;
    function normalize(v) { return String(v||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/đ/g,"d").trim(); }
    function filter() {
        var kw = normalize(input.value);
        var count = 0;
        rows.forEach(function(r) {
            var match = kw === "" || normalize(r.getAttribute("data-search")||"").includes(kw);
            r.style.display = match ? "" : "none";
            if (match) count++;
        });
        if (empty) empty.style.display = count === 0 ? "" : "none";
    }
    input.addEventListener("input", filter);
})();
</script>
