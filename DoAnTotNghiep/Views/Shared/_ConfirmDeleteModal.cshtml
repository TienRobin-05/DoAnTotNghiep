<div class="delete-confirm-overlay" id="deleteConfirmOverlay" aria-hidden="true">
    <div class="delete-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="deleteConfirmTitle">
        <div class="delete-confirm-head">
            <span class="delete-confirm-icon" aria-hidden="true"><i class="bi bi-trash3"></i></span>
            <div>
                <h3 id="deleteConfirmTitle">Xác nhận xóa</h3>
                <p id="deleteConfirmMessage">Bạn có chắc chắn muốn xóa không?</p>
            </div>
        </div>
        <form id="deleteConfirmForm" method="post">
            @Html.AntiForgeryToken()
            <div class="delete-confirm-actions">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-delete-cancel>Hủy</button>
                <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
            </div>
        </form>
    </div>
</div>

<style>
    .delete-confirm-overlay {
        align-items: center;
        background: rgba(17, 24, 39, 0.42);
        display: none;
        inset: 0;
        justify-content: center;
        padding: 16px;
        position: fixed;
        z-index: 1050;
    }

    .delete-confirm-overlay.is-open {
        display: flex;
    }

    .delete-confirm-dialog {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
        max-width: 420px;
        padding: 18px;
        width: 100%;
    }

    .delete-confirm-head {
        align-items: flex-start;
        display: flex;
        gap: 12px;
    }

    .delete-confirm-icon {
        align-items: center;
        background: #fee2e2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        color: #dc2626;
        display: inline-flex;
        flex: 0 0 40px;
        font-size: 20px;
        height: 40px;
        justify-content: center;
        width: 40px;
    }

    .delete-confirm-dialog h3 {
        color: #111827;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.3;
        margin: 0 0 6px;
    }

    .delete-confirm-dialog p {
        color: #4b5563;
        font-size: 14px;
        line-height: 1.5;
        margin: 0;
    }

    .delete-confirm-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 18px;
    }

    @@media (max-width: 480px) {
        .delete-confirm-actions {
            flex-direction: column-reverse;
        }

        .delete-confirm-actions .btn {
            width: 100%;
        }
    }
</style>

<script>
    (function () {
        if (window.__deleteConfirmModalBound) return;
        window.__deleteConfirmModalBound = true;

        const overlay = document.getElementById("deleteConfirmOverlay");
        const form = document.getElementById("deleteConfirmForm");
        const title = document.getElementById("deleteConfirmTitle");
        const message = document.getElementById("deleteConfirmMessage");
        const cancelButton = overlay ? overlay.querySelector("[data-delete-cancel]") : null;
        const submitButton = form ? form.querySelector("button[type='submit']") : null;

        if (!overlay || !form || !title || !message || !cancelButton || !submitButton) return;

        let lastTrigger = null;

        const closeModal = function () {
            overlay.classList.remove("is-open");
            overlay.setAttribute("aria-hidden", "true");
            form.removeAttribute("action");
            submitButton.disabled = false;
            submitButton.textContent = "Xóa";
            if (lastTrigger) {
                lastTrigger.focus();
            }
        };

        const openModal = function (trigger) {
            lastTrigger = trigger;
            const deleteUrl = trigger.getAttribute("data-delete-url");
            if (!deleteUrl) return;

            form.setAttribute("action", deleteUrl);
            title.textContent = trigger.getAttribute("data-delete-title") || "Xác nhận xóa";
            message.textContent = "Bạn có chắc chắn muốn xóa không?";
            submitButton.disabled = false;
            submitButton.textContent = "Xóa";

            overlay.classList.add("is-open");
            overlay.setAttribute("aria-hidden", "false");
            cancelButton.focus();
        };

        document.addEventListener("click", function (event) {
            const trigger = event.target.closest(".js-delete-confirm");
            if (trigger) {
                event.preventDefault();
                openModal(trigger);
                return;
            }

            if (event.target === overlay || event.target.closest("[data-delete-cancel]")) {
                closeModal();
            }
        });

        form.addEventListener("submit", function () {
            submitButton.disabled = true;
            submitButton.textContent = "Đang xóa...";
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && overlay.classList.contains("is-open")) {
                closeModal();
            }
        });
    })();
</script>
