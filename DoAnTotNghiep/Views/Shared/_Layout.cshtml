@* Khu vực giao diện của view _Layout.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hồ sơ sức khỏe và tiêm chủng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/ui-polish.css?v=1" />
</head>
<body>
    @{
        var hoTen = Context.Session.GetString("HoTen");
        var soDienThoai = Context.Session.GetString("SoDienThoai");
        var email = Context.Session.GetString("Email");
        var vaiTro = Context.Session.GetString("VaiTro");
        var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
        var daDangNhap = maTaiKhoan.HasValue;
        var laAdmin = string.Equals(vaiTro, "Admin", StringComparison.OrdinalIgnoreCase);
        var tenHienThi = !string.IsNullOrWhiteSpace(hoTen)
            ? hoTen
            : (!string.IsNullOrWhiteSpace(soDienThoai) ? soDienThoai : email);
        tenHienThi = string.IsNullOrWhiteSpace(tenHienThi) ? "Tài khoản" : tenHienThi;
    }

    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="TaiKhoan" asp-action="DangNhap">Tiêm chủng</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuChinh">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuChinh">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
                    @if (daDangNhap && laAdmin)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Quản trị</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="taiKhoan">Tài khoản</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="vaccine" asp-action="index">Vaccine</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="muiTiemVaccine" asp-action="index">Mũi tiêm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="AdminBaiViet" asp-action="Index">Bài viết</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="cauHoiTuVan" asp-action="index">Tư vấn</a></li>
                    }
                    else if (daDangNhap)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="NguoiDung" asp-action="Index">Trang người dùng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="HoSoSucKhoe" asp-action="Index">Hồ sơ sức khỏe</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="LichTiem" asp-action="ChonHoSo">Lịch tiêm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="LichSuTiem" asp-action="ChonHoSo">Lịch sử tiêm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="vaccine" asp-action="TraCuu">Vaccine</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="BaiVietCamNang" asp-action="Index">Kiến thức</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="cauHoiTuVan" asp-action="index">Tư vấn</a></li>
                    }
                </ul>
                <div class="d-flex gap-2 align-items-center">
                    @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
                    @if (daDangNhap)
                    {
                        <div class="dropdown account-dropdown">
                            <button class="btn btn-outline-primary btn-sm dropdown-toggle account-name-button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @tenHienThi
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end account-dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="ThongTinCaNhan">Thông tin cá nhân</a></li>
                                <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DangXuat">Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                        <a class="btn btn-primary btn-sm" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container pb-4">
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
