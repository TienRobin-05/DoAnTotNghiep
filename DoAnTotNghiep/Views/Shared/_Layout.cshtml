@* Khu vực giao diện của view _Layout.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý sức khỏe và lịch tiêm chủng Pharmacy City</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/images/logo/pharmacy-favicon.png")" />
    <link rel="shortcut icon" type="image/png" href="@Url.Content("~/images/logo/pharmacy-favicon.png")" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/ui-polish.css?v=1" />
    <link rel="stylesheet" href="/css/pharmacy-typography.css?v=1" />
</head>
<body class="site-page-shell">
    @{
        var hoTen = Context.Session.GetString("HoTen");
        var soDienThoai = Context.Session.GetString("SoDienThoai");
        var email = Context.Session.GetString("Email");
        var vaiTro = Context.Session.GetString("VaiTro");
        var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
        var daDangNhap = maTaiKhoan.HasValue;
        var laAdmin = string.Equals(vaiTro, "Admin", StringComparison.OrdinalIgnoreCase);
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var tenHienThi = !string.IsNullOrWhiteSpace(hoTen)
            ? hoTen
            : (!string.IsNullOrWhiteSpace(soDienThoai) ? soDienThoai : email);
        tenHienThi = string.IsNullOrWhiteSpace(tenHienThi) ? "Tài khoản" : tenHienThi;

        string Active(string tenController, string? tenAction = null)
        {
            var dungController = string.Equals(controller, tenController, StringComparison.OrdinalIgnoreCase);
            var dungAction = tenAction == null || string.Equals(action, tenAction, StringComparison.OrdinalIgnoreCase);
            return dungController && dungAction ? "active" : "";
        }
    }

    <header class="top-header">
        <a class="brand-area" asp-controller="Home" asp-action="Index" aria-label="Pharmacy City">
            <img src="/images/logo/pharmacy-logo.png" alt="Pharmacy City" />
            <div class="brand-text">
                <h1>Quản lý sức khỏe và lịch tiêm chủng Pharmacy City</h1>
            </div>
        </a>
        <nav class="main-navbar" aria-label="Menu chức năng">
                    @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
                    @if (daDangNhap && laAdmin)
                    {
                        <a class="@Active("Admin", "Index")" asp-controller="Admin" asp-action="Index">Quản trị</a>
                        <a class="@Active("Admin", "taiKhoan")" asp-controller="Admin" asp-action="taiKhoan">Tài khoản</a>
                        <a class="@Active("vaccine")" asp-controller="vaccine" asp-action="index">Vaccine</a>
                        <a class="@Active("muiTiemVaccine")" asp-controller="muiTiemVaccine" asp-action="index">Mũi tiêm</a>
                        <a class="@Active("AdminBaiViet")" asp-controller="AdminBaiViet" asp-action="Index">Bài viết</a>
                        <a class="@Active("cauHoiTuVan")" asp-controller="cauHoiTuVan" asp-action="index">Tư vấn</a>
                    }
                    else if (daDangNhap)
                    {
                        <a class="@Active("NguoiDung", "Index")" asp-controller="NguoiDung" asp-action="Index">Trang chủ</a>
                        <a class="@Active("HoSoSucKhoe")" asp-controller="HoSoSucKhoe" asp-action="Index">Hồ sơ</a>
                        <a class="@Active("LichTiem")" asp-controller="LichTiem" asp-action="ChonHoSo">Lịch tiêm</a>
                        <a class="@Active("LichSuTiem")" asp-controller="LichSuTiem" asp-action="ChonHoSo">Lịch sử</a>
                        <a class="@Active("vaccine")" asp-controller="vaccine" asp-action="TraCuu">Vaccine</a>
                        <a class="@Active("ThongBao")" asp-controller="ThongBao" asp-action="Index">Thông báo</a>
                        <a class="@Active("BaiVietCamNang")" asp-controller="BaiVietCamNang" asp-action="Index">Kiến thức</a>
                        <a class="@Active("cauHoiTuVan")" asp-controller="cauHoiTuVan" asp-action="index">Tư vấn</a>
                    }
                    @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
                    @if (daDangNhap)
                    {
                        <div class="dropdown account-dropdown">
                            <button class="account-name-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @tenHienThi
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end account-dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="ThongTinCaNhan">Thông tin cá nhân</a></li>
                                <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DangXuat">Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                        <a class="active" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a>
                    }
        </nav>
    </header>

    <main class="container pb-4 mt-4">
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
