@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var hoTenDangNhap = Context.Session.GetString("HoTen");
    var soDienThoaiDangNhap = Context.Session.GetString("SoDienThoai");
    var emailDangNhap = Context.Session.GetString("Email");
    var tenTaiKhoanHienThi = !string.IsNullOrWhiteSpace(hoTenDangNhap)
        ? hoTenDangNhap
        : (!string.IsNullOrWhiteSpace(soDienThoaiDangNhap) ? soDienThoaiDangNhap : emailDangNhap);
    tenTaiKhoanHienThi = string.IsNullOrWhiteSpace(tenTaiKhoanHienThi) ? "Tài khoản" : tenTaiKhoanHienThi;

    string Active(string tenController, string? tenAction = null)
    {
        var dungController = string.Equals(controller, tenController, StringComparison.OrdinalIgnoreCase);
        var dungAction = tenAction == null || string.Equals(action, tenAction, StringComparison.OrdinalIgnoreCase);
        return dungController && dungAction ? "active" : "";
    }

    var activeBaiViet = Active("baiViet") == "active" || Active("AdminBaiViet") == "active" ? "active" : "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Pharmacy City Admin</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/images/logo/pharmacy-favicon.png")" />
    <link rel="shortcut icon" type="image/png" href="@Url.Content("~/images/logo/pharmacy-favicon.png")" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --font-main: 'Inter', 'Roboto', 'Segoe UI', Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: var(--font-main);
            color: #1f2937;
            background: #f4f7fb;
        }

        a {
            text-decoration: none;
        }

        .top-header {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            padding: 0 40px 0 24px;
            background: #ffffff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .brand-area {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 0 0 auto;
            min-width: 0;
            color: inherit;
        }

        .brand-area img {
            display: block;
            height: 48px;
            width: auto;
        }

        .brand-text h1 {
            margin: 0;
            color: #0066cc;
            font-size: 19px;
            font-weight: 800;
            line-height: 1.25;
            white-space: nowrap;
        }

        .brand-text p {
            margin: 2px 0 0;
            color: #0066cc;
            font-size: 14px;
            font-weight: 700;
            line-height: 1.2;
            white-space: nowrap;
        }

        .main-navbar {
            display: flex;
            flex: 1 1 auto;
            min-width: 0;
            align-items: center;
            justify-content: flex-end;
            gap: 14px;
            margin-left: 36px;
            overflow: visible;
        }

        .main-navbar a,
        .main-navbar summary {
            display: inline-flex;
            align-items: center;
            min-height: 38px;
            border-radius: 6px;
            padding: 9px 11px;
            color: #0066cc;
            background: transparent;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.2;
            text-decoration: none;
            white-space: nowrap;
        }

        .main-navbar a:hover,
        .main-navbar summary:hover {
            color: #084f9f;
            background: #eaf4ff;
        }

        .main-navbar a.active {
            color: #ffffff;
            background: #0066cc;
            box-shadow: 0 6px 14px rgba(0, 102, 204, 0.16);
        }

        .main-navbar .account-menu {
            position: relative;
            flex: 0 0 auto;
        }

        .main-navbar .account-menu summary {
            max-width: 210px;
            overflow: hidden;
            color: #ffffff;
            background: #0066cc;
            cursor: pointer;
            list-style: none;
            text-overflow: ellipsis;
        }

        .main-navbar .account-menu summary::-webkit-details-marker {
            display: none;
        }

        .main-navbar .account-menu summary::after {
            content: "▼";
            margin-left: 8px;
            font-size: 11px;
        }

        .main-navbar .account-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            z-index: 50;
            display: grid;
            min-width: 220px;
            padding: 8px;
            border-radius: 8px;
            background: #ffffff;
            box-shadow: 0 16px 36px rgba(15, 23, 42, 0.18);
        }

        .main-navbar .account-dropdown a {
            color: #1f2937;
            background: transparent;
            border-radius: 6px;
            padding: 10px 12px;
        }

        .main-navbar .account-dropdown a:hover {
            color: #0066cc;
            background: #eaf4ff;
        }

        .navbar {
            background: #0b63ce;
            color: #ffffff;
            box-shadow: 0 2px 10px rgba(15, 42, 77, 0.12);
        }

        .navbar-inner {
            max-width: 1380px;
            margin: 0 auto;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .brand {
            color: #ffffff;
            font-size: 20px;
            font-weight: 700;
            line-height: 1.3;
            white-space: nowrap;
        }

        .menu {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: flex-end;
            gap: 4px;
            overflow: visible;
        }

        .menu a {
            color: #eef6ff;
            padding: 9px 12px;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 600;
            white-space: nowrap;
        }

        .menu a:hover {
            background: rgba(255, 255, 255, 0.14);
        }

        .menu a.active {
            color: #0b63ce;
            background: #ffffff;
        }

        .menu .account-menu {
            position: relative;
            flex: 0 0 auto;
        }

        .menu .account-menu summary {
            display: inline-flex;
            align-items: center;
            max-width: 220px;
            overflow: hidden;
            padding: 9px 12px;
            border-radius: 6px;
            color: #0b63ce;
            background: #ffffff;
            cursor: pointer;
            font-size: 15px;
            font-weight: 700;
            list-style: none;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .menu .account-menu summary::-webkit-details-marker {
            display: none;
        }

        .menu .account-menu summary::after {
            content: "▾";
            margin-left: 8px;
            color: #0b63ce;
            font-size: 12px;
        }

        .menu .account-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            z-index: 50;
            display: grid;
            min-width: 220px;
            padding: 8px;
            border-radius: 8px;
            background: #ffffff;
            box-shadow: 0 16px 36px rgba(15, 23, 42, 0.18);
        }

        .menu .account-dropdown a {
            color: #1f2937;
            background: transparent;
            border-radius: 6px;
            padding: 10px 12px;
        }

        .menu .account-dropdown a:hover {
            color: #0b63ce;
            background: #eef6ff;
        }

        .page {
            max-width: 1320px;
            margin: 0 auto;
            padding: 24px;
        }

        .card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .welcome {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
        }

        .welcome h1 {
            margin: 0 0 8px;
            font-size: 28px;
        }

        .welcome p,
        .today {
            color: #6b7280;
        }

        .today {
            text-align: right;
            line-height: 1.5;
        }

        .stats {
            margin-top: 20px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .stat-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
        }

        .stat-title {
            color: #374151;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .stat-number {
            font-size: 34px;
            color: #0b63ce;
            font-weight: 700;
        }

        .stat-note,
        .empty {
            color: #6b7280;
        }

        .content {
            margin-top: 20px;
            display: grid;
            grid-template-columns: 1.15fr 1fr;
            gap: 20px;
        }

        .right-column {
            display: grid;
            gap: 20px;
        }

        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .section-title {
            margin: 0;
            font-size: 22px;
            color: #111827;
        }

        .btn {
            display: inline-block;
            padding: 9px 14px;
            border-radius: 6px;
            border: 1px solid #0b63ce;
            color: #0b63ce;
            background: #ffffff;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-primary {
            color: #ffffff;
            background: #0b63ce;
        }

        .btn-danger {
            color: #ffffff;
            background: #dc2626;
            border-color: #dc2626;
        }

        .btn-secondary {
            color: #374151;
            background: #ffffff;
            border-color: #9ca3af;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
        }

        th,
        td {
            padding: 12px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }

        th {
            background: #f9fafb;
        }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 6px;
            font-weight: 700;
        }

        .status-active {
            color: #15803d;
            background: #dcfce7;
        }

        .status-hide {
            color: #b45309;
            background: #fff2d8;
        }

        .list {
            display: grid;
            gap: 12px;
        }

        .list-item {
            display: block;
            padding-bottom: 12px;
            border-bottom: 1px solid #e5e7eb;
        }

        .list-item:last-child {
            padding-bottom: 0;
            border-bottom: 0;
        }

        .list-item strong {
            display: block;
            margin-bottom: 4px;
            color: #111827;
        }

        .list-item span,
        .list-item small {
            color: #6b7280;
        }

        .note {
            margin-top: 20px;
            padding: 14px 18px;
            border-radius: 8px;
            color: #0b4f9c;
            background: #eaf4ff;
            border: 1px solid #bfdbfe;
        }

        .empty {
            padding: 18px 0;
        }

        .footer {
            margin-top: 30px;
            padding: 18px 24px;
            background: #ffffff;
            border-top: 1px solid #e5e7eb;
            color: #6b7280;
            text-align: center;
        }

        .d-flex {
            display: flex;
        }

        .justify-content-between {
            justify-content: space-between;
        }

        .align-items-center {
            align-items: center;
        }

        .mb-3 {
            margin-bottom: 16px;
        }

        .mt-3 {
            margin-top: 16px;
        }

        .p-3 {
            padding: 16px;
        }

        .border {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .d-inline {
            display: inline;
        }

        .table-bordered {
            border: 1px solid #e5e7eb;
        }

        .table-striped tbody tr:nth-child(even) {
            background: #f9fafb;
        }

        .list-page-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            max-width: 980px;
            margin: 0 auto 16px;
            padding: 20px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .list-page-head h2 {
            margin: 0 0 8px;
            color: #111827;
            font-size: 30px;
            font-weight: 800;
            line-height: 1.2;
        }

        .list-page-head p {
            margin: 0;
            color: #6b7280;
            font-size: 20px;
            line-height: 1.4;
        }

        .list-page-head .btn {
            flex: 0 0 auto;
        }

        .list-toolbar {
            display: grid;
            grid-template-columns: minmax(220px, 1fr) auto auto;
            gap: 10px;
            align-items: center;
            max-width: 980px;
            margin: 0 auto 16px;
            padding: 14px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .list-card {
            max-width: 980px;
            margin: 0 auto;
            overflow: hidden;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .list-table {
            margin: 0;
            background: #ffffff;
        }

        .list-table th {
            color: #475569;
            background: #f8fafc;
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .list-table td {
            vertical-align: middle;
        }

        .item-title {
            color: #111827;
            font-weight: 800;
        }

        .item-title a {
            color: #0b63ce;
        }

        .item-meta {
            margin-top: 4px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.4;
        }

        .soft-badge,
        .dose-pill,
        .status-badge {
            display: inline-flex;
            align-items: center;
            min-height: 28px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
        }

        .soft-badge {
            color: #0b63ce;
            background: #eaf4ff;
        }

        .dose-pill {
            color: #ffffff;
            background: #111827;
        }

        .status-badge.status-ok {
            color: #166534;
            background: #dcfce7;
        }

        .status-badge.status-muted {
            color: #475569;
            background: #e2e8f0;
        }

        .status-badge.status-warning {
            color: #92400e;
            background: #fef3c7;
        }

        .table-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .empty-state {
            padding: 22px;
            border: 1px dashed #cbd5e1;
            border-radius: 8px;
            color: #64748b;
            background: #ffffff;
            font-weight: 700;
        }

        .text-truncate-cell {
            max-width: 320px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .btn-sm {
            padding: 6px 10px;
            font-size: 14px;
        }

        .btn-link {
            border: 0;
            background: transparent;
            color: #0b63ce;
        }

        .btn-outline-primary,
        .btn-outline-secondary,
        .btn-outline-info,
        .btn-outline-warning {
            color: #0b63ce;
            background: #ffffff;
            border-color: #0b63ce;
        }

        .btn-outline-danger {
            color: #dc2626;
            background: #ffffff;
            border-color: #dc2626;
        }

        .alert {
            padding: 14px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
        }

        .alert-info {
            color: #0b4f9c;
            background: #eaf4ff;
            border: 1px solid #bfdbfe;
        }

        .text-muted {
            color: #6b7280;
        }

        .page > .d-flex.justify-content-between.align-items-center.mb-3 {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px 20px 0;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-bottom: 0;
            border-radius: 8px 8px 0 0;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .page > .d-flex.justify-content-between.align-items-center.mb-3 h2 {
            margin-bottom: 16px;
        }

        .page > .d-flex.justify-content-between.align-items-center.mb-3 + .card {
            border-top: 0;
            border-radius: 0 0 8px 8px;
            box-shadow: 0 8px 14px rgba(0, 0, 0, 0.04);
        }

        h1,
        h2 {
            margin-top: 0;
            margin-bottom: 16px;
            color: #111827;
        }

        h2 {
            font-size: 24px;
        }

        p {
            line-height: 1.6;
        }

        .page > form,
        .page > dl,
        .page > .card {
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }

        .page > form,
        .page > dl {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            color: #374151;
            font-weight: 700;
        }

        .form-control,
        .form-select {
            width: 100%;
            min-height: 42px;
            padding: 9px 11px;
            border: 1px solid #cfd8e6;
            border-radius: 6px;
            color: #1f2937;
            background: #ffffff;
            font-family: inherit;
            font-size: 15px;
        }

        textarea.form-control {
            min-height: 110px;
            resize: vertical;
        }

        .form-control:focus,
        .form-select:focus {
            outline: 0;
            border-color: #0b63ce;
            box-shadow: 0 0 0 3px rgba(11, 99, 206, 0.12);
        }

        .form-control[readonly] {
            color: #6b7280;
            background: #f9fafb;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 0 16px;
        }

        .col-md-3,
        .col-md-4,
        .col-md-6,
        .col-md-7,
        .col-md-8 {
            width: 100%;
        }

        @@media (min-width: 768px) {
            .col-md-3 {
                flex: 0 0 calc(25% - 12px);
                max-width: calc(25% - 12px);
            }

            .col-md-4 {
                flex: 0 0 calc(33.333% - 11px);
                max-width: calc(33.333% - 11px);
            }

            .col-md-6 {
                flex: 0 0 calc(50% - 8px);
                max-width: calc(50% - 8px);
            }

            .col-md-7 {
                max-width: 720px;
            }

            .col-md-8 {
                max-width: 900px;
            }
        }

        .card-body {
            padding: 0;
        }

        .alert-danger {
            color: #842029;
            background: #f8d7da;
            border: 1px solid #f5c2c7;
        }

        .alert-success {
            color: #146c43;
            background: #d1e7dd;
            border: 1px solid #badbcc;
        }

        .alert-warning {
            color: #8a5a00;
            background: #fff3cd;
            border: 1px solid #ffecb5;
        }

        .text-danger {
            color: #dc2626;
        }

        .detail-card {
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .detail-card p:first-child {
            margin-top: 0;
        }

        .article-content {
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
            white-space: pre-wrap;
            line-height: 1.7;
        }

        hr {
            border: 0;
            border-top: 1px solid #e5e7eb;
            margin: 16px 0;
        }

        dl {
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: 10px 16px;
        }

        dt {
            color: #374151;
            font-weight: 700;
        }

        dd {
            margin: 0;
            color: #1f2937;
        }

        @@media (max-width: 1200px) {
            .top-header {
                padding: 0 20px;
            }

            .main-navbar {
                gap: 10px;
                margin-left: 20px;
            }

            .main-navbar a,
            .main-navbar summary {
                padding: 8px 9px;
                font-size: 14px;
            }

            .brand-text h1 {
                font-size: 22px;
            }

            .brand-text p {
                font-size: 12px;
            }
        }

        @@media (max-width: 1050px) {
            .top-header {
                align-items: flex-start;
                flex-direction: column;
                height: auto;
                padding: 12px 16px;
            }

            .main-navbar {
                width: 100%;
                margin-left: 0;
                justify-content: flex-start;
                overflow-x: auto;
                padding-bottom: 4px;
            }

            .main-navbar a,
            .main-navbar summary {
                flex: 0 0 auto;
            }

            .navbar-inner {
                align-items: flex-start;
                flex-direction: column;
                gap: 10px;
            }

            .brand {
                white-space: normal;
            }

            .menu {
                width: 100%;
                justify-content: flex-start;
                padding-bottom: 4px;
            }
        }

        @@media (max-width: 900px) {
            .welcome {
                align-items: flex-start;
                flex-direction: column;
            }

            .today {
                text-align: left;
            }

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .content {
                grid-template-columns: 1fr;
            }

            .page {
                padding: 16px;
            }

            .list-card {
                overflow-x: auto;
            }

            .list-table {
                min-width: 720px;
            }

            .list-page-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .list-page-head h2 {
                font-size: 26px;
            }

            .list-page-head p {
                font-size: 17px;
            }

            .list-toolbar {
                grid-template-columns: 1fr;
            }

            th,
            td {
                padding: 10px 8px;
            }
        }

        @@media (max-width: 600px) {
            .stats {
                grid-template-columns: 1fr;
            }
        }

        .admin-shell {
            display: grid;
            grid-template-columns: 260px minmax(0, 1fr);
            min-height: 100vh;
            background: #f5f8fc;
        }

        .admin-sidebar {
            position: sticky;
            top: 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
            padding: 0 16px 18px;
            border-right: 1px solid #e2e8f0;
            background: #ffffff;
            z-index: 20;
        }

        .admin-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 80px;
            padding: 20px 4px;
            color: #0f172a;
        }

        .admin-brand img {
            width: 40px;
            height: 40px;
            max-width: 40px;
            max-height: 40px;
            object-fit: contain;
            flex: 0 0 auto;
        }

        .admin-brand strong {
            color: #0866d8;
            font-size: 17px;
            font-weight: 850;
            line-height: 1.2;
            white-space: nowrap;
        }

        .admin-side-nav {
            display: grid;
            gap: 8px;
            padding-top: 8px;
        }

        .admin-side-nav a {
            display: flex;
            align-items: center;
            gap: 11px;
            min-height: 46px;
            padding: 12px 16px;
            border-radius: 12px;
            color: #334155;
            font-size: 15px;
            font-weight: 750;
            transition: background .18s ease, color .18s ease, transform .18s ease;
        }

        .admin-side-nav a:hover {
            color: #0866d8;
            background: #eff6ff;
        }

        .admin-side-nav a.active {
            color: #ffffff;
            background: #0866d8;
            box-shadow: 0 12px 24px rgba(8, 102, 216, .18);
        }

        .admin-side-nav i {
            width: 20px;
            text-align: center;
            font-size: 18px;
        }

        .admin-sidebar-card {
            margin-top: auto;
            padding: 16px;
            border: 1px solid #dbeafe;
            border-radius: 12px;
            background: #f1f7ff;
            text-align: center;
        }

        .admin-sidebar-card strong {
            display: block;
            color: #0f172a;
            font-size: 14px;
            font-weight: 850;
        }

        .admin-sidebar-card p {
            margin: 8px 0 12px;
            color: #64748b;
            font-size: 12px;
            line-height: 1.45;
        }

        .admin-version {
            display: inline-flex;
            align-items: center;
            min-height: 26px;
            padding: 4px 10px;
            border-radius: 999px;
            color: #0866d8;
            background: #dbeafe;
            font-size: 12px;
            font-weight: 800;
        }

        .admin-main {
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .admin-main .page {
            width: 100%;
            max-width: none;
            margin: 0;
            padding: 24px;
        }

        .admin-main .footer {
            margin-top: auto;
        }

        @@media (max-width: 960px) {
            .admin-shell {
                grid-template-columns: 1fr;
            }

            .admin-sidebar {
                position: static;
                height: auto;
                padding: 0 16px 14px;
                border-right: 0;
                border-bottom: 1px solid #e2e8f0;
            }

            .admin-side-nav {
                grid-template-columns: repeat(4, minmax(0, 1fr));
                overflow-x: auto;
            }

            .admin-side-nav a {
                justify-content: center;
                white-space: nowrap;
            }

            .admin-sidebar-card {
                display: none;
            }
        }

        @@media (max-width: 640px) {
            .admin-side-nav {
                grid-template-columns: 1fr;
            }

            .admin-main .page {
                padding: 16px;
            }
        }
    </style>
    <link rel="stylesheet" href="/css/ui-polish.css?v=1" />
</head>
<body class="site-page-shell">
    <div class="admin-shell">
        <aside class="admin-sidebar" aria-label="Menu quản trị">
            <a class="admin-brand" href="/Admin/Index" aria-label="Pharmacy City Admin">
                <img src="/images/logo/pharmacy-favicon.png" alt="Pharmacy City" />
                <strong>Pharmacy City</strong>
            </a>

            <nav class="admin-side-nav">
                <a class="@Active("Admin", "Index")" href="/Admin/Index"><i class="bi bi-house-door"></i><span>Trang chủ</span></a>
                <a class="@Active("vaccine")" href="/vaccine/index"><i class="bi bi-shield-plus"></i><span>Vaccine</span></a>
                <a class="@Active("muiTiemVaccine")" href="/muiTiemVaccine/index"><i class="bi bi-syringe"></i><span>Mũi tiêm</span></a>
                <a class="@activeBaiViet" href="/AdminBaiViet/Index"><i class="bi bi-newspaper"></i><span>Bài viết</span></a>
                <a class="@Active("cauHoiTuVan")" href="/cauHoiTuVan/index"><i class="bi bi-chat-dots"></i><span>Câu hỏi tư vấn</span></a>
                <a class="@Active("QuickQuestionAdmin")" href="/QuickQuestionAdmin/Index"><i class="bi bi-lightning-charge"></i><span>Câu hỏi nhanh</span></a>
                <a class="@Active("Admin", "taiKhoan")" href="/Admin/taiKhoan"><i class="bi bi-people"></i><span>Tài khoản</span></a>
            </nav>

            <div class="admin-sidebar-card">
                <strong>Pharmacy City Admin</strong>
                <p>Hệ thống quản lý sức khỏe<br />và lịch tiêm chủng</p>
                <span class="admin-version">Phiên bản 1.0.0</span>
            </div>
        </aside>

        <div class="admin-main">
            <main class="page">
                <partial name="_ThongBao" />
                @RenderBody()
            </main>

            <partial name="_Footer" />
        </div>
    </div>
    <script>
        (() => {
            const accountMenus = document.querySelectorAll(".account-menu");
            if (!accountMenus.length) return;

            document.addEventListener("click", (event) => {
                accountMenus.forEach((accountMenu) => {
                    if (!accountMenu.contains(event.target)) {
                        accountMenu.open = false;
                    }
                });
            });

            document.addEventListener("keydown", (event) => {
                if (event.key !== "Escape") return;

                accountMenus.forEach((accountMenu) => {
                    accountMenu.open = false;
                });
            });
        })();
    </script>
</body>
</html>
