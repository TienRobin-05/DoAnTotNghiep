@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var laTrangDangNhap = string.Equals(action, "DangNhap", StringComparison.OrdinalIgnoreCase);
    var laTrangDangKy = string.Equals(action, "DangKy", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống quản lý sức khỏe và lịch tiêm chủng</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            color: #17233c;
            background: linear-gradient(180deg, #f8fbff 0%, #ffffff 45%, #f7fbff 100%);
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .auth-header {
            background: #ffffff;
            border-bottom: 1px solid #dbe7f5;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .05);
        }

        .auth-header-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 16px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .auth-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #0b63ce;
            font-size: 24px;
            font-weight: bold;
        }

        .auth-logo {
            width: 46px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 34px;
            font-weight: bold;
            line-height: 1;
            background: linear-gradient(180deg, #2f80ff 0%, #0b63ce 100%);
            border-radius: 12px 12px 22px 22px;
            box-shadow: 0 8px 18px rgba(11, 99, 206, 0.22);
        }

        .auth-nav {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .auth-nav a {
            display: inline-block;
            min-width: 120px;
            padding: 12px 20px;
            border: 1px solid #0b63ce;
            border-radius: 8px;
            color: #0b63ce;
            background: #ffffff;
            text-decoration: none;
            text-align: center;
            font-size: 16px;
            font-weight: bold;
        }

        .auth-nav a.auth-nav-primary {
            color: #ffffff;
            background: #0b63ce;
        }

        .auth-main {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 48px 20px 72px;
        }

        .auth-card {
            width: 100%;
            max-width: 650px;
            background: #ffffff;
            border: 1px solid #d9e2ef;
            border-radius: 8px;
            box-shadow: 0 8px 24px rgba(15, 42, 77, 0.10);
            padding: 34px 36px 28px;
        }

        .auth-title {
            margin: 0;
            text-align: center;
            font-size: 34px;
            color: #17233c;
        }

        .auth-subtitle {
            margin: 14px 0 28px;
            text-align: center;
            font-size: 17px;
            color: #5f6f86;
        }

        .auth-alert {
            margin-bottom: 18px;
            padding: 12px 14px;
            border-radius: 6px;
            font-size: 15px;
            transition: opacity 0.25s ease, transform 0.25s ease;
        }

        .auth-alert.is-hiding {
            opacity: 0;
            transform: translateY(-4px);
        }

        .auth-alert.success {
            color: #146c43;
            background: #d1e7dd;
            border: 1px solid #badbcc;
        }

        .auth-alert.error {
            color: #842029;
            background: #f8d7da;
            border: 1px solid #f5c2c7;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 15px;
            font-weight: 700;
            color: #17233c;
        }

        .input-box {
            display: flex;
            align-items: center;
            height: 52px;
            border: 1px solid #cfd8e6;
            border-radius: 6px;
            background: #ffffff;
        }

        .input-box:focus-within {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
        }

        .input-box input {
            width: 100%;
            height: 100%;
            border: 0;
            outline: 0;
            padding: 0 14px;
            font-size: 16px;
            color: #17233c;
            background: transparent;
        }

        .input-box input::placeholder {
            color: #8592a5;
        }

        .form-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin: 8px 0 24px;
            color: #27364d;
            font-size: 16px;
        }

        .check-line {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .check-line input {
            width: 18px;
            height: 18px;
            margin: 0;
        }

        .auth-link {
            color: #0d6efd;
            text-decoration: none;
        }

        .auth-button {
            width: 100%;
            height: 54px;
            border: 0;
            border-radius: 6px;
            color: #ffffff;
            background: linear-gradient(180deg, #2f7df4, #0d6efd);
            font-size: 19px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 16px rgba(13, 110, 253, 0.18);
        }

        .auth-button:hover {
            background: linear-gradient(180deg, #1f70ed, #075fd9);
        }

        .auth-divider {
            display: flex;
            align-items: center;
            gap: 18px;
            margin: 28px 0 18px;
            color: #9aa6b6;
        }

        .auth-divider::before,
        .auth-divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #d9e2ef;
        }

        .auth-switch {
            text-align: center;
            color: #27364d;
            font-size: 17px;
        }

        .auth-footer {
            padding: 24px 16px;
            text-align: center;
            color: #6b778c;
            border-top: 1px solid #d9e2ef;
            background: #ffffff;
        }

        @@media (max-width: 900px) {
            .auth-header-inner {
                flex-direction: column;
                align-items: flex-start;
            }

            .auth-brand {
                font-size: 20px;
            }

            .auth-nav {
                width: 100%;
                gap: 12px;
            }
        }

        @@media (max-width: 520px) {
            .auth-card {
                padding: 26px 18px;
            }

            .auth-title {
                font-size: 28px;
            }

            .form-row {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>
    <div class="auth-page">
                <header class="auth-header">
            <div class="auth-header-inner">
                <a class="auth-brand" asp-controller="Home" asp-action="Index">
                    <span class="auth-logo">+</span>
                    <span>H&#7879; th&#7889;ng qu&#7843;n l&#253; s&#7913;c kh&#7887;e v&#224; l&#7883;ch ti&#234;m ch&#7911;ng</span>
                </a>

                <nav class="auth-nav">
                    <a asp-controller="Home" asp-action="Index">Gi&#7899;i thi&#7879;u</a>
                    @if (laTrangDangNhap)
                    {
                        <a class="auth-nav-primary" asp-controller="TaiKhoan" asp-action="DangKy">&#272;&#259;ng k&#253;</a>
                    }
                    else
                    {
                        <a class="auth-nav-primary" asp-controller="TaiKhoan" asp-action="DangNhap">&#272;&#259;ng nh&#7853;p</a>
                    }
                </nav>
            </div>
        </header>

        <main class="auth-main">
            @RenderBody()
        </main>

        <footer class="auth-footer">
            © 2024 Hệ thống quản lý sức khỏe và lịch tiêm chủng. All rights reserved.
        </footer>
    </div>
    <script>
        window.setTimeout(function () {
            document.querySelectorAll(".auth-alert").forEach(function (alert) {
                alert.classList.add("is-hiding");
                window.setTimeout(function () {
                    alert.style.display = "none";
                }, 250);
            });
        }, 1600);
    </script>
</body>
</html>

