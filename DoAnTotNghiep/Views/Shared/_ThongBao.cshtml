@{
    var thongBaoTempData = TempData["ThongBao"]?.ToString();
    var thongBaoViewBag = ViewBag.ThongBao?.ToString();
    var thongBao = !string.IsNullOrWhiteSpace(thongBaoTempData) ? thongBaoTempData : thongBaoViewBag;
    var loaiThongBao = TempData["LoaiThongBao"]?.ToString()
        ?? (!string.IsNullOrWhiteSpace(thongBaoTempData) ? "success" : "error");
    var cssClass = string.Equals(loaiThongBao, "error", StringComparison.OrdinalIgnoreCase)
        ? "app-flash-danger"
        : string.Equals(loaiThongBao, "warning", StringComparison.OrdinalIgnoreCase)
            ? "app-flash-warning"
            : "app-flash-success";
    var iconClass = string.Equals(loaiThongBao, "error", StringComparison.OrdinalIgnoreCase)
        ? "bi-x-circle"
        : string.Equals(loaiThongBao, "warning", StringComparison.OrdinalIgnoreCase)
            ? "bi-exclamation-triangle"
            : "bi-check-circle";
}

@if (!string.IsNullOrWhiteSpace(thongBao))
{
    <style>
        .app-flash {
            display: flex;
            align-items: center;
            gap: 10px;
            width: min(100%, 980px);
            margin: 0 auto 14px;
            padding: 10px 12px;
            border: 1px solid;
            border-radius: 6px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
            font-size: 14px;
            font-weight: 700;
            line-height: 1.45;
            transition: opacity .22s ease, transform .22s ease, margin .22s ease, padding .22s ease;
        }

        .app-flash.is-hiding {
            margin-bottom: 0;
            padding-top: 0;
            padding-bottom: 0;
            opacity: 0;
            transform: translateY(-4px);
        }

        .app-flash-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            font-size: 18px;
        }

        .app-flash-message {
            min-width: 0;
            flex: 1 1 auto;
        }

        .app-flash-close {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            width: 28px;
            height: 28px;
            border: 0;
            border-radius: 6px;
            color: inherit;
            background: transparent;
            cursor: pointer;
            opacity: .72;
        }

        .app-flash-close:hover {
            background: rgba(15, 23, 42, .06);
            opacity: 1;
        }

        .app-flash-success {
            color: #047857;
            background: #ecfdf5;
            border-color: #a7f3d0;
        }

        .app-flash-danger {
            color: #b91c1c;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .app-flash-warning {
            color: #8a5a00;
            background: #fffbeb;
            border-color: #fde68a;
        }

        @@media (max-width: 640px) {
            .app-flash {
                align-items: flex-start;
                font-size: 13px;
            }
        }
    </style>

    <div class="app-flash @cssClass js-auto-alert" role="status" aria-live="polite">
        <i class="bi @iconClass app-flash-icon" aria-hidden="true"></i>
        <span class="app-flash-message">@thongBao</span>
        <button type="button" class="app-flash-close" data-alert-close aria-label="Đóng thông báo">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>
}

<script>
    function hideAppFlash(alert) {
        if (!alert || alert.classList.contains("is-hiding")) return;
        alert.classList.add("is-hiding");
        window.setTimeout(function () {
            alert.remove();
        }, 260);
    }

    document.querySelectorAll(".js-auto-alert").forEach(function (alert) {
        window.setTimeout(function () {
            hideAppFlash(alert);
        }, 3000);
    });

    document.addEventListener("click", function (event) {
        var closeButton = event.target.closest("[data-alert-close]");
        if (closeButton) {
            hideAppFlash(closeButton.closest(".js-auto-alert"));
            return;
        }

        var target = event.target.closest("a, button");
        if (!target) return;

        if (target.closest(".js-delete-confirm")) return;

        var message = target.getAttribute("data-confirm");
        var href = target.getAttribute("href") || "";
        var form = target.closest("form");
        if (form && form.id === "deleteConfirmForm") return;

        var formAction = form ? (form.getAttribute("action") || "") : "";
        var text = (target.textContent || "").trim().toLowerCase();

        if (!message && href.indexOf("/TaiKhoan/DangXuat") >= 0) {
            message = "Bạn có chắc chắn muốn đăng xuất không?";
        }

        if (!message && (href.toLowerCase().indexOf("delete") >= 0 || formAction.toLowerCase().indexOf("delete") >= 0 || text === "xóa")) {
            message = "Bạn có chắc chắn muốn xóa dữ liệu này không?";
        }

        if (!message && (formAction.toLowerCase().indexOf("doitrangthai") >= 0 || formAction.toLowerCase().indexOf("anhien") >= 0 || text === "ẩn" || text === "hiện")) {
            message = "Bạn có chắc chắn muốn đổi trạng thái không?";
        }

        if (message && !window.confirm(message)) {
            event.preventDefault();
        }
    });
</script>
