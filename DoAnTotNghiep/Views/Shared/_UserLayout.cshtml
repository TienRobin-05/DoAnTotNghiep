            }

            .col-md-7 {
                max-width: 720px;
            }

            .col-md-8 {
                max-width: 860px;
            }
        }

        .card-body {
            padding: 0;
        }

        .alert-danger {
            color: #842029;
            background: #f8d7da;
            border: 1px solid #f5c2c7;
        }

        .alert-success {
            color: #146c43;
            background: #d1e7dd;
            border: 1px solid #badbcc;
        }

        .alert-warning {
            color: #8a5a00;
            background: #fff3cd;
            border: 1px solid #ffecb5;
        }

        .text-danger {
            color: #dc2626;
        }

        .detail-card {
            max-width: 860px;
            margin-left: auto;
            margin-right: auto;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .detail-card p:first-child {
            margin-top: 0;
        }

        .article-content {
            max-width: 860px;
            margin-left: auto;
            margin-right: auto;
            white-space: pre-wrap;
            line-height: 1.7;
        }

        .list-page-head,
        .compact-filter,
        .schedule-list,
        .empty-state {
            max-width: 980px;
            margin-left: auto;
            margin-right: auto;
        }

        .list-page-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 16px;
            padding: 20px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .list-page-head h2 {
            margin: 0 0 8px;
            color: #111827;
            font-size: 30px;
            font-weight: 800;
            line-height: 1.2;
        }

        .list-page-head p {
            margin: 0;
            color: #6b7280;
            font-size: 20px;
            line-height: 1.4;
        }

        .list-page-head .btn {
            flex: 0 0 auto;
        }

        .handbook-head {
            align-items: center;
        }

        .handbook-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 116px;
            min-height: 42px;
            padding: 8px 14px;
            border-radius: 999px;
            color: #075985;
            background: #e0f2fe;
            font-size: 15px;
            font-weight: 800;
            white-space: nowrap;
        }

        .handbook-news {
            display: grid;
            gap: 18px;
            max-width: 980px;
            margin: 0 auto;
        }

        .handbook-feature-card,
        .handbook-card {
            overflow: hidden;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
            color: inherit;
            text-decoration: none;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.07);
            transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        }

        .handbook-feature-card:hover,
        .handbook-card:hover {
            color: inherit;
            border-color: #bae6fd;
            transform: translateY(-2px);
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.11);
        }

        .handbook-feature-card {
            display: grid;
            grid-template-columns: minmax(260px, 0.95fr) minmax(0, 1.25fr);
            min-height: 310px;
        }

        .handbook-feature-visual,
        .handbook-card-visual {
            position: relative;
            display: flex;
            align-items: flex-end;
            min-height: 100%;
            padding: 18px;
            color: #ffffff;
            isolation: isolate;
        }

        .handbook-feature-visual::after,
        .handbook-card-visual::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.05), rgba(15, 23, 42, 0.46));
        }

        .handbook-feature-visual span,
        .handbook-card-visual span {
            display: inline-flex;
            align-items: center;
            min-height: 34px;
            padding: 7px 12px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.9);
            color: #0f172a;
            font-size: 13px;
            font-weight: 800;
        }

        .guide-card-vaccine {
            background:
                radial-gradient(circle at 72% 24%, rgba(255, 255, 255, 0.72) 0 10%, transparent 11%),
                radial-gradient(circle at 28% 72%, rgba(14, 165, 233, 0.5) 0 18%, transparent 19%),
                linear-gradient(135deg, #0369a1, #14b8a6 58%, #facc15);
        }

        .guide-card-care {
            background:
                radial-gradient(circle at 28% 28%, rgba(255, 255, 255, 0.74) 0 12%, transparent 13%),
                radial-gradient(circle at 78% 70%, rgba(34, 197, 94, 0.42) 0 20%, transparent 21%),
                linear-gradient(135deg, #166534, #22c55e 52%, #86efac);
        }

        .guide-card-family {
            background:
                radial-gradient(circle at 72% 32%, rgba(255, 255, 255, 0.72) 0 12%, transparent 13%),
                radial-gradient(circle at 24% 74%, rgba(251, 146, 60, 0.45) 0 18%, transparent 19%),
                linear-gradient(135deg, #b45309, #f97316 48%, #38bdf8);
        }

        .guide-card-doctor {
            background:
                radial-gradient(circle at 26% 34%, rgba(255, 255, 255, 0.78) 0 11%, transparent 12%),
                radial-gradient(circle at 78% 70%, rgba(125, 211, 252, 0.5) 0 18%, transparent 19%),
                linear-gradient(135deg, #1e40af, #38bdf8 56%, #a7f3d0);
        }

        .handbook-feature-body,
        .handbook-card-body {
            display: flex;
            min-width: 0;
            flex-direction: column;
            gap: 10px;
            padding: 22px;
        }

        .handbook-feature-body {
            justify-content: center;
            padding: 30px;
        }

        .handbook-topic {
            width: fit-content;
            max-width: 100%;
            padding: 6px 10px;
            border-radius: 999px;
            color: #0f766e;
            background: #ccfbf1;
            font-size: 12px;
            font-weight: 850;
            text-transform: uppercase;
        }

        .handbook-feature-body h3,
        .handbook-card-body h3 {
            margin: 0;
            color: #111827;
            font-weight: 850;
            line-height: 1.25;
        }

        .handbook-feature-body h3 {
            font-size: 28px;
        }

        .handbook-card-body h3 {
            display: -webkit-box;
            min-height: 56px;
            overflow: hidden;
            font-size: 20px;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }

        .handbook-feature-body p,
        .handbook-card-body p {
            margin: 0;
            color: #4b5563;
            line-height: 1.65;
        }

        .handbook-card-body p {
            display: -webkit-box;
            min-height: 78px;
            overflow: hidden;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }

        .handbook-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 14px;
            margin-top: auto;
            color: #64748b;
            font-size: 14px;
            font-weight: 650;
        }

        .handbook-readmore {
            width: fit-content;
            margin-top: 4px;
            padding: 9px 14px;
            border-radius: 8px;
            color: #ffffff;
            background: #0b63ce;
            font-weight: 800;
        }

        .handbook-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
        }

        .handbook-card {
            display: grid;
            grid-template-rows: 150px minmax(0, 1fr);
            min-height: 410px;
        }

        .list-toolbar {
            display: grid;
            grid-template-columns: minmax(220px, 1fr) auto auto;
            gap: 10px;
            align-items: center;
            max-width: 980px;
            margin: 0 auto 16px;
            padding: 14px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .compact-filter {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
            padding: 6px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .compact-filter .btn {
            border-color: transparent;
            color: #374151;
            background: transparent;
        }

        .compact-filter .btn.active {
            color: #ffffff;
            background: #0b63ce;
            border-color: #0b63ce;
        }

        .schedule-list {
            display: grid;
            gap: 14px;
        }

        .schedule-group {
            overflow: hidden;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .schedule-group-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 14px 16px;
            border-bottom: 1px solid #eef2f7;
            background: #f8fafc;
        }

        .schedule-group-head h3 {
            margin: 0;
            color: #111827;
            font-size: 19px;
            font-weight: 800;
        }

        .schedule-group-head span {
            display: inline-block;
            margin-top: 5px;
            color: #6b7280;
            font-size: 14px;
        }

        .schedule-group-head strong {
            padding: 5px 10px;
            border-radius: 999px;
            color: #0b63ce;
            background: #eaf4ff;
            white-space: nowrap;
        }

        .schedule-rows {
            display: grid;
        }

        .schedule-item {
            display: grid;
            grid-template-columns: minmax(240px, 1fr) 110px 92px auto;
            gap: 12px;
            align-items: center;
            padding: 12px 16px;
            border-bottom: 1px solid #eef2f7;
        }

        .schedule-item:last-child {
            border-bottom: 0;
        }

        .schedule-title {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .schedule-title strong {
            color: #111827;
        }

        .schedule-title span,
        .item-meta {
            color: #6b7280;
        }

        .item-meta {
            margin-top: 4px;
            font-size: 14px;
            line-height: 1.35;
            max-width: 520px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .schedule-date {
            color: #111827;
            font-weight: 800;
            white-space: nowrap;
        }

        .status-badge {
            display: inline-flex;
            justify-content: center;
            min-width: 82px;
            padding: 5px 10px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
        }

        .status-ok {
            color: #166534;
            background: #dcfce7;
        }

        .status-info {
            color: #15803d;
            background: #dcfce7;
        }

        .status-warning {
            color: #92400e;
            background: #fef3c7;
        }

        .status-danger {
            color: #b91c1c;
            background: #fee2e2;
        }

        .status-muted {
            color: #475569;
            background: #e2e8f0;
        }

        .status-advice {
            color: #a16207;
            background: #fef3c7;
        }

        .empty-state {
            padding: 20px;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            color: #64748b;
            background: #ffffff;
            font-weight: 700;
        }

        .text-truncate-cell {
            max-width: 320px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        hr {
            border: 0;
            border-top: 1px solid #e5e7eb;
            margin: 16px 0;
        }

        dl {
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: 10px 16px;
        }

        dt {
            color: #374151;
            font-weight: 700;
        }

        dd {
            margin: 0;
            color: #1f2937;
        }

        @@media (max-width: 1200px) {
            .top-header {
                padding: 0 20px;
            }

            .main-navbar {
                gap: 10px;
                margin-left: 20px;
            }

            .main-navbar a,
            .main-navbar summary {
                padding: 8px 9px;
                font-size: 14px;
            }

            .brand-text h1 {
                font-size: 22px;
            }

            .brand-text p {
                font-size: 12px;
            }
        }

        @@media (max-width: 1500px) {
            .dashboard-topbar-inner {
                grid-template-columns: 220px minmax(0, 1fr) auto;
                gap: 14px;
            }

            .dashboard-brand-logo {
                width: 28px;
                height: 28px;
            }

            .dashboard-brand-title {
                max-width: 150px;
                font-size: 11px;
            }

            .dashboard-nav-link {
                padding: 0 10px;
                font-size: 14px;
            }
        }

        @@media (max-width: 1280px) {
            .dashboard-topbar-inner {
                grid-template-columns: 210px minmax(0, 1fr) auto;
                gap: 12px;
                padding: 0 16px;
            }

            .dashboard-brand-logo {
                width: 28px;
                height: 28px;
            }

            .dashboard-brand-title {
                max-width: 145px;
                font-size: 11px;
                -webkit-line-clamp: 2;
            }

            .dashboard-nav {
                justify-content: flex-start;
                overflow-x: auto;
                scrollbar-width: none;
            }

            .dashboard-nav::-webkit-scrollbar {
                display: none;
            }
        }

        @@media (max-width: 992px) {
            .dashboard-topbar-inner {
                grid-template-columns: 1fr auto;
                grid-template-areas:
                    "brand user"
                    "nav nav";
                padding: 12px 16px;
                gap: 12px;
            }

            .dashboard-brand {
                grid-area: brand;
            }

            .dashboard-user,
            .dashboard-login-link {
                grid-area: user;
            }

            .dashboard-nav {
                grid-area: nav;
                width: 100%;
                justify-content: flex-start;
                overflow-x: auto;
                padding-bottom: 4px;
            }
        }

        @@media (max-width: 640px) {
            .dashboard-brand-title {
                display: none;
            }

            .dashboard-user summary span {
                display: none;
            }

            .dashboard-user summary {
                width: 46px;
                padding: 0;
                justify-content: center;
            }
        }

        @@media (max-width: 1050px) {
            .top-header {
                align-items: flex-start;
                flex-direction: column;
                height: auto;
                padding: 12px 16px;
            }

            .main-navbar {
                width: 100%;
                margin-left: 0;
                justify-content: flex-start;
                overflow-x: auto;
                padding-bottom: 4px;
            }

            .main-navbar a,
            .main-navbar summary {
                flex: 0 0 auto;
            }

            .navbar-inner {
                align-items: center;
                flex-direction: row;
                gap: 10px;
            }

            .brand {
                white-space: normal;
            }

            .menu {
                width: 100%;
                justify-content: flex-end;
                padding-bottom: 4px;
            }
        }

        @@media (max-width: 900px) {
            .footer-inner {
                grid-template-columns: 1fr;
            }

            .footer-bottom {
                text-align: left;
            }

            .page {
                padding: 16px;
            }

            th,
            td {
                padding: 10px 8px;
            }

            .list-page-head,
            .schedule-group-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .list-page-head h2 {
                font-size: 26px;
            }

            .list-page-head p {
                font-size: 17px;
            }

            .list-toolbar {
                grid-template-columns: 1fr;
            }

            .handbook-feature-card,
            .handbook-grid {
                grid-template-columns: 1fr;
            }

            .handbook-feature-card {
                min-height: 0;
            }

            .handbook-feature-visual {
                min-height: 190px;
            }

            .handbook-feature-body {
                padding: 22px;
            }

            .handbook-feature-body h3 {
                font-size: 24px;
            }

            .handbook-card {
                min-height: 0;
            }

            .schedule-item {
                grid-template-columns: 1fr;
                align-items: start;
            }

            .list-card {
                overflow-x: auto;
            }

            .list-table {
                min-width: 720px;
            }

            .schedule-date,
            .schedule-item .status-badge,
            .schedule-item .btn {
                justify-self: start;
            }

            .item-meta {
                white-space: normal;
            }

        }
    </style>
    <link rel="stylesheet" href="/css/ui-polish.css?v=1" />
</head>
<body>
    <header class="dashboard-topbar">
        <div class="dashboard-topbar-inner">
            <a class="dashboard-brand" href="/NguoiDung/Index" aria-label="Pharmacy City">
                <img class="dashboard-brand-logo" src="/images/logo/pharmacy-logo.png" alt="Pharmacy City" />
                <span class="dashboard-brand-title">Quản lý sức khỏe và lịch tiêm chủng Pharmacy City</span>
            </a>

            <nav class="dashboard-nav" aria-label="Menu chức năng">
                <a class="dashboard-nav-link @Active("NguoiDung", "Index")" href="/NguoiDung/Index"><i class="bi bi-house-door-fill"></i><span>Trang chủ</span></a>
                <a class="dashboard-nav-link @Active("HoSoSucKhoe")" href="/HoSoSucKhoe/Index"><i class="bi bi-person-vcard"></i><span>Hồ sơ</span></a>
                <a class="dashboard-nav-link @Active("LichTiem")" href="/LichTiem/ChonHoSo"><i class="bi bi-calendar2-check"></i><span>Lịch tiêm</span></a>
                <a class="dashboard-nav-link @Active("LichSuTiem")" href="/LichSuTiem/ChonHoSo"><i class="bi bi-clock-history"></i><span>Lịch sử</span></a>
                <a class="dashboard-nav-link @Active("vaccine")" href="/vaccine/TraCuu"><i class="bi bi-shield-check"></i><span>Vaccine</span></a>
                <a class="dashboard-nav-link @Active("ThongBao")" href="/ThongBao/Index"><i class="bi bi-bell"></i><span>Thông báo</span><span class="nav-badge">@thongBaoChuaDoc</span></a>
                <a class="dashboard-nav-link @Active("BaiVietCamNang")" href="/BaiVietCamNang/Index"><i class="bi bi-book"></i><span>Kiến thức</span></a>
                <a class="dashboard-nav-link @Active("CauHoiTuVan")" href="/CauHoiTuVan/Index"><i class="bi bi-chat-dots"></i><span>Tư vấn</span></a>
            </nav>

            @if (maTaiKhoanDangNhap.HasValue)
            {
                <details class="dashboard-user account-menu">
                    <summary><i class="bi bi-person-circle"></i><span>@tenTaiKhoanHienThi</span><i class="bi bi-chevron-down"></i></summary>
                    <div class="account-dropdown">
                        <a href="/TaiKhoan/ThongTinCaNhan">Thông tin cá nhân</a>
                        <a href="/TaiKhoan/DangXuat">Đăng xuất</a>
                    </div>
                </details>
            }
            else
            {
                <a class="dashboard-login-link" href="/TaiKhoan/DangNhap">Đăng nhập</a>
            }
        </div>
    </header>

    <main class="page">
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <section>
                <img class="footer-logo" src="/images/logo/pharmacy-logo.png" alt="Pharmacy City" />
                <h3>Quản lý sức khỏe và lịch tiêm chủng</h3>
                <p>Theo dõi hồ sơ, lịch tiêm và nhắc lịch cho người dùng.</p>
            </section>
            <section>
                <h4>Chức năng</h4>
                <div class="footer-links">
                    <a href="/HoSoSucKhoe/Index">Hồ sơ sức khỏe</a>
                    <a href="/LichTiem/ChonHoSo">Lịch tiêm</a>
                    <a href="/LichSuTiem/ChonHoSo">Lịch sử tiêm</a>
                    <a href="/vaccine/TraCuu">Vaccine</a>
                    <a href="/ThongBao/Index">Thông báo</a>
                </div>
            </section>
            <section>
                <h4>Thông tin</h4>
                <div class="footer-links">
                    <a href="/Home/Index">Giới thiệu hệ thống</a>
                    <a href="/BaiVietCamNang/Index">Kiến thức tiêm chủng</a>
                    <a href="/Home/ChucNang">Hướng dẫn sử dụng</a>
                    <a href="/Home/Privacy">Chính sách bảo mật</a>
                </div>
                <div class="footer-socials" aria-label="Mạng xã hội">
                    <button type="button">Facebook</button>
                    <button type="button">Zalo</button>
                    <button type="button">Youtube</button>
                </div>
            </section>
        </div>
        <div class="footer-bottom">© 2026 Pharmacy City – Hệ thống quản lý sức khỏe và lịch tiêm chủng</div>
    </footer>
    <script>
        (() => {
            const accountMenus = document.querySelectorAll(".account-menu");
            if (!accountMenus.length) return;

            document.addEventListener("click", (event) => {
                accountMenus.forEach((accountMenu) => {
                    if (!accountMenu.contains(event.target)) {
                        accountMenu.open = false;
                    }
                });
            });

            document.addEventListener("keydown", (event) => {
                if (event.key !== "Escape") return;

                accountMenus.forEach((accountMenu) => {
                    accountMenu.open = false;
                });
            });
        })();
    </script>
    <script src="/js/push-notification.js?v=6"></script>
</body>
</html>

