@inject DoAnTotNghiep.DAL.ThongBao_DAL ThongBaoDal
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var maTaiKhoanDangNhap = Context.Session.GetInt32("MaTaiKhoan");
    var laUserDangNhap = string.Equals(Context.Session.GetString("VaiTro"), "User", StringComparison.OrdinalIgnoreCase);
    var thongBaoChuaDoc = ViewBag.SoThongBaoChuaDoc is int soThongBao ? soThongBao : 0;
    var danhSachThongBaoNoi = new List<DoAnTotNghiep.Models.ThongBao>();
    var duLieuThongBaoNoi = "[]";

    if (ViewBag.SoThongBaoChuaDoc is not int && maTaiKhoanDangNhap.HasValue && laUserDangNhap)
    {
        // Layout cũng cập nhật số thông báo để các trang dùng _UserLayout không bị hiển thị Thông báo (0) sai.
        ThongBaoDal.TaoThongBaoLichTiemDenHan(maTaiKhoanDangNhap.Value);
        thongBaoChuaDoc = ThongBaoDal.DemThongBaoChuaDoc(maTaiKhoanDangNhap.Value);
    }

    if (maTaiKhoanDangNhap.HasValue && laUserDangNhap && thongBaoChuaDoc > 0)
    {
        danhSachThongBaoNoi = ThongBaoDal.LayThongBaoChuaDocMoiNhat(maTaiKhoanDangNhap.Value, 3);
        duLieuThongBaoNoi = System.Text.Json.JsonSerializer.Serialize(danhSachThongBaoNoi.Select(thongBao => new
        {
            id = thongBao.MaThongBao,
            title = thongBao.TieuDe,
            body = RutGonThongBao(thongBao.NoiDung),
            url = Url.Action("Details", "ThongBao", new { maThongBao = thongBao.MaThongBao }) ?? "/ThongBao/Index",
            sentAt = thongBao.NgayGui.ToString("yyyy-MM-dd HH:mm")
        }));
    }

    string RutGonThongBao(string noiDung, int doDai = 90)
    {
        if (string.IsNullOrWhiteSpace(noiDung))
        {
            return string.Empty;
        }

        var giaTri = noiDung.Trim()
            .Replace("Hồ sơ ", "")
            .Replace("vaccine ", "")
            .Replace("Vui lòng ", "")
            .Replace("Ngoài ra, hồ sơ này còn có các mũi tiêm khác đang đến hạn. Vui lòng kiểm tra trong mục Lịch tiêm.", "");

        var viTriChiTiet = giaTri.IndexOf("Khoảng cách", StringComparison.OrdinalIgnoreCase);
        if (viTriChiTiet >= 0)
        {
            giaTri = giaTri[..viTriChiTiet].Trim();
        }

        viTriChiTiet = giaTri.IndexOf("nhóm Vaccine", StringComparison.OrdinalIgnoreCase);
        if (viTriChiTiet >= 0)
        {
            var dauChamSauNhom = giaTri.IndexOf(". ", viTriChiTiet, StringComparison.OrdinalIgnoreCase);
            if (dauChamSauNhom > viTriChiTiet)
            {
                giaTri = giaTri.Remove(viTriChiTiet, dauChamSauNhom - viTriChiTiet + 2).Trim();
            }
        }

        return giaTri.Length <= doDai ? giaTri : giaTri[..doDai].TrimEnd() + "...";
    }

    string Active(string tenController, string? tenAction = null)
    {
        var dungController = string.Equals(controller, tenController, StringComparison.OrdinalIgnoreCase);
        var dungAction = tenAction == null || string.Equals(action, tenAction, StringComparison.OrdinalIgnoreCase);
        return dungController && dungAction ? "active" : "";
    }
}

