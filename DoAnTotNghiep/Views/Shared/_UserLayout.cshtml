        .schedule-title span,
        .item-meta {
            color: #6b7280;
        }

        .item-meta {
            margin-top: 4px;
            font-size: 14px;
            line-height: 1.35;
            max-width: 520px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .schedule-date {
            color: #111827;
            font-weight: 800;
            white-space: nowrap;
        }

        .status-badge {
            display: inline-flex;
            justify-content: center;
            min-width: 82px;
            padding: 5px 10px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
        }

        .status-ok {
            color: #166534;
            background: #dcfce7;
        }

        .status-info {
            color: #15803d;
            background: #dcfce7;
        }

        .status-warning {
            color: #92400e;
            background: #fef3c7;
        }

        .status-danger {
            color: #b91c1c;
            background: #fee2e2;
        }

        .status-muted {
            color: #475569;
            background: #e2e8f0;
        }

        .status-advice {
            color: #a16207;
            background: #fef3c7;
        }

        .empty-state {
            padding: 20px;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            color: #64748b;
            background: #ffffff;
            font-weight: 700;
        }

        .text-truncate-cell {
            max-width: 320px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        hr {
            border: 0;
            border-top: 1px solid #e5e7eb;
            margin: 16px 0;
        }

        dl {
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: 10px 16px;
        }

        dt {
            color: #374151;
            font-weight: 700;
        }

        dd {
            margin: 0;
            color: #1f2937;
        }

        @@media (max-width: 1050px) {
            .navbar-inner {
                align-items: center;
                flex-direction: row;
                gap: 10px;
            }

            .brand {
                white-space: normal;
            }

            .menu {
                width: 100%;
                justify-content: flex-end;
                padding-bottom: 4px;
            }
        }

        @@media (max-width: 900px) {
            .page {
                padding: 16px;
            }

            th,
            td {
                padding: 10px 8px;
            }

            .list-page-head,
            .schedule-group-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .list-page-head h2 {
                font-size: 26px;
            }

            .list-page-head p {
                font-size: 17px;
            }

            .list-toolbar {
                grid-template-columns: 1fr;
            }

            .handbook-feature-card,
            .handbook-grid {
                grid-template-columns: 1fr;
            }

            .handbook-feature-card {
                min-height: 0;
            }

            .handbook-feature-visual {
                min-height: 190px;
            }

            .handbook-feature-body {
                padding: 22px;
            }

            .handbook-feature-body h3 {
                font-size: 24px;
            }

            .handbook-card {
                min-height: 0;
            }

            .schedule-item {
                grid-template-columns: 1fr;
                align-items: start;
            }

            .list-card {
                overflow-x: auto;
            }

            .list-table {
                min-width: 720px;
            }

            .schedule-date,
            .schedule-item .status-badge,
            .schedule-item .btn {
                justify-self: start;
            }

            .item-meta {
                white-space: normal;
            }

        }
    </style>
    <link rel="stylesheet" href="/css/ui-polish.css?v=1" />
</head>
<body>
    <header class="navbar">
        <div class="navbar-inner">
            <span class="brand">Quản lý sức khỏe và lịch tiêm chủng</span>
            <nav class="menu">
                <a class="@Active("NguoiDung", "Index")" href="/NguoiDung/Index">Trang chủ</a>
                <a class="@Active("HoSoSucKhoe")" href="/HoSoSucKhoe/Index">Hồ sơ</a>
                <a class="@Active("LichTiem")" href="/LichTiem/ChonHoSo">Lịch tiêm</a>
                <a class="@Active("LichSuTiem")" href="/LichSuTiem/ChonHoSo">Lịch sử</a>
                <a class="@Active("vaccine")" href="/vaccine/TraCuu">Vaccine</a>
                <a class="@Active("ThongBao")" href="/ThongBao/Index">Thông báo (@thongBaoChuaDoc)</a>
                <a class="@Active("BaiVietCamNang")" href="/BaiVietCamNang/Index">Kiến thức</a>
                <a class="@Active("CauHoiTuVan")" href="/CauHoiTuVan/Index">Tư vấn</a>
                @if (maTaiKhoanDangNhap.HasValue)
                {
                    <details class="account-menu">
                        <summary>@tenTaiKhoanHienThi</summary>
                        <div class="account-dropdown">
                            <a href="/TaiKhoan/ThongTinCaNhan">Thông tin cá nhân</a>
                            <a href="/TaiKhoan/DangXuat">Đăng xuất</a>
                        </div>
                    </details>
                }
                else
                {
                    <a href="/TaiKhoan/DangNhap">Đăng nhập</a>
                }
            </nav>
        </div>
    </header>

    <main class="page">
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <footer class="footer">
        Hệ thống quản lý sức khỏe và lịch tiêm chủng
    </footer>
    <script>
        (() => {
            const accountMenus = document.querySelectorAll(".account-menu");
            if (!accountMenus.length) return;

            document.addEventListener("click", (event) => {
                accountMenus.forEach((accountMenu) => {
                    if (!accountMenu.contains(event.target)) {
                        accountMenu.open = false;
                    }
                });
            });

            document.addEventListener("keydown", (event) => {
                if (event.key !== "Escape") return;

                accountMenus.forEach((accountMenu) => {
                    accountMenu.open = false;
                });
            });
        })();
    </script>
    <script src="/js/push-notification.js?v=6"></script>
</body>
</html>
