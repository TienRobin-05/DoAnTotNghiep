            background: #ffffff;
        }

        .compact-filter .btn {
            border-color: transparent;
            color: #374151;
            background: transparent;
        }

        .compact-filter .btn.active {
            color: #ffffff;
            background: #0b63ce;
            border-color: #0b63ce;
        }

        .schedule-list {
            display: grid;
            gap: 14px;
        }

