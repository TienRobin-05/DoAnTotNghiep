            display: -webkit-box;
            min-height: 78px;
            overflow: hidden;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }

        .handbook-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 14px;
            margin-top: auto;
            color: #64748b;
            font-size: 14px;
            font-weight: 650;
