@inject DoAnTotNghiep.DAL.ThongBao_DAL ThongBaoDal
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var maTaiKhoanDangNhap = Context.Session.GetInt32("MaTaiKhoan");
    var hoTenDangNhap = Context.Session.GetString("HoTen");
    var soDienThoaiDangNhap = Context.Session.GetString("SoDienThoai");
    var emailDangNhap = Context.Session.GetString("Email");
    var laUserDangNhap = string.Equals(Context.Session.GetString("VaiTro"), "User", StringComparison.OrdinalIgnoreCase);
    var tenTaiKhoanHienThi = !string.IsNullOrWhiteSpace(hoTenDangNhap)
        ? hoTenDangNhap
        : (!string.IsNullOrWhiteSpace(soDienThoaiDangNhap) ? soDienThoaiDangNhap : emailDangNhap);
    tenTaiKhoanHienThi = string.IsNullOrWhiteSpace(tenTaiKhoanHienThi) ? "Tài khoản" : tenTaiKhoanHienThi;
    var thongBaoChuaDoc = ViewBag.SoThongBaoChuaDoc is int soThongBao ? soThongBao : 0;

    if (ViewBag.SoThongBaoChuaDoc is not int && maTaiKhoanDangNhap.HasValue && laUserDangNhap)
    {
        // Layout cũng cập nhật số thông báo để các trang dùng _UserLayout không bị hiển thị Thông báo (0) sai.
        ThongBaoDal.TaoThongBaoLichTiemDenHan(maTaiKhoanDangNhap.Value);
        thongBaoChuaDoc = ThongBaoDal.DemThongBaoChuaDoc(maTaiKhoanDangNhap.Value);
    }

    string Active(string tenController, string? tenAction = null)
    {
        var dungController = string.Equals(controller, tenController, StringComparison.OrdinalIgnoreCase);
        var dungAction = tenAction == null || string.Equals(action, tenAction, StringComparison.OrdinalIgnoreCase);
        return dungController && dungAction ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Quản lý sức khỏe và lịch tiêm chủng</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: #1f2937;
            background: #f4f7fb;
        }

        a {
            text-decoration: none;
        }

        .navbar {
            background: #0b63ce;
            color: #ffffff;
            box-shadow: 0 2px 10px rgba(15, 42, 77, 0.12);
        }

        .navbar-inner {
            max-width: 1380px;
            margin: 0 auto;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .brand {
            color: #ffffff;
            font-size: 20px;
            font-weight: 700;
            line-height: 1.3;
            white-space: nowrap;
        }

        .menu {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 4px;
            overflow-x: auto;
        }

        .menu a {
            color: #eef6ff;
            padding: 9px 12px;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 600;
            white-space: nowrap;
        }

        .menu a:hover {
            background: rgba(255, 255, 255, 0.14);
        }

        .menu a.active {
            color: #0b63ce;
            background: #ffffff;
        }

        .menu .account-menu {
            position: relative;
            flex: 0 0 auto;
        }

        .menu .account-menu summary {
            display: inline-flex;
            align-items: center;
            max-width: 220px;
            overflow: hidden;
            padding: 9px 12px;
            border-radius: 6px;
            color: #0b63ce;
            background: #ffffff;
            cursor: pointer;
            font-size: 15px;
            font-weight: 700;
            list-style: none;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .menu .account-menu summary::-webkit-details-marker {
            display: none;
        }

        .menu .account-menu summary::after {
            content: "▾";
            margin-left: 8px;
            color: #0b63ce;
            font-size: 12px;
        }

        .menu .account-dropdown {
            position: fixed;
            top: var(--account-menu-top, 64px);
            left: var(--account-menu-left, 16px);
            z-index: 50;
            display: grid;
            min-width: 220px;
            padding: 8px;
            border-radius: 8px;
            background: #ffffff;
            box-shadow: 0 16px 36px rgba(15, 23, 42, 0.18);
        }

        .menu .account-dropdown a {
            color: #1f2937;
            background: transparent;
            border-radius: 6px;
            padding: 10px 12px;
        }

        .menu .account-dropdown a:hover {
            color: #0b63ce;
            background: #eef6ff;
        }

        .page {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px;
        }

        .card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .btn {
            display: inline-block;
            padding: 9px 14px;
            border-radius: 6px;
            border: 1px solid #0b63ce;
            color: #0b63ce;
            background: #ffffff;
            font-weight: 700;
        }

        .btn-primary {
            color: #ffffff;
            background: #0b63ce;
        }

        .btn-danger {
            color: #ffffff;
            background: #dc2626;
            border-color: #dc2626;
        }

        .btn-secondary {
            color: #374151;
            background: #ffffff;
            border-color: #9ca3af;
        }

        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .section-title {
            margin: 0;
            font-size: 22px;
            color: #111827;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 12px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }

        th {
            background: #f9fafb;
        }

        .empty {
            color: #6b7280;
            padding: 18px 0;
        }

        .footer {
            margin-top: 30px;
            padding: 18px 24px;
            background: #ffffff;
            border-top: 1px solid #e5e7eb;
            color: #6b7280;
            text-align: center;
        }

        .d-flex {
            display: flex;
        }

        .justify-content-between {
            justify-content: space-between;
        }

        .align-items-center {
            align-items: center;
        }

        .mb-3 {
            margin-bottom: 16px;
        }

        .mt-3 {
            margin-top: 16px;
        }

        .p-3 {
            padding: 16px;
        }

        .border {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .d-inline {
            display: inline;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
        }

        .table-bordered {
            border: 1px solid #e5e7eb;
        }

        .table-striped tbody tr:nth-child(even) {
            background: #f9fafb;
        }

        .btn-sm {
            padding: 6px 10px;
            font-size: 14px;
        }

        .btn-link {
            border: 0;
            background: transparent;
            color: #0b63ce;
        }

        .btn-outline-primary,
        .btn-outline-secondary,
        .btn-outline-info,
        .btn-outline-warning {
            color: #0b63ce;
            background: #ffffff;
            border-color: #0b63ce;
        }

        .btn-outline-danger {
            color: #dc2626;
            background: #ffffff;
            border-color: #dc2626;
        }

        .alert {
            padding: 14px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
        }

        .alert-info {
            color: #0b4f9c;
            background: #eaf4ff;
            border: 1px solid #bfdbfe;
        }

        .text-muted {
            color: #6b7280;
        }

        .page > .d-flex.justify-content-between.align-items-center.mb-3 {
            max-width: 860px;
            margin: 0 auto;
            padding: 20px 20px 0;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-bottom: 0;
            border-radius: 8px 8px 0 0;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .page > .d-flex.justify-content-between.align-items-center.mb-3 h2 {
            margin-bottom: 16px;
        }

        .page > .d-flex.justify-content-between.align-items-center.mb-3 + .card {
            border-top: 0;
            border-radius: 0 0 8px 8px;
            box-shadow: 0 8px 14px rgba(0, 0, 0, 0.04);
        }

        h1,
        h2 {
            margin-top: 0;
            margin-bottom: 16px;
            color: #111827;
        }

        h2 {
            font-size: 24px;
        }

        p {
            line-height: 1.6;
        }

        .page > form,
        .page > dl,
        .page > .card {
            max-width: 860px;
            margin-left: auto;
            margin-right: auto;
        }

        .page > form,
        .page > dl {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            color: #374151;
            font-weight: 700;
        }

        .form-control,
        .form-select {
            width: 100%;
            min-height: 42px;
            padding: 9px 11px;
            border: 1px solid #cfd8e6;
            border-radius: 6px;
            color: #1f2937;
            background: #ffffff;
            font-family: inherit;
            font-size: 15px;
        }

        textarea.form-control {
            min-height: 110px;
            resize: vertical;
        }

        .form-control:focus,
        .form-select:focus {
            outline: 0;
            border-color: #0b63ce;
            box-shadow: 0 0 0 3px rgba(11, 99, 206, 0.12);
        }

        .form-control[readonly] {
            color: #6b7280;
            background: #f9fafb;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            gap: 0 16px;
        }

        .col-md-3,
        .col-md-4,
        .col-md-6,
        .col-md-7,
        .col-md-8 {
            width: 100%;
        }

        @@media (min-width: 768px) {
            .col-md-3 {
                flex: 0 0 calc(25% - 12px);
                max-width: calc(25% - 12px);
            }

            .col-md-4 {
                flex: 0 0 calc(33.333% - 11px);
                max-width: calc(33.333% - 11px);
            }

            .col-md-6 {
                flex: 0 0 calc(50% - 8px);
                max-width: calc(50% - 8px);
            }

            .col-md-7 {
                max-width: 720px;
            }

            .col-md-8 {
                max-width: 860px;
            }
        }

        .card-body {
            padding: 0;
        }

        .alert-danger {
            color: #842029;
            background: #f8d7da;
            border: 1px solid #f5c2c7;
        }

        .alert-success {
            color: #146c43;
            background: #d1e7dd;
            border: 1px solid #badbcc;
        }

        .alert-warning {
            color: #8a5a00;
            background: #fff3cd;
            border: 1px solid #ffecb5;
        }

        .text-danger {
            color: #dc2626;
        }

        .detail-card {
            max-width: 860px;
            margin-left: auto;
            margin-right: auto;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
        }

        .detail-card p:first-child {
            margin-top: 0;
        }

        .article-content {
            max-width: 860px;
            margin-left: auto;
            margin-right: auto;
            white-space: pre-wrap;
            line-height: 1.7;
        }

        .list-page-head,
        .compact-filter,
        .schedule-list,
        .empty-state {
            max-width: 980px;
            margin-left: auto;
            margin-right: auto;
        }

        .list-page-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 12px;
            padding: 14px 16px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .list-page-head h2 {
            margin: 0;
            color: #111827;
            font-size: 24px;
            font-weight: 800;
        }

        .list-page-head p {
            margin: 6px 0 0;
            color: #6b7280;
            line-height: 1.4;
        }

        .compact-filter {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
            padding: 6px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .compact-filter .btn {
            border-color: transparent;
            color: #374151;
            background: transparent;
        }

        .compact-filter .btn.active {
            color: #ffffff;
            background: #0b63ce;
            border-color: #0b63ce;
        }

        .schedule-list {
            display: grid;
            gap: 14px;
        }

        .schedule-group {
            overflow: hidden;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .schedule-group-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 14px 16px;
            border-bottom: 1px solid #eef2f7;
            background: #f8fafc;
        }

        .schedule-group-head h3 {
            margin: 0;
            color: #111827;
            font-size: 19px;
            font-weight: 800;
        }

        .schedule-group-head span {
            display: inline-block;
            margin-top: 5px;
            color: #6b7280;
            font-size: 14px;
        }

        .schedule-group-head strong {
            padding: 5px 10px;
            border-radius: 999px;
            color: #0b63ce;
            background: #eaf4ff;
            white-space: nowrap;
        }

        .schedule-rows {
            display: grid;
        }

        .schedule-item {
            display: grid;
            grid-template-columns: minmax(240px, 1fr) 110px 92px auto;
            gap: 12px;
            align-items: center;
            padding: 12px 16px;
            border-bottom: 1px solid #eef2f7;
        }

        .schedule-item:last-child {
            border-bottom: 0;
        }

        .schedule-title {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .schedule-title strong {
            color: #111827;
        }

        .schedule-title span,
        .item-meta {
            color: #6b7280;
        }

        .item-meta {
            margin-top: 4px;
            font-size: 14px;
            line-height: 1.35;
            max-width: 520px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .schedule-date {
            color: #111827;
            font-weight: 800;
            white-space: nowrap;
        }

        .status-badge {
            display: inline-flex;
            justify-content: center;
            min-width: 82px;
            padding: 5px 10px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
        }

        .status-ok {
            color: #166534;
            background: #dcfce7;
        }

        .status-info {
            color: #15803d;
            background: #dcfce7;
        }

        .status-warning {
            color: #92400e;
            background: #fef3c7;
        }

        .status-danger {
            color: #b91c1c;
            background: #fee2e2;
        }

        .status-muted {
            color: #475569;
            background: #e2e8f0;
        }

        .status-advice {
            color: #a16207;
            background: #fef3c7;
        }

        .empty-state {
            padding: 20px;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            color: #64748b;
            background: #ffffff;
            font-weight: 700;
        }

        hr {
            border: 0;
            border-top: 1px solid #e5e7eb;
            margin: 16px 0;
        }

        dl {
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: 10px 16px;
        }

        dt {
            color: #374151;
            font-weight: 700;
        }

        dd {
            margin: 0;
            color: #1f2937;
        }

        @@media (max-width: 1050px) {
            .navbar-inner {
                align-items: flex-start;
                flex-direction: column;
                gap: 10px;
            }

            .brand {
                white-space: normal;
            }

            .menu {
                width: 100%;
                justify-content: flex-start;
                padding-bottom: 4px;
            }
        }

        @@media (max-width: 900px) {
            .page {
                padding: 16px;
            }

            th,
            td {
                padding: 10px 8px;
            }

            .list-page-head,
            .schedule-group-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .schedule-item {
                grid-template-columns: 1fr;
                align-items: start;
            }

            .schedule-date,
            .schedule-item .status-badge,
            .schedule-item .btn {
                justify-self: start;
            }

            .item-meta {
                white-space: normal;
            }

        }
    </style>
</head>
<body>
    <header class="navbar">
        <div class="navbar-inner">
            <a class="brand" href="/NguoiDung/Index">Quản lý sức khỏe và lịch tiêm chủng</a>
            <nav class="menu">
                <a class="@Active("NguoiDung", "Index")" href="/NguoiDung/Index">Trang chủ</a>
                <a class="@Active("HoSoSucKhoe")" href="/HoSoSucKhoe/Index">Hồ sơ</a>
                <a class="@Active("LichTiem")" href="/LichTiem/ChonHoSo">Lịch tiêm</a>
                <a class="@Active("LichSuTiem")" href="/LichSuTiem/ChonHoSo">Lịch sử</a>
                <a class="@Active("vaccine")" href="/vaccine/TraCuu">Vaccine</a>
                <a class="@Active("ThongBao")" href="/ThongBao/Index">Thông báo (@thongBaoChuaDoc)</a>
                <a class="@Active("BaiVietCamNang")" href="/BaiVietCamNang/Index">Cẩm nang</a>
                <a class="@Active("CauHoiTuVan")" href="/CauHoiTuVan/Index">Tư vấn</a>
                @if (maTaiKhoanDangNhap.HasValue)
                {
                    <details class="account-menu">
                        <summary>@tenTaiKhoanHienThi</summary>
                        <div class="account-dropdown">
                            <a href="/TaiKhoan/ThongTinCaNhan">Thông tin cá nhân</a>
                            <a href="/TaiKhoan/DangXuat">Đăng xuất</a>
                        </div>
                    </details>
                }
                else
                {
                    <a href="/TaiKhoan/DangNhap">Đăng nhập</a>
                }
            </nav>
        </div>
    </header>

    <main class="page">
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <footer class="footer">
        Hệ thống quản lý sức khỏe và lịch tiêm chủng
    </footer>
    <script>
        (() => {
            const accountMenu = document.querySelector(".account-menu");
            if (!accountMenu) return;

            const datViTriDropdown = () => {
                const summary = accountMenu.querySelector("summary");
                const dropdown = accountMenu.querySelector(".account-dropdown");
                if (!summary || !dropdown) return;

                const rect = summary.getBoundingClientRect();
                const dropdownWidth = dropdown.offsetWidth || 220;
                const left = Math.max(12, Math.min(rect.right - dropdownWidth, window.innerWidth - dropdownWidth - 12));

                dropdown.style.setProperty("--account-menu-top", `${rect.bottom + 8}px`);
                dropdown.style.setProperty("--account-menu-left", `${left}px`);
            };

            accountMenu.addEventListener("toggle", () => {
                if (accountMenu.open) datViTriDropdown();
            });
            window.addEventListener("resize", () => {
                if (accountMenu.open) datViTriDropdown();
            });
            window.addEventListener("scroll", () => {
                if (accountMenu.open) datViTriDropdown();
            }, true);
        })();
    </script>
</body>
</html>
