        dd {
            margin: 0;
            color: #1f2937;
        }

        @@media (max-width: 1050px) {
            .navbar-inner {
                align-items: flex-start;
                flex-direction: column;
                gap: 10px;
            }

            .brand {
                white-space: normal;
            }

            .menu {
                width: 100%;
                justify-content: flex-start;
                padding-bottom: 4px;
            }
        }

        @@media (max-width: 900px) {
            .page {
                padding: 16px;
            }

            th,
            td {
                padding: 10px 8px;
            }

            .list-page-head,
            .schedule-group-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .schedule-item {
                grid-template-columns: 1fr;
                align-items: start;
            }

            .schedule-date,
            .schedule-item .status-badge,
            .schedule-item .btn {
                justify-self: start;
            }

            .item-meta {
                white-space: normal;
            }

            .floating-notification {
                right: 16px;
                bottom: 16px;
            }
        }
    </style>
</head>
<body>
    <header class="navbar">
        <div class="navbar-inner">
            <a class="brand" href="/NguoiDung/Index">Quản lý sức khỏe và lịch tiêm chủng</a>
            <nav class="menu">
                <a class="@Active("NguoiDung", "Index")" href="/NguoiDung/Index">Trang chủ</a>
                <a class="@Active("HoSoSucKhoe")" href="/HoSoSucKhoe/Index">Hồ sơ</a>
                <a class="@Active("LichTiem")" href="/LichTiem/ChonHoSo">Lịch tiêm</a>
                <a class="@Active("LichSuTiem")" href="/LichSuTiem/ChonHoSo">Lịch sử</a>
                <a class="@Active("vaccine")" href="/vaccine/TraCuu">Vaccine</a>
                <a class="@Active("ThongBao")" href="/ThongBao/Index">Thông báo (@thongBaoChuaDoc)</a>
                <a class="@Active("BaiVietCamNang")" href="/BaiVietCamNang/Index">Cẩm nang</a>
                <a class="@Active("CauHoiTuVan")" href="/CauHoiTuVan/Index">Tư vấn</a>
                <a class="logout-link" href="/TaiKhoan/DangXuat">Đăng xuất</a>
            </nav>
        </div>
    </header>

    @if (danhSachThongBaoNoi.Count > 0)
    {
        <input type="checkbox" id="anThongBaoNoi" class="floating-notification-toggle" />
        <aside class="floating-notification" aria-live="polite">
            <div class="floating-notification-head">
                <strong>Thông báo nhắc lịch</strong>
                <div>
                    <button type="button" class="desktop-notification-button" id="batThongBaoDesktop">Bật đẩy</button>
                    <label for="anThongBaoNoi" class="floating-notification-close" title="Ẩn thông báo">×</label>
                </div>
            </div>
            <div class="floating-notification-body">
                @foreach (var thongBaoNoi in danhSachThongBaoNoi)
                {
                    <article class="floating-notification-item">
                        <h3>@thongBaoNoi.TieuDe</h3>
                        <p>@RutGonThongBao(thongBaoNoi.NoiDung)</p>
                        <div class="floating-notification-actions">
                            <a asp-controller="ThongBao" asp-action="Details" asp-route-maThongBao="@thongBaoNoi.MaThongBao" class="btn btn-primary btn-sm">Xem chi tiết</a>
                            @if (thongBaoNoi.MaLichTiem.HasValue)
                            {
                                <a asp-controller="LichTiem" asp-action="CapNhatDaTiem" asp-route-maLichTiem="@thongBaoNoi.MaLichTiem.Value" class="btn btn-secondary btn-sm">Đã tiêm chưa?</a>
                            }
                        </div>
                    </article>
                }
            </div>
        </aside>
    }

    <main class="page">
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <footer class="footer">
        Hệ thống quản lý sức khỏe và lịch tiêm chủng
    </footer>
    <script>
        (() => {
            const thongBaoNoi = @Html.Raw(duLieuThongBaoNoi);
            const nutBatThongBao = document.getElementById("batThongBaoDesktop");

            if (!("Notification" in window) || thongBaoNoi.length === 0) {
                if (nutBatThongBao) nutBatThongBao.style.display = "none";
                return;
            }

            const khoaDaDay = (thongBao) => `thong-bao-desktop-${thongBao.id}-${thongBao.sentAt}`;

            const dayThongBaoDesktop = () => {
                if (Notification.permission !== "granted") return;

                thongBaoNoi.forEach((thongBao) => {
                    const khoa = khoaDaDay(thongBao);
                    if (localStorage.getItem(khoa)) return;

                    const notification = new Notification(thongBao.title, {
                        body: thongBao.body,
                        tag: `thong-bao-${thongBao.id}`,
                        renotify: false
                    });

                    notification.onclick = () => {
                        window.focus();
                        window.location.href = thongBao.url;
                        notification.close();
                    };

                    localStorage.setItem(khoa, "1");
                });
            };

            if (Notification.permission === "granted") {
                if (nutBatThongBao) nutBatThongBao.style.display = "none";
                dayThongBaoDesktop();
            } else if (Notification.permission === "denied") {
                if (nutBatThongBao) nutBatThongBao.textContent = "Đã chặn";
            }

            nutBatThongBao?.addEventListener("click", async () => {
                const quyen = await Notification.requestPermission();
                if (quyen === "granted") {
                    nutBatThongBao.style.display = "none";
                    dayThongBaoDesktop();
                } else if (quyen === "denied") {
                    nutBatThongBao.textContent = "Đã chặn";
                }
            });
        })();
    </script>
</body>
</html>
