                linear-gradient(135deg, #0369a1, #14b8a6 58%, #facc15);
        }

        .guide-card-care {
            background:
                radial-gradient(circle at 28% 28%, rgba(255, 255, 255, 0.74) 0 12%, transparent 13%),
                radial-gradient(circle at 78% 70%, rgba(34, 197, 94, 0.42) 0 20%, transparent 21%),
                linear-gradient(135deg, #166534, #22c55e 52%, #86efac);
        }

        .guide-card-family {
            background:
                radial-gradient(circle at 72% 32%, rgba(255, 255, 255, 0.72) 0 12%, transparent 13%),
                radial-gradient(circle at 24% 74%, rgba(251, 146, 60, 0.45) 0 18%, transparent 19%),
                linear-gradient(135deg, #b45309, #f97316 48%, #38bdf8);
        }

        .guide-card-doctor {
            background:
                radial-gradient(circle at 26% 34%, rgba(255, 255, 255, 0.78) 0 11%, transparent 12%),
                radial-gradient(circle at 78% 70%, rgba(125, 211, 252, 0.5) 0 18%, transparent 19%),
                linear-gradient(135deg, #1e40af, #38bdf8 56%, #a7f3d0);
        }

        .handbook-feature-body,
        .handbook-card-body {
            display: flex;
            min-width: 0;
            flex-direction: column;
            gap: 10px;
            padding: 22px;
        }

        .handbook-feature-body {
            justify-content: center;
            padding: 30px;
        }

        .handbook-topic {
            width: fit-content;
            max-width: 100%;
            padding: 6px 10px;
            border-radius: 999px;
            color: #0f766e;
            background: #ccfbf1;
            font-size: 12px;
            font-weight: 850;
            text-transform: uppercase;
        }

        .handbook-feature-body h3,
        .handbook-card-body h3 {
            margin: 0;
            color: #111827;
            font-weight: 850;
            line-height: 1.25;
        }

        .handbook-feature-body h3 {
            font-size: 28px;
        }

        .handbook-card-body h3 {
            display: -webkit-box;
            min-height: 56px;
            overflow: hidden;
            font-size: 20px;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }

        .handbook-feature-body p,
        .handbook-card-body p {
            margin: 0;
            color: #4b5563;
            line-height: 1.65;
        }

