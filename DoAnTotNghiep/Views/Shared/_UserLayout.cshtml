            width: fit-content;
            margin-top: 4px;
            padding: 9px 14px;
            border-radius: 8px;
            color: #ffffff;
            background: #0b63ce;
            font-weight: 800;
        }

        .handbook-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
        }

        .handbook-card {
            display: grid;
            grid-template-rows: 150px minmax(0, 1fr);
            min-height: 410px;
        }

        .list-toolbar {
            display: grid;
            grid-template-columns: minmax(220px, 1fr) auto auto;
            gap: 10px;
            align-items: center;
            max-width: 980px;
            margin: 0 auto 16px;
            padding: 14px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
        }

        .compact-filter {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
