            background: #e0f2fe;
            font-size: 15px;
            font-weight: 800;
            white-space: nowrap;
        }

        .handbook-news {
            display: grid;
            gap: 18px;
            max-width: 980px;
            margin: 0 auto;
        }

        .handbook-feature-card,
        .handbook-card {
            overflow: hidden;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #ffffff;
            color: inherit;
            text-decoration: none;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.07);
            transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        }

        .handbook-feature-card:hover,
        .handbook-card:hover {
            color: inherit;
            border-color: #bae6fd;
            transform: translateY(-2px);
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.11);
        }

        .handbook-feature-card {
            display: grid;
            grid-template-columns: minmax(260px, 0.95fr) minmax(0, 1.25fr);
            min-height: 310px;
        }

        .handbook-feature-visual,
        .handbook-card-visual {
            position: relative;
            display: flex;
            align-items: flex-end;
            min-height: 100%;
            padding: 18px;
            color: #ffffff;
            isolation: isolate;
        }

        .handbook-feature-visual::after,
        .handbook-card-visual::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.05), rgba(15, 23, 42, 0.46));
        }

        .handbook-feature-visual span,
        .handbook-card-visual span {
            display: inline-flex;
            align-items: center;
            min-height: 34px;
            padding: 7px 12px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.9);
            color: #0f172a;
            font-size: 13px;
            font-weight: 800;
        }

        .guide-card-vaccine {
            background:
                radial-gradient(circle at 72% 24%, rgba(255, 255, 255, 0.72) 0 10%, transparent 11%),
