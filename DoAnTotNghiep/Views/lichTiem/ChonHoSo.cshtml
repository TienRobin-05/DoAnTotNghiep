@* Khu vực giao diện của view ChonHoSo.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<HoSoSucKhoe>
@{
    ViewData["Title"] = "Chọn hồ sơ xem lịch tiêm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Chọn hồ sơ xem lịch tiêm</h2>
    <a asp-controller="HoSoSucKhoe" asp-action="Create" class="btn btn-primary">Thêm hồ sơ</a>
</div>

@if (TempData["ThongBao"] != null)
{
    var loaiThongBao = TempData["LoaiThongBao"]?.ToString() ?? "success";
    <div class="alert alert-@loaiThongBao">@TempData["ThongBao"]</div>
}

@* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
@if (Model.Count == 0)
{
    @* Khu vực thông báo phản hồi kết quả xử lý, ví dụ thành công, lỗi nhập liệu hoặc lỗi nghiệp vụ. *@
    <div class="alert alert-info">
        Bạn chưa có hồ sơ sức khỏe. Vui lòng tạo hồ sơ trước khi xem lịch tiêm.
    </div>
}
else
{
    <section class="card">
    @* Khu vực bảng dùng để hiển thị danh sách dữ liệu theo từng cột, giúp người dùng dễ theo dõi và thao tác. *@
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Giới tính</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.HoTen</td>
                <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                <td>@item.GioiTinh</td>
                <td>
                    <a asp-action="Index" asp-route-maHoSo="@item.MaHoSo" class="btn btn-sm btn-primary">Xem lịch tiêm</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </section>
}
