@* Khu vực giao diện của view lichSu.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<lichSuTiemModels>
@{
    ViewData["Title"] = "Lịch sử tiêm";
}

<div class="list-page-head">
    <div>
        <h2>Lịch sử tiêm</h2>
        <p>@Model.Count mũi tiêm đã được ghi nhận</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">Chưa có lịch sử tiêm.</div>
}
else
{
    <section class="list-card">
    @* Khu vực bảng dùng để hiển thị danh sách dữ liệu theo từng cột, giúp người dùng dễ theo dõi và thao tác. *@
    <table class="table list-table">
        <thead><tr><th>Hồ sơ</th><th>Vaccine</th><th>Mũi</th><th>Ngày tiêm</th><th>Ghi chú</th></tr></thead>
        <tbody>
        @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="item-title">@item.tenHoSo</div>
                </td>
                <td>@item.tenVaccine</td>
                <td><span class="soft-badge">@item.tenMui</span></td>
                <td><span class="status-badge status-ok">@item.ngayTiemThucTe.ToString("dd/MM/yyyy")</span></td>
                <td class="text-truncate-cell">@item.ghiChu</td>
            </tr>
        }
        </tbody>
    </table>
    </section>
}
