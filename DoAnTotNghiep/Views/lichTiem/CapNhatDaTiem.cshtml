@* Khu vực giao diện của view CapNhatDaTiem.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model LichTiem
@{
    ViewData["Title"] = "Cập nhật đã tiêm";
    var ngayTiemThucTe = ViewBag.NgayTiemThucTe as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var ghiChu = ViewBag.GhiChu as string ?? string.Empty;
}

<h2>Cập nhật trạng thái đã tiêm</h2>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Hồ sơ:</strong> @Model.HoTenHoSo</p>
        <p><strong>Vaccine:</strong> @Model.TenVaccine</p>
        <p><strong>Mũi tiêm:</strong> @Model.TenMui - Mũi @Model.SoMui</p>
        <p><strong>Ngày tiêm dự kiến:</strong> @Model.NgayTiemDuKien.ToString("dd/MM/yyyy")</p>
        <p><strong>Trạng thái hiện tại:</strong> @Model.TrangThai</p>
    </div>
</div>

@* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
<form asp-action="CapNhatDaTiem" method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <input type="hidden" name="maLichTiem" value="@Model.MaLichTiem" />

    <div class="mb-3">
        <label class="form-label">Ngày tiêm thực tế</label>
        <input name="ngayTiemThucTe" type="date" class="form-control" value="@ngayTiemThucTe" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Ghi chú</label>
        <textarea name="ghiChu" class="form-control" rows="4">@ghiChu</textarea>
    </div>

    <button type="submit" class="btn btn-primary">Lưu cập nhật</button>
    <a asp-action="Index" asp-route-maHoSo="@Model.MaHoSo" class="btn btn-secondary">Quay lại</a>
</form>
