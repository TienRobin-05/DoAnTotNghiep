@model List<LichTiem>
@{
    ViewData["Title"] = "Lịch tiêm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lịch tiêm của @ViewBag.HoTenHoSo</h2>
    <a asp-action="ChonHoSo" class="btn btn-link">Chọn hồ sơ khác</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Hồ sơ này chưa có lịch tiêm.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Tên vaccine</th>
                <th>Tên mũi tiêm</th>
                <th>Số mũi</th>
                <th>Ngày tiêm dự kiến</th>
                <th>Trạng thái</th>
                <th>Ghi chú</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TenVaccine</td>
                <td>@item.TenMui</td>
                <td>@item.SoMui</td>
                <td>@item.NgayTiemDuKien.ToString("dd/MM/yyyy")</td>
                <td>@item.TrangThai</td>
                <td>@item.GhiChu</td>
            </tr>
        }
        </tbody>
    </table>
}
