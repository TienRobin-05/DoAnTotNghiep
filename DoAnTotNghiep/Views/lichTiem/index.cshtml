@* Khu vực giao diện của view Index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<LichTiem>
@{
    ViewData["Title"] = "Lịch tiêm";
    var maHoSo = ViewBag.MaHoSo is int idHoSo ? idHoSo : 0;
    var boLocTrangThai = ViewBag.BoLocTrangThai as string ?? "tat-ca";
    var tongTatCa = ViewBag.TongTatCa is int tatCa ? tatCa : 0;
    var tongSapToi = ViewBag.TongSapToi is int sapToi ? sapToi : 0;
    var tongQuaHan = ViewBag.TongQuaHan is int quaHan ? quaHan : 0;
    var tongDaTiem = ViewBag.TongDaTiem is int daTiem ? daTiem : 0;
    var hienCotThaoTac = Model.Any(item => item.TrangThai != "Đã tiêm");
}

<style>
    .filter-bar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .filter-bar .btn.active {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lịch tiêm của @ViewBag.HoTenHoSo</h2>
    <a asp-action="ChonHoSo" class="btn btn-link">Chọn hồ sơ khác</a>
</div>

@* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
@if (TempData["ThongBao"] != null)
{
    @* Khu vực thông báo phản hồi kết quả xử lý, ví dụ thành công, lỗi nhập liệu hoặc lỗi nghiệp vụ. *@
    var loaiThongBao = TempData["LoaiThongBao"]?.ToString() ?? "success";
    <div class="alert alert-@loaiThongBao">@TempData["ThongBao"]</div>
}

<div class="filter-bar">
    <a asp-action="Index" asp-route-maHoSo="@maHoSo" asp-route-trangThai="tat-ca" class="btn btn-outline-primary @(boLocTrangThai == "tat-ca" ? "active" : "")">
        Tất cả (@tongTatCa)
    </a>
    <a asp-action="Index" asp-route-maHoSo="@maHoSo" asp-route-trangThai="sap-toi" class="btn btn-outline-primary @(boLocTrangThai == "sap-toi" ? "active" : "")">
        Sắp tới (@tongSapToi)
    </a>
    <a asp-action="Index" asp-route-maHoSo="@maHoSo" asp-route-trangThai="qua-han" class="btn btn-outline-primary @(boLocTrangThai == "qua-han" ? "active" : "")">
        Quá hạn (@tongQuaHan)
    </a>
    <a asp-action="Index" asp-route-maHoSo="@maHoSo" asp-route-trangThai="da-tiem" class="btn btn-outline-primary @(boLocTrangThai == "da-tiem" ? "active" : "")">
        Đã tiêm (@tongDaTiem)
    </a>
</div>

@* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
@if (Model.Count == 0)
{
    @* Khu vực thông báo phản hồi kết quả xử lý, ví dụ thành công, lỗi nhập liệu hoặc lỗi nghiệp vụ. *@
    @if (TempData["ThongBao"] == null)
    {
        <div class="alert alert-info">Không có lịch tiêm phù hợp với bộ lọc đang chọn.</div>
    }
}
else
{
    <section class="card">
    @* Khu vực bảng dùng để hiển thị danh sách dữ liệu theo từng cột, giúp người dùng dễ theo dõi và thao tác. *@
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Tên vaccine</th>
                <th>Nhóm vaccine</th>
                <th>Tên mũi tiêm</th>
                <th>Số mũi</th>
                <th>Ngày tiêm dự kiến</th>
                <th>Trạng thái</th>
                <th>Ghi chú</th>
                @if (hienCotThaoTac)
                {
                    <th>Thao tác</th>
                }
            </tr>
        </thead>
        <tbody>
        @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
        @foreach (var item in Model)
        {
            var trangThaiHienThi = item.TrangThai;
            if (item.TrangThai == "Chưa tiêm")
            {
                if (item.NgayTiemDuKien.Date > DateTime.Today)
                {
                    trangThaiHienThi = "Chưa tiêm - Sắp đến lịch";
                }
                else if (item.NgayTiemDuKien.Date == DateTime.Today)
                {
                    trangThaiHienThi = "Chưa tiêm - Đến lịch hôm nay";
                }
                else
                {
                    trangThaiHienThi = "Chưa tiêm - Quá hạn";
                }
            }
            <tr>
                <td>@item.TenVaccine</td>
                <td>@item.NhomVaccine</td>
                <td>@item.TenMui</td>
                <td>@item.SoMui</td>
                <td>@item.NgayTiemDuKien.ToString("dd/MM/yyyy")</td>
                <td>@trangThaiHienThi</td>
                <td>@item.GhiChu</td>
                @if (hienCotThaoTac)
                {
                    <td>
                        @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
                        @if (item.TrangThai != "Đã tiêm")
                        {
                            <a asp-action="CapNhatDaTiem" asp-route-maLichTiem="@item.MaLichTiem" class="btn btn-sm btn-primary">Cập nhật đã tiêm</a>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
    </section>
}
