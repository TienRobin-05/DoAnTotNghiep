@model AdminQuickQuestionIndexViewModel
@{
    ViewData["Title"] = "Quản lý câu hỏi nhanh";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var isVisibleTab = Model.SelectedStatus == "visible";
    var isHiddenTab = Model.SelectedStatus == "hidden";
    var isAllTab = !isVisibleTab && !isHiddenTab;

    string topicColor(string topic)
    {
        var t = (topic ?? "").ToLowerInvariant();
        if (t.Contains("cúm") || t.Contains("flu") || t.Contains("influenza")) return "topic-flu";
        if (t.Contains("lịch") || t.Contains("schedule")) return "topic-schedule";
        if (t.Contains("phế cầu") || t.Contains("pneumococcal")) return "topic-pneumococcal";
        if (t.Contains("hpv")) return "topic-hpv";
        return "topic-default";
    }

    string pageUrl(int p) => Url.Action("Index", new
    {
        keyword = Model.Keyword,
        status = Model.SelectedStatus,
        topic = Model.SelectedTopic,
        sort = Model.SelectedSort,
        page = p,
        pageSize = Model.PageSize
    }) ?? "#";
}

<section class="quick-header-card">
    <div class="quick-header-left">
        <div class="quick-admin-badge">Pharmacy City Admin</div>

        <h1 class="quick-page-title">Quản lý câu hỏi nhanh</h1>

        <p class="quick-page-description">Quản lý các câu hỏi thường gặp và câu trả lời hiển thị cho người dùng.</p>

        <div class="quick-total-line">
            <i class="bi bi-list-check"></i>
            <span>@Model.TotalQuestions câu hỏi nhanh trong danh sách</span>
        </div>
    </div>

    <div class="quick-header-right">
        <div class="quick-stats-row">
            <div class="quick-stat-card quick-stat-blue">
                <div class="quick-stat-icon"><i class="bi bi-question-lg"></i></div>
                <div>
                    <div class="quick-stat-label">Tổng câu hỏi</div>
                    <div class="quick-stat-value">@Model.TotalQuestions</div>
                </div>
            </div>

            <div class="quick-stat-card quick-stat-green">
                <div class="quick-stat-icon"><i class="bi bi-eye"></i></div>
                <div>
                    <div class="quick-stat-label">Đang hiển thị</div>
                    <div class="quick-stat-value">@Model.VisibleQuestions</div>
                </div>
            </div>

            <div class="quick-stat-card quick-stat-orange">
                <div class="quick-stat-icon"><i class="bi bi-eye-slash"></i></div>
                <div>
                    <div class="quick-stat-label">Tạm ẩn</div>
                    <div class="quick-stat-value">@Model.HiddenQuestions</div>
                </div>
            </div>
        </div>

        <a href="@Url.Action("Create")" class="quick-add-btn">
            <i class="bi bi-plus-lg"></i>
            Thêm câu hỏi nhanh
        </a>
    </div>
</section>

<form class="quick-filter-card" method="get" action="@Url.Action("Index")">
    <input type="hidden" name="page" value="1" />
    <input type="text" name="keyword" class="quick-input" placeholder="Tìm kiếm tiêu đề câu hỏi..." value="@Model.Keyword" />

    <select name="status" class="quick-select">
        <option value="">Tất cả trạng thái</option>
        <option value="visible" selected="@(Model.SelectedStatus == "visible")">Đang hiển thị</option>
        <option value="hidden" selected="@(Model.SelectedStatus == "hidden")">Tạm ẩn</option>
    </select>

    <select name="topic" class="quick-select">
        <option value="">Tất cả vaccine</option>
        @foreach (var t in Model.Topics)
        {
            <option value="@t" selected="@(string.Equals(Model.SelectedTopic, t, StringComparison.OrdinalIgnoreCase))">@t</option>
        }
    </select>

    <select name="sort" class="quick-select">
        <option value="newest" selected="@(Model.SelectedSort == "newest" || string.IsNullOrEmpty(Model.SelectedSort))">Mới nhất</option>
        <option value="oldest" selected="@(Model.SelectedSort == "oldest")">Cũ nhất</option>
        <option value="updated" selected="@(Model.SelectedSort == "updated")">Cập nhật gần nhất</option>
        <option value="az" selected="@(Model.SelectedSort == "az")">Tên A-Z</option>
    </select>

    <button type="submit" class="quick-search-btn">
        <i class="bi bi-search"></i>
        Tìm kiếm
    </button>

    <a href="@Url.Action("Index")" class="quick-reset-btn">
        <i class="bi bi-arrow-clockwise"></i>
        Làm mới
    </a>
</form>

<section class="quick-table-card">
    <div class="quick-tabs">
        <a href="@Url.Action("Index", new { keyword = Model.Keyword, topic = Model.SelectedTopic, sort = Model.SelectedSort, pageSize = Model.PageSize })" class="quick-tab @(isAllTab ? "active" : "")">
            Tất cả
            <span class="quick-tab-count">@Model.TotalQuestions</span>
        </a>
        <a href="@Url.Action("Index", new { keyword = Model.Keyword, topic = Model.SelectedTopic, sort = Model.SelectedSort, status = "visible", pageSize = Model.PageSize })" class="quick-tab @(isVisibleTab ? "active" : "")">
            Đang hiển thị
            <span class="quick-tab-count green">@Model.VisibleQuestions</span>
        </a>
        <a href="@Url.Action("Index", new { keyword = Model.Keyword, topic = Model.SelectedTopic, sort = Model.SelectedSort, status = "hidden", pageSize = Model.PageSize })" class="quick-tab @(isHiddenTab ? "active" : "")">
            Tạm ẩn
            <span class="quick-tab-count orange">@Model.HiddenQuestions</span>
        </a>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state" style="margin:24px;">Chưa có câu hỏi nhanh phù hợp.</div>
    }
    else
    {
        <div class="quick-table-responsive">
            <table class="quick-table">
                <thead>
                    <tr>
                        <th>Câu hỏi</th>
                        <th>Chủ đề / Vaccine</th>
                        <th>Trạng thái</th>
                        <th>Ngày cập nhật</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="quick-question-title">@item.Title</div>
                                <div class="quick-question-id">@item.QuestionCode</div>
                            </td>
                            <td>
                                <span class="quick-topic-badge @topicColor(item.TopicName)">
                                    @item.TopicName
                                </span>
                            </td>
                            <td>
                                <span class="quick-status-badge @(item.IsVisible ? "quick-status-visible" : "quick-status-hidden")">
                                    @(item.IsVisible ? "Đang hiển thị" : "Tạm ẩn")
                                </span>
                            </td>
                            <td>
                                <span class="quick-updated-date">@item.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </td>
                            <td>
                                <div class="quick-actions">
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="quick-action-btn" title="Xem">
                                        <i class="bi bi-eye"></i>
                                        Xem
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="quick-action-btn" title="Sửa">
                                        <i class="bi bi-pencil-square"></i>
                                        Sửa
                                    </a>
                                    <form method="post" action="@Url.Action("Toggle", new { id = item.Id, returnUrl = currentUrl })" class="toggle-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="quick-toggle @(item.IsVisible ? "active" : "")" title="Bật/tắt hiển thị"></button>
                                    </form>
                                    <div class="quick-row-menu">
                                        <button type="button" class="quick-menu-btn js-quick-menu-btn" title="Mở menu thao tác">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <div class="quick-dropdown-menu">
                                            <button type="button" class="quick-dropdown-item danger js-open-delete-quick-question"
                                                    data-id="@item.Id"
                                                    data-title="@item.Title">
                                                <i class="bi bi-trash3"></i>
                                                Xóa câu hỏi
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="quick-table-footer">
            <span>
                Hiển thị @Model.StartItem-@Model.EndItem trong tổng số @Model.TotalItems câu hỏi
            </span>

            <div class="quick-pagination-wrap">
                <select class="quick-page-size" onchange="window.location.href='@Url.Action("Index", new { keyword = Model.Keyword, status = Model.SelectedStatus, topic = Model.SelectedTopic, sort = Model.SelectedSort, page = 1, pageSize = "__ps__" })'.replace('__ps__', this.value)">
                    <option value="5" selected="@(Model.PageSize == 5)">5 / trang</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10 / trang</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20 / trang</option>
                </select>

                @if (Model.TotalPages > 1)
                {
                    <nav class="quick-pagination" aria-label="Phân trang">
                        <a href="@pageUrl(Model.Page - 1)" class="quick-page-btn @(Model.Page <= 1 ? "disabled" : "")">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <a href="@pageUrl(p)" class="quick-page-btn @(p == Model.Page ? "active" : "")">@p</a>
                        }
                        <a href="@pageUrl(Model.Page + 1)" class="quick-page-btn @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </nav>
                }
            </div>
        </div>
    }
</section>

<div id="deleteQuickQuestionModal" class="quick-modal-overlay" hidden>
    <div class="quick-confirm-modal">
        <div class="quick-warning-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <h3>Xác nhận xóa câu hỏi</h3>

        <p>
            Bạn có chắc chắn muốn xóa câu hỏi nhanh
            <strong id="deleteQuickQuestionTitle"></strong>?
            Hành động này không thể hoàn tác.
        </p>

        <form id="deleteQuickQuestionForm" method="post" class="no-browser-confirm">
            @Html.AntiForgeryToken()

            <div class="quick-modal-actions">
                <button type="button" class="quick-btn-cancel" id="cancelDeleteQuickQuestion">
                    Hủy bỏ
                </button>

                <button type="submit" class="quick-btn-delete">
                    Xóa câu hỏi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".js-quick-menu-btn").forEach(function (button) {
                button.addEventListener("click", function (event) {
                    event.stopPropagation();

                    var menu = button.closest(".quick-row-menu");

                    document.querySelectorAll(".quick-row-menu.open").forEach(function (openedMenu) {
                        if (openedMenu !== menu) {
                            openedMenu.classList.remove("open");
                        }
                    });

                    menu.classList.toggle("open");
                });
            });

            document.addEventListener("click", function () {
                document.querySelectorAll(".quick-row-menu.open").forEach(function (menu) {
                    menu.classList.remove("open");
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    document.querySelectorAll(".quick-row-menu.open, .quick-modal-overlay:not([hidden])").forEach(function (el) {
                        if (el.classList.contains("quick-row-menu")) {
                            el.classList.remove("open");
                        } else {
                            el.hidden = true;
                        }
                    });
                }
            });

            var deleteModal = document.getElementById("deleteQuickQuestionModal");
            var deleteForm = document.getElementById("deleteQuickQuestionForm");
            var deleteTitle = document.getElementById("deleteQuickQuestionTitle");
            var cancelDeleteBtn = document.getElementById("cancelDeleteQuickQuestion");

            document.querySelectorAll(".js-open-delete-quick-question").forEach(function (button) {
                button.addEventListener("click", function (event) {
                    event.stopPropagation();

                    var id = button.getAttribute("data-id");
                    var title = button.getAttribute("data-title");

                    deleteTitle.textContent = '"' + title + '"';
                    deleteForm.action = '@Url.Action("Delete", "QuickQuestionAdmin")' + '/' + id;

                    document.querySelectorAll(".quick-row-menu.open").forEach(function (menu) {
                        menu.classList.remove("open");
                    });

                    deleteModal.hidden = false;
                });
            });

            cancelDeleteBtn.addEventListener("click", function () {
                deleteModal.hidden = true;
            });

            deleteModal.addEventListener("click", function (event) {
                if (event.target === deleteModal) {
                    deleteModal.hidden = true;
                }
            });
        });
    </script>
}
