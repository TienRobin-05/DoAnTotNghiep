@* Khu vực giao diện của view Details.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model CauHoiTuVan
@{
    ViewData["Title"] = "Chi tiết câu hỏi tư vấn";
}

<h2>Chi tiết câu hỏi tư vấn</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Người gửi:</strong> @Model.TenNguoiGui</p>
        <p><strong>Ngày gửi:</strong> @Model.NgayGui.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Trạng thái:</strong> @Model.TrangThai</p>
        <hr />
        <p><strong>Câu hỏi:</strong></p>
        <p>@Model.CauHoi</p>
        <hr />
        <p><strong>Câu trả lời:</strong></p>
        @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
        @if (string.IsNullOrWhiteSpace(Model.CauTraLoi))
        {
            <p class="text-muted">Chưa có câu trả lời.</p>
        }
        else
        {
            <p>@Model.CauTraLoi</p>
            <p><strong>Người trả lời:</strong> @Model.TenNguoiTraLoi</p>
            <p><strong>Ngày trả lời:</strong> @Model.NgayTraLoi?.ToString("dd/MM/yyyy HH:mm")</p>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Quay lại</a>
