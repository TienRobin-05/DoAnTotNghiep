@* Khu vực giao diện của view Create.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model CauHoiTuVan
@{
    ViewData["Title"] = "Gửi câu hỏi tư vấn";
}

<h2>Gửi câu hỏi tư vấn</h2>

@* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
<form asp-action="Create" method="post" class="col-md-8">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Nội dung câu hỏi</label>
        <textarea name="CauHoi" rows="6" class="form-control">@Model.CauHoi</textarea>
    </div>

    <button type="submit" class="btn btn-primary">Gửi câu hỏi</button>
</form>
