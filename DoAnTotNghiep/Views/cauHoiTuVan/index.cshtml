@model List<CauHoiTuVan>
@{
    ViewData["Title"] = "Tư vấn trực tuyến";
    var laAdmin = ViewBag.LaAdmin is bool admin && admin;
    var keyword = ViewBag.Keyword as string ?? string.Empty;
    var trangThai = ViewBag.TrangThai as string ?? string.Empty;
    var topic = ViewBag.Topic as string ?? string.Empty;
    var sort = ViewBag.Sort as string ?? "newest";
    var topics = ViewBag.Topics as List<string> ?? new List<string>();
    var page = ViewBag.Page is int currentPage ? currentPage : 1;
    var pageSize = ViewBag.PageSize is int currentPageSize ? currentPageSize : 10;
    var totalItems = ViewBag.TotalItems is int total ? total : Model.Count;
    var totalPages = ViewBag.TotalPages is int pages ? pages : 1;
    var startItem = ViewBag.StartItem is int start ? start : 0;
    var endItem = ViewBag.EndItem is int end ? end : Model.Count;
    var totalQuestions = ViewBag.TotalQuestions is int totalQuestionCount ? totalQuestionCount : Model.Count;
    var answeredQuestions = ViewBag.AnsweredQuestions is int answeredCount ? answeredCount : Model.Count(item => item.NgayTraLoi.HasValue || !string.IsNullOrWhiteSpace(item.CauTraLoi));
    var pendingQuestions = ViewBag.PendingQuestions is int pendingCount ? pendingCount : Math.Max(0, totalQuestions - answeredQuestions);
    Func<CauHoiTuVan, bool> daTraLoiAdmin = item => item.NgayTraLoi.HasValue
        || !string.IsNullOrWhiteSpace(item.CauTraLoi)
        || item.TrangThai.Contains("Đã", StringComparison.OrdinalIgnoreCase);
    Func<CauHoiTuVan, string> tenChuDe = item => !string.IsNullOrWhiteSpace(item.TenVaccine)
        ? item.TenVaccine
        : (!string.IsNullOrWhiteSpace(item.NhomVaccine) ? item.NhomVaccine : "Chưa phân loại");
    Func<CauHoiTuVan, string> tomTat = item =>
    {
        var text = item.CauHoi?.Trim() ?? string.Empty;
        return text.Length > 150 ? text.Substring(0, 150) + "..." : text;
    };
    const string tenBacSi = "BS Đoàn Thị Khánh Trâm";

    var cauHoiMau = new[]
    {
        new { TieuDe = "Sau khi tiêm vaccine cúm có sốt nhẹ có sao không?", MoTa = "Tôi vừa tiêm vaccine cúm mùa hôm qua, tối về bị sốt nhẹ 37.8°C và đau đầu nhẹ. Đây có phải là...", ThoiGian = "09/06/2026 10:15", TrangThai = "Đã trả lời", Kieu = "answered", Icon = "bi-thermometer-half", Active = true },
        new { TieuDe = "Trẻ 3 tuổi có cần tiêm vaccine phế cầu không?", MoTa = "Bé nhà tôi 3 tuổi, chưa từng tiêm vaccine phế cầu. Hiện bé khỏe mạnh, có cần tiêm không hay chỉ c...", ThoiGian = "07/06/2026 16:22", TrangThai = "Đang xử lý", Kieu = "processing", Icon = "bi-shield-plus", Active = false },
        new { TieuDe = "Tiêm HPV có tác dụng phụ gì không?", MoTa = "Tôi 24 tuổi, chuẩn bị tiêm HPV mũi đầu tiên. Không biết vaccine này có gây tác dụng phụ g...", ThoiGian = "05/06/2026 09:41", TrangThai = "Đã trả lời", Kieu = "answered", Icon = "bi-capsule", Active = false },
        new { TieuDe = "Có thể tiêm cùng lúc vaccine cúm và COVID-19?", MoTa = "Tôi định tiêm cúm và COVID-19 nhắc lại trong tuần này. Không biết có thể tiêm cùng lúc không?", ThoiGian = "02/06/2026 14:10", TrangThai = "Tự động trả lời", Kieu = "auto", Icon = "bi-lightning-charge", Active = false },
        new { TieuDe = "Phụ nữ đang mang thai có tiêm được vaccine cúm không?", MoTa = "Vợ tôi đang mang thai 20 tuần, có nên tiêm vaccine cúm vào mùa cúm không?", ThoiGian = "30/05/2026 11:06", TrangThai = "Đã trả lời", Kieu = "answered", Icon = "bi-heart-pulse", Active = false }
    };

    var quickQuestions = ViewBag.QuickQuestions as List<QuickQuestion> ?? new List<QuickQuestion>();
    var firstQuestion = Model.FirstOrDefault();
    var hasOfficialAnswer = firstQuestion != null && !string.IsNullOrWhiteSpace(firstQuestion.CauTraLoi);
    var questionCode = firstQuestion != null ? $"HQ-{firstQuestion.NgayGui:yyyyMMdd}-{firstQuestion.MaCauHoi:00000}" : "";
}

@if (laAdmin)
{
    <div class="admin-consultation-page">
        <section class="admin-consultation-hero">
            <div class="admin-hero-copy">
                <span class="admin-eyebrow"><i class="bi bi-chat-square-heart"></i> Pharmacy City Admin</span>
                <h1 class="admin-page-title">Quản lý câu hỏi tư vấn</h1>
                <p class="admin-page-subtitle">Quản lý, theo dõi và trả lời các câu hỏi tư vấn từ người dùng.</p>
                <strong>@totalQuestions câu hỏi trong danh sách</strong>
            </div>

            <div class="admin-hero-side">
                <div class="admin-stat-grid">
                    <div class="admin-stat-card total">
                        <i class="bi bi-collection"></i>
                        <span>Tổng câu hỏi</span>
                        <strong>@totalQuestions</strong>
                    </div>
                    <div class="admin-stat-card answered">
                        <i class="bi bi-check2-circle"></i>
                        <span>Đã trả lời</span>
                        <strong>@answeredQuestions</strong>
                    </div>
                    <div class="admin-stat-card pending">
                        <i class="bi bi-clock-history"></i>
                        <span>Đang chờ</span>
                        <strong>@pendingQuestions</strong>
                    </div>
                </div>
            </div>
        </section>

        <form method="get" class="admin-consultation-filter" data-live-form>
            <label class="admin-search-box">
                <i class="bi bi-search"></i>
                <input name="keyword" value="@keyword" placeholder="Tìm kiếm câu hỏi, người gửi..." data-live-search />
            </label>

            <select name="trangThai" aria-label="Lọc trạng thái" data-live-search>
                <option value="">Tất cả trạng thái</option>
                <option value="answered" selected="@(trangThai == "answered")">Đã trả lời</option>
                <option value="pending" selected="@(trangThai == "pending")">Đang chờ</option>
            </select>

            <select name="topic" aria-label="Lọc vaccine hoặc chủ đề" data-live-search>
                <option value="">Tất cả vaccine</option>
                @foreach (var item in topics)
                {
                    <option value="@item" selected="@(string.Equals(topic, item, StringComparison.OrdinalIgnoreCase))">@item</option>
                }
            </select>

            <select name="sort" aria-label="Sắp xếp" data-live-search>
                <option value="newest" selected="@(sort != "oldest")">Mới nhất</option>
                <option value="oldest" selected="@(sort == "oldest")">Cũ nhất</option>
            </select>

            <input type="hidden" name="pageSize" value="@pageSize" />
            <a asp-action="Index" class="admin-filter-reset"><i class="bi bi-arrow-clockwise"></i><span>Làm mới</span></a>
        </form>

        <section class="admin-question-card">
            <div class="admin-question-tabs">
                <a class="@(string.IsNullOrWhiteSpace(trangThai) ? "active" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-topic="@topic" asp-route-sort="@sort" asp-route-pageSize="@pageSize">Tất cả <span>@totalQuestions</span></a>
                <a class="@(trangThai == "answered" ? "active" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-trangThai="answered" asp-route-topic="@topic" asp-route-sort="@sort" asp-route-pageSize="@pageSize">Đã trả lời <span>@answeredQuestions</span></a>
                <a class="@(trangThai == "pending" ? "active" : "")" asp-action="Index" asp-route-keyword="@keyword" asp-route-trangThai="pending" asp-route-topic="@topic" asp-route-sort="@sort" asp-route-pageSize="@pageSize">Đang chờ <span>@pendingQuestions</span></a>
            </div>

            @if (Model.Count == 0)
            {
                <div class="admin-empty-state">
                    <i class="bi bi-inbox"></i>
                    <strong>Chưa có câu hỏi tư vấn phù hợp</strong>
                    <span>Khi người dùng gửi câu hỏi hoặc bộ lọc có kết quả, danh sách sẽ hiển thị tại đây.</span>
                </div>
            }
            else
            {
                <div class="admin-question-table-wrap">
                    <table class="admin-question-table">
                        <thead>
                            <tr>
                                <th>Câu hỏi</th>
                                <th>Chủ đề / Vaccine</th>
                                <th>Người gửi</th>
                                <th>Trạng thái</th>
                                <th>Ngày gửi</th>
                                <th>Ngày trả lời</th>
                                <th class="actions-col">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var answered = daTraLoiAdmin(item);
                                var topicName = tenChuDe(item);
                                <tr>
                                    <td class="question-main-cell">
                                        <div class="question-title-line question-title">@item.CauHoi</div>
                                        <p class="question-preview">@tomTat(item)</p>
                                        <span class="table-sub-text">ID: HQ-@item.NgayGui.ToString("yyyyMMdd")-@item.MaCauHoi.ToString("D5")</span>
                                    </td>
                                    <td><span class="topic-pill">@topicName</span></td>
                                    <td>
                                        <div class="sender-name">@(!string.IsNullOrWhiteSpace(item.TenNguoiGui) ? item.TenNguoiGui : "Người dùng")</div>
                                        <small>Người dùng hệ thống</small>
                                    </td>
                                    <td>
                                        <span class="consult-status @(answered ? "answered" : "pending")">
                                            <i class="bi @(answered ? "bi-check-circle-fill" : "bi-clock-fill")"></i>
                                            @(answered ? "Đã trả lời" : "Đang chờ")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="date-cell">@item.NgayGui.ToString("dd/MM/yyyy")</div>
                                        <small>@item.NgayGui.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        @if (item.NgayTraLoi.HasValue)
                                        {
                                            <div class="date-cell">@item.NgayTraLoi.Value.ToString("dd/MM/yyyy")</div>
                                            <small>@item.NgayTraLoi.Value.ToString("HH:mm")</small>
                                        }
                                        else
                                        {
                                            <span class="empty-date">-</span>
                                        }
                                    </td>
                                    <td class="actions-cell">
                                        <div class="table-actions consult-actions">
                                            <a asp-action="Details" asp-route-maCauHoi="@item.MaCauHoi" class="table-action-btn consult-action-btn" title="Xem chi tiết"><i class="bi bi-eye"></i><span>Xem</span></a>
                                            @if (!answered)
                                            {
                                                <a asp-action="traLoi" asp-route-id="@item.MaCauHoi" class="table-action-btn consult-action-btn primary" title="Trả lời"><i class="bi bi-reply"></i><span>Trả lời</span></a>
                                            }
                                            else
                                            {
                                                <a asp-action="traLoi" asp-route-id="@item.MaCauHoi" class="table-action-btn consult-action-btn muted" title="Sửa câu trả lời"><i class="bi bi-pencil-square"></i><span>Sửa</span></a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="admin-table-footer">
                <form method="get" class="admin-page-size">
                    <input type="hidden" name="keyword" value="@keyword" />
                    <input type="hidden" name="trangThai" value="@trangThai" />
                    <input type="hidden" name="topic" value="@topic" />
                    <input type="hidden" name="sort" value="@sort" />
                    <span>Hiển thị</span>
                    <select name="pageSize" onchange="this.form.submit()">
                        <option value="10" selected="@(pageSize == 10)">10</option>
                        <option value="20" selected="@(pageSize == 20)">20</option>
                        <option value="50" selected="@(pageSize == 50)">50</option>
                    </select>
                    <span>@startItem-@endItem trong tổng số @totalItems câu hỏi</span>
                </form>

                <nav class="admin-pagination" aria-label="Phân trang câu hỏi tư vấn">
                    <a class="@(page <= 1 ? "disabled" : "")" href="@Url.Action("Index", new { keyword, trangThai, topic, sort, page = Math.Max(1, page - 1), pageSize })"><i class="bi bi-chevron-left"></i></a>
                    @for (var i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                    {
                        <a class="@(i == page ? "active" : "")" href="@Url.Action("Index", new { keyword, trangThai, topic, sort, page = i, pageSize })">@i</a>
                    }
                    <a class="@(page >= totalPages ? "disabled" : "")" href="@Url.Action("Index", new { keyword, trangThai, topic, sort, page = Math.Min(totalPages, page + 1), pageSize })"><i class="bi bi-chevron-right"></i></a>
                </nav>
            </div>
        </section>
    </div>
}

