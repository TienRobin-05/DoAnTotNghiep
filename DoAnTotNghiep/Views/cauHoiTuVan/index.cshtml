*@
@if (!laAdmin)
{
    var userQuestions = Model;
    var firstUserQ = userQuestions.FirstOrDefault();
    var firstQuickQ = quickQuestions.FirstOrDefault();

    <div class="consult-page">
        <div class="consult-shell">

            <header class="consult-hero">
                <div class="consult-hero-left">
                    <div class="consult-hero-icon"><i class="bi bi-chat-dots-fill"></i></div>
                    <div>
                        <h1>Tư vấn trực tuyến</h1>
                        <p>Xem nhanh câu trả lời từ hệ thống và các bác sĩ chuyên môn cho mọi thắc mắc của bạn.</p>
                    </div>
                </div>
                <a asp-action="Create" class="consult-create-btn"><i class="bi bi-plus-lg"></i>Tạo câu hỏi mới</a>
            </header>

            <div class="consult-tabs">
                <button type="button" class="consult-tab active" data-mode="quick"><i class="bi bi-lightning-charge"></i>Câu hỏi nhanh</button>
                <button type="button" class="consult-tab" data-mode="mine"><i class="bi bi-person-circle"></i>Câu hỏi của bạn</button>
            </div>

            <div class="consult-layout">
                <aside class="consult-left-panel">
                    <section class="consult-list-card">
                        <div class="consult-card-heading">
                            <h2>Câu hỏi nhanh</h2>
                            <p>Chọn câu hỏi để xem câu trả lời chi tiết</p>
                        </div>
                        <div class="consult-search">
                            <input id="quickQuestionSearch" type="text" placeholder="Tìm kiếm câu hỏi..." />
                            <i class="bi bi-search"></i>
                        </div>
                        <div class="consult-question-list" id="quickQuestionList">
                            @foreach (var item in quickQuestions.Take(5))
                            {
                                <button type="button" class="consult-question-item js-select-consult-item"
                                        data-type="quick"
                                        data-title="@item.Question"
                                        data-answer="@item.Content"
                                        data-topic="@item.Topic"
                                        data-search="@item.Question @item.Topic"
                                        data-updated="@(item.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? item.CreatedAt.ToString("dd/MM/yyyy HH:mm"))">
                                    <span class="consult-question-icon"><i class="bi bi-lightning-charge-fill"></i></span>
                                    <span class="consult-question-text">
                                        <strong>@item.Question</strong>
                                        <small>@item.Topic</small>
                                    </span>
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            }
                        </div>
                        @if (quickQuestions.Count > 5)
                        {
                            <button type="button" class="consult-more-btn">Xem thêm câu hỏi <i class="bi bi-chevron-down"></i></button>
                        }
                    </section>
                </aside>

                <main class="consult-answer-panel">
                    <section class="consult-main-card" id="answerCard">
                        <div class="consult-answer-badge" id="answerBadge"><i class="bi bi-lightning-charge"></i><span>Nguồn: Câu hỏi nhanh</span></div>
                        <h2 id="answerTitle">Chọn câu hỏi để xem câu trả lời</h2>
                        <div class="consult-answer-meta" id="answerMeta"></div>
                        <div class="consult-info-note" id="answerHighlight"><i class="bi bi-info-circle"></i><span>Thông tin mang tính tham khảo.</span></div>
                        <div class="consult-answer-content" id="answerContent">
                            <p>Vui lòng chọn một câu hỏi từ danh sách bên trái để xem câu trả lời chi tiết.</p>
                        </div>
                    </section>
                </main>

                <aside class="consult-right-panel">
                    <section class="consult-side-card">
                        <div class="consult-card-heading">
                            <h2>Câu hỏi của bạn</h2>
                            <p>Xem câu hỏi bạn đã gửi và câu trả lời từ bác sĩ</p>
                        </div>
                        @if (userQuestions.Count == 0)
                        {
                            <div class="empty-state" style="margin-top:16px;">Bạn chưa gửi câu hỏi nào.</div>
                        }
                        else
                        {
                            <div class="user-question-list">
                                @foreach (var item in userQuestions)
                                {
                                    var daTraLoi = !string.IsNullOrWhiteSpace(item.CauTraLoi);
                                    <button type="button" class="user-question-item js-select-consult-item"
                                            data-type="user"
                                            data-title="@item.CauHoi"
                                            data-answer="@item.CauTraLoi"
                                            data-status="@item.TrangThai"
                                            data-doctor="Hệ thống"
                                            data-created="@item.NgayGui.ToString("dd/MM/yyyy HH:mm")"
                                            data-answered="@(item.NgayTraLoi?.ToString("dd/MM/yyyy HH:mm") ?? "")">
                                        <span class="user-question-icon"><i class="bi bi-chat-dots"></i></span>
                                        <span class="user-question-main">
                                            <strong>@item.CauHoi</strong>
                                            <small>@item.NgayGui.ToString("dd/MM/yyyy HH:mm")</small>
                                        </span>
                                        <span class="user-question-status @(daTraLoi ? "answered" : "pending")">@(daTraLoi ? "Đã trả lời" : "Đang chờ")</span>
                                    </button>
                                }
                            </div>
                        }
                        <a asp-action="Index" class="consult-view-all-btn">Xem tất cả câu hỏi của bạn <i class="bi bi-arrow-right"></i></a>
                    </section>

                    <section class="consult-trust-card">
                        <div class="trust-icon"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <h3>Thông tin tin cậy</h3>
                            <p>Các câu trả lời được tổng hợp từ Bộ Y tế, WHO và đội ngũ bác sĩ chuyên môn.</p>
                        </div>
                    </section>
                </aside>
            </div>

        </div>
    </div>
}

