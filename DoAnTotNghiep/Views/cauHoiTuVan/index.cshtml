@* Khu vực giao diện của view index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<CauHoiTuVan>
@{
    ViewData["Title"] = "Câu hỏi tư vấn";
    var laAdmin = ViewBag.LaAdmin is bool admin && admin;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@(laAdmin ? "Quản lý câu hỏi tư vấn" : "Câu hỏi tư vấn của tôi")</h2>
    @if (laAdmin)
    {
        <a asp-controller="Admin" asp-action="Index" class="btn btn-link">Về trang quản trị</a>
    }
    else
    {
        <a asp-action="Create" class="btn btn-primary">Gửi câu hỏi mới</a>
    }
</div>

@* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
@if (Model.Count == 0)
{
    @* Khu vực thông báo phản hồi kết quả xử lý, ví dụ thành công, lỗi nhập liệu hoặc lỗi nghiệp vụ. *@
    <div class="alert alert-info">@(laAdmin ? "Chưa có câu hỏi tư vấn nào." : "Bạn chưa gửi câu hỏi tư vấn nào.")</div>
}
else
{
    <section class="card">
    @* Khu vực bảng dùng để hiển thị danh sách dữ liệu theo từng cột, giúp người dùng dễ theo dõi và thao tác. *@
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Câu hỏi</th>
                @if (laAdmin)
                {
                    <th>Người gửi</th>
                }
                <th>Ngày gửi</th>
                <th>Trạng thái</th>
                <th>Ngày trả lời</th>
                @if (laAdmin)
                {
                    <th>Thao tác</th>
                }
            </tr>
        </thead>
        <tbody>
        @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (laAdmin)
                    {
                        @item.CauHoi
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-maCauHoi="@item.MaCauHoi">@item.CauHoi</a>
                    }
                </td>
                @if (laAdmin)
                {
                    <td>@item.TenNguoiGui</td>
                }
                <td>@item.NgayGui.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.TrangThai</td>
                <td>@(item.NgayTraLoi.HasValue ? item.NgayTraLoi.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                @if (laAdmin)
                {
                    <td>
                        <a asp-action="traLoi" asp-route-id="@item.MaCauHoi" class="btn btn-sm btn-primary">Trả lời</a>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
    </section>
}
