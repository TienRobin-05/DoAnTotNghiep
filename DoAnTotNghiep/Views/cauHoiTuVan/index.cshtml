    }

    .advice-box h4 {
        margin: 0 0 10px;
        color: #102a43;
        font-size: .95rem;
        font-weight: 800;
    }

    .doctor-note {
        margin: 16px 0 0;
    }

    .support-column {
        display: grid;
        gap: 16px;
    }

    .info-card h2,
    .action-card h2,
    .related-card h2 {
        margin-bottom: 14px;
    }

    .processing-card {
        width: 100%;
        padding: 22px 24px;
    }

    .processing-card-title {
        margin: 0 0 18px;
        color: #0f2544;
        font-size: 20px;
        font-weight: 800;
        line-height: 1.25;
    }

    .processing-info-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .processing-info-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 0;
        border-bottom: 1px solid #e5edf7;
    }

    .processing-info-row:first-child {
        padding-top: 0;
    }

    .processing-info-row:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .processing-info-label {
        flex: 0 0 auto;
        color: #718096;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.4;
        white-space: nowrap;
    }

    .processing-info-value {
        flex: 1;
        min-width: 0;
        color: #0f2544;
        font-size: 15px;
        font-weight: 800;
        line-height: 1.45;
        text-align: right;
        white-space: normal;
        word-break: normal;
        overflow-wrap: break-word;
    }

    .processing-info-row.doctor-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
    }

    .processing-info-row.doctor-row .processing-info-value {
        max-width: 100%;
        text-align: left;
    }

    .status-badge.answered {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 14px;
        border-radius: 999px;
        color: #15803d;
        background: #dcfce7;
        font-size: 14px;
        font-weight: 800;
        line-height: 1.2;
        white-space: nowrap;
    }

    .quick-actions {
        display: grid;
        gap: 9px;
    }

    .quick-action {
        width: 100%;
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr) 18px;
        align-items: center;
        gap: 10px;
        border: 1px solid #dce9f3;
        border-radius: 12px;
        padding: 11px;
        background: #ffffff;
        color: #17324a;
        text-align: left;
        transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .quick-action:hover {
        border-color: #b8d4ff;
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.11);
        transform: translateY(-1px);
    }

    .quick-action > i:first-child {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #2563eb;
        background: #eaf3ff;
    }

    .quick-action strong,
    .quick-action small {
        display: block;
    }

    .quick-action strong {
        color: #1d4ed8;
    }

    .quick-action small {
        margin-top: 2px;
        color: #6a7f91;
        line-height: 1.35;
    }

    .action-note {
        margin: 13px 0 0;
        color: #6a7f91;
        font-size: .86rem;
        line-height: 1.5;
    }

    .related-card {
        display: grid;
        gap: 11px;
    }

    .related-card h2 {
        margin-bottom: 2px;
    }

    .related-card a {
        display: flex;
        gap: 9px;
        align-items: flex-start;
        color: #1d4ed8;
        text-decoration: none;
        line-height: 1.45;
        font-weight: 650;
    }

    .related-card a:hover {
        color: #1e40af;
        text-decoration: underline;
    }

    .related-card a i {
        margin-top: 2px;
    }

    @@media (max-width: 1260px) {
        .consultation-page {
            padding-inline: 32px;
        }

        .consultation-grid {
            grid-template-columns: minmax(310px, .9fr) minmax(0, 1.1fr);
        }

        .support-column {
            grid-column: 1 / -1;
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .question-panel,
        .support-column {
            position: static;
        }
    }

    @@media (max-width: 920px) {
        .consultation-page {
            padding: 22px 16px 36px;
        }

        .consultation-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .btn-new-question {
            width: 100%;
        }

        .consultation-grid,
        .support-column,
        .advice-grid,
        .question-tools {
            grid-template-columns: 1fr;
        }

        .detail-card h2 {
            font-size: 1.28rem;
        }

        .doctor-answer-head {
            flex-direction: column;
        }

        .reply-time {
            text-align: left;
        }
    }

    @@media (max-width: 560px) {
        .consultation-title {
            align-items: flex-start;
        }

        .title-icon {
            width: 48px;
            height: 48px;
        }

        .consultation-title h1 {
            font-size: 1.55rem;
        }

        .question-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .question-item {
            grid-template-columns: 36px minmax(0, 1fr);
            padding: 12px;
        }

        .question-icon {
            width: 36px;
            height: 36px;
        }

        .quick-action {
            grid-template-columns: 34px minmax(0, 1fr) 16px;
        }
    }

    .consult-response-card {
