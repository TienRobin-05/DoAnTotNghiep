<script>
document.addEventListener("DOMContentLoaded", function () {
    var modal = document.getElementById("quickAnswerModal");
    var titleEl = document.getElementById("quickAnswerTitle");
    var topicEl = document.getElementById("quickAnswerTopic");
    var contentEl = document.getElementById("quickAnswerContent");
    var closeBtn = document.getElementById("quickAnswerClose");
    var doneBtn = document.getElementById("quickAnswerDone");
    var searchInput = document.getElementById("quickQuestionSearch");

    if (!modal || !titleEl || !contentEl) return;

    function openModal(button) {
        titleEl.textContent = button.getAttribute("data-question") || "";
        var topic = button.getAttribute("data-topic") || "";
        if (topicEl) {
            topicEl.textContent = topic;
            topicEl.hidden = !topic;
        }
        contentEl.textContent = button.getAttribute("data-answer") || "Đang cập nhật câu trả lời.";
        modal.hidden = false;
        document.body.style.overflow = "hidden";
    }

    function closeModal() {
        modal.hidden = true;
        document.body.style.overflow = "";
    }

    document.querySelectorAll(".js-open-quick-answer").forEach(function (btn) {
        btn.addEventListener("click", function () { openModal(btn); });
    });

    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    if (doneBtn) doneBtn.addEventListener("click", closeModal);

    modal.addEventListener("click", function (e) { if (e.target === modal) closeModal(); });

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !modal.hidden) closeModal();
    });

    if (searchInput) {
        searchInput.addEventListener("input", function () {
            var keyword = (searchInput.value || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").trim();
            document.querySelectorAll(".quick-question-card").forEach(function (card) {
                var text = ((card.getAttribute("data-question") || "") + " " + (card.getAttribute("data-topic") || "")).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d");
                card.style.display = text.includes(keyword) ? "" : "none";
            });
        });
    }
});
</script>
<script>
(function() {
    var timer = null;
    document.querySelectorAll("[data-live-search]").forEach(function(el) {
        var event = el.tagName === "SELECT" ? "change" : "input";
        el.addEventListener(event, function() {
            clearTimeout(timer);
            var form = el.closest("form");
            if (!form) return;
            timer = setTimeout(function() {
                var url = new URL(form.action, window.location.origin);
                new FormData(form).forEach(function(v, k) {
                    if (v) url.searchParams.set(k, v);
                });
                url.searchParams.set("page", "1");
                window.location.href = url.toString();
            }, 300);
        });
    });
})();
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
    var items = document.querySelectorAll(".js-select-consult-item");
    var tabs = document.querySelectorAll(".consult-tab");
    var badge = document.getElementById("answerBadge");
    var title = document.getElementById("answerTitle");
    var meta = document.getElementById("answerMeta");
    var highlight = document.getElementById("answerHighlight");
    var content = document.getElementById("answerContent");
    var searchInput = document.getElementById("quickQuestionSearch");

    function esc(v) { return String(v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }

    function setTab(type) {
        tabs.forEach(function (t) { t.classList.toggle("active", t.dataset.mode === (type === "quick" ? "quick" : "mine")); });
    }
    function clearActive() {
        items.forEach(function (el) { el.classList.remove("active"); });
    }

    function renderContent(item) {
        var type = item.dataset.type;
        var q = item.dataset.title || "";
        var a = item.dataset.answer || "";

        clearActive();
        item.classList.add("active");
        setTab(type);

        if (type === "quick") {
            var topic = item.dataset.topic || "";
            var updated = item.dataset.updated || "";
            badge.innerHTML = '<i class="bi bi-lightning-charge"></i><span>Nguồn: Câu hỏi nhanh</span>';
            title.textContent = q;
            meta.innerHTML = '<span style="color:#16a34a;font-weight:800;">&#10003; Trả lời bởi Bộ Y tế &amp; WHO</span><span class="consult-meta-sep">|</span><span>Cập nhật: ' + esc(updated) + '</span>';
            highlight.innerHTML = '<i class="bi bi-info-circle"></i><span>Thông tin mang tính tham khảo, không thay thế cho chẩn đoán y khoa.</span>';
            content.innerHTML =
                '<h3>Câu trả lời</h3><p>' + esc(a) + '</p>' +
                '<h3>Khuyến cáo</h3><ul><li>Theo dõi sức khỏe sau tiêm và nghỉ ngơi đầy đủ.</li><li>Liên hệ cơ sở y tế nếu có dấu hiệu bất thường.</li></ul>' +
                '<div class="consult-important-note"><i class="bi bi-shield-check"></i><span>Vui lòng hỏi ý kiến bác sĩ nếu bạn có bệnh nền, đang mang thai hoặc có tiền sử dị ứng.</span></div>';
        } else {
            var doctor = item.dataset.doctor || "Hệ thống";
            var answered = item.dataset.answered || "";
            badge.innerHTML = '<i class="bi bi-person-circle"></i><span>Câu hỏi của bạn</span>';
            title.textContent = q;
            if (a && a.trim()) {
                meta.innerHTML = '<span style="color:#16a34a;font-weight:800;">&#10003; Chuyên gia đã trả lời</span><span class="consult-meta-sep">|</span><span>Trả lời lúc: ' + esc(answered) + '</span>';
                highlight.innerHTML = '<i class="bi bi-person-badge"></i><span>Phản hồi từ ' + esc(doctor) + '</span>';
                content.innerHTML = '<h3>Câu trả lời chi tiết</h3><p>' + esc(a) + '</p>';
            } else {
                meta.innerHTML = '<span style="color:#f59e0b;font-weight:800;">&#9201; Đang chờ phản hồi</span>';
                highlight.innerHTML = '<i class="bi bi-clock"></i><span>Câu hỏi của bạn đang được tiếp nhận.</span>';
                content.innerHTML = '<h3>Đang chờ câu trả lời</h3><p>Chúng tôi sẽ cập nhật câu trả lời ngay khi có phản hồi chính thức.</p>';
            }
        }
    }

    items.forEach(function (item) {
        item.addEventListener("click", function () { renderContent(item); });
    });

    tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
            var first = document.querySelector('.js-select-consult-item[data-type="' + (tab.dataset.mode === "mine" ? "user" : "quick") + '"]');
            if (first) first.click();
        });
    });

    if (searchInput) {
        searchInput.addEventListener("input", function () {
            var keyword = (searchInput.value || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d").trim();
            document.querySelectorAll("#quickQuestionList .consult-question-item").forEach(function (card) {
                var text = ((card.dataset.search || card.dataset.title || "") + " " + (card.dataset.topic || "")).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d");
                card.style.display = text.includes(keyword) ? "" : "none";
            });
        });
    }
});
</script>