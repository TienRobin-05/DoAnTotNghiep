        transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
    }

    .quick-question-card:hover {
        border-color: #93c5fd;
        background: #f8fbff;
        box-shadow: 0 8px 20px rgba(37, 99, 235, .06);
    }

    .quick-question-icon {
        width: 46px;
        height: 46px;
        border-radius: 999px;
        background: #eff6ff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .quick-question-main {
        min-width: 0;
    }

    .quick-question-title {
        color: #0f172a;
        font-size: 16px;
        line-height: 1.3;
        font-weight: 850;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
