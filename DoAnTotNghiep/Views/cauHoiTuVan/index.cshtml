    .quick-answer-header {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding-right: 36px;
        margin-bottom: 18px;
    }

    .quick-answer-icon {
        width: 50px;
        height: 50px;
        border-radius: 999px;
        background: #eff6ff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
