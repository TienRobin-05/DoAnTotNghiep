        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 16px;
        margin-bottom: 16px;
    }

    .quick-search-box i {
        color: #64748b;
        font-size: 18px;
        flex-shrink: 0;
    }

    .quick-search-box input {
        flex: 1;
        min-width: 0;
        border: none;
        outline: none;
        color: #0f172a;
        font-size: 16px;
        font-weight: 500;
    }

    .quick-search-box input::placeholder {
        color: #94a3b8;
    }

    .quick-question-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .quick-question-card {
        width: 100%;
        min-height: 74px;
        border: 1px solid #dbe5f0;
        border-radius: 16px;
        background: #ffffff;
        padding: 14px 16px;
