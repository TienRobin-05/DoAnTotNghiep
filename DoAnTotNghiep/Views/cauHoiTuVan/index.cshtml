@model List<cauHoiTuVanModels>
@{
    ViewData["Title"] = "Câu hỏi tư vấn";
    var laAdmin = string.Equals(Context.Session.GetString("VaiTro"), "Admin", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Câu hỏi tư vấn</h2>
    @if (!laAdmin)
    {
        <a asp-action="guiCauHoi" class="btn btn-primary">Gửi câu hỏi</a>
    }
</div>

<table class="table table-bordered table-striped">
    <thead><tr><th>Người gửi</th><th>Câu hỏi</th><th>Trả lời</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.tenNguoiGui</td>
            <td>@item.cauHoi</td>
            <td>@item.cauTraLoi</td>
            <td>@item.trangThai</td>
            <td>
                @if (laAdmin)
                {
                    <a asp-action="traLoi" asp-route-id="@item.maCauHoi" class="btn btn-sm btn-outline-primary">Trả lời</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
