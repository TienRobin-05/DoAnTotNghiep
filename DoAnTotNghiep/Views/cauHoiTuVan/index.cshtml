    }

.consult-page {
    min-height: calc(100vh - 72px);
    background: #f4f8fd;
    padding: 28px 26px 56px;
    color: #0f172a;
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
}
.consult-shell {
    width: min(1760px, 100%);
    margin: 0 auto;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    border: 1px solid #dbe5f0;
    border-radius: 24px;
    padding: 34px 38px 42px;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.06);
}
.consult-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 34px;
}
.consult-hero-left {
    display: flex;
    align-items: center;
    gap: 18px;
}
.consult-hero-icon {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: #eff6ff;
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    flex-shrink: 0;
}
.consult-hero h1 {
    margin: 0;
    color: #0f172a;
    font-size: 38px;
    line-height: 1.15;
    font-weight: 900;
    letter-spacing: -0.04em;
}
.consult-hero p {
    margin: 9px 0 0;
    color: #64748b;
    font-size: 17px;
    line-height: 1.45;
    font-weight: 500;
}
.consult-create-btn {
    height: 54px;
    padding: 0 24px;
    border-radius: 14px;
    background: #2563eb;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 850;
    text-decoration: none;
    box-shadow: 0 16px 32px rgba(37, 99, 235, 0.22);
    flex-shrink: 0;
}
.consult-create-btn:hover { background: #1d4ed8; color: #ffffff; }
.consult-tabs {
    width: min(690px, 100%);
    height: 64px;
    margin: 0 auto 28px;
    border: 1px solid #dbe5f0;
    border-radius: 18px;
    background: #ffffff;
    padding: 6px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.04);
}
.consult-tab {
    border: none;
    border-radius: 14px;
    background: transparent;
    color: #64748b;
    font-size: 16px;
    font-weight: 850;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
}
.consult-tab.active { background: #2563eb; color: #ffffff; box-shadow: 0 12px 24px rgba(37, 99, 235, 0.18); }
.consult-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.45fr 0.85fr;
    gap: 24px;
    align-items: start;
}
.consult-left-panel, .consult-answer-panel, .consult-right-panel { min-width: 0; }
.consult-list-card, .consult-main-card, .consult-side-card, .consult-trust-card {
    background: #ffffff;
    border: 1px solid #dbe5f0;
    border-radius: 18px;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
}
.consult-list-card { padding: 24px; }
.consult-card-heading h2 {
    margin: 0;
    color: #0f172a;
    font-size: 22px;
    line-height: 1.25;
    font-weight: 900;
}
.consult-card-heading p {
    margin: 7px 0 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
}
.consult-search { position: relative; margin: 20px 0 18px; }
.consult-search input {
    width: 100%;
    height: 50px;
    border: 1px solid #dbe5f0;
    border-radius: 12px;
    background: #ffffff;
    padding: 0 44px 0 16px;
    color: #0f172a;
    font-size: 15px;
    font-weight: 600;
    outline: none;
}
.consult-search input:focus { border-color: #2563eb; box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.10); }
.consult-search i { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #64748b; }
.consult-question-list { display: flex; flex-direction: column; gap: 12px; }
.consult-question-item {
    width: 100%;
    min-height: 74px;
    border: 1px solid #dbe5f0;
    border-radius: 14px;
    background: #ffffff;
    padding: 14px;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 14px;
    text-align: left;
    cursor: pointer;
    transition: all 0.18s ease;
}
.consult-question-item:hover, .consult-question-item.active { border-color: #2563eb; background: #f8fbff; box-shadow: 0 10px 24px rgba(37, 99, 235, 0.08); }
.consult-question-icon {
    width: 44px; height: 44px; border-radius: 14px; background: #eff6ff; color: #2563eb;
    display: flex; align-items: center; justify-content: center; font-size: 18px;
}
.consult-question-text { min-width: 0; }
.consult-question-text strong {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    color: #0f172a; font-size: 15px; line-height: 1.3; font-weight: 850;
}
.consult-question-text small {
    display: block; margin-top: 4px; color: #64748b; font-size: 13px; font-weight: 600;
}
.consult-question-item > i { color: #334155; font-size: 14px; }
.consult-more-btn {
    width: 100%; height: 46px; margin-top: 18px; border: 1px solid #dbe5f0; border-radius: 12px;
    background: #ffffff; color: #2563eb; display: flex; align-items: center; justify-content: center;
    gap: 9px; font-size: 15px; font-weight: 850; cursor: pointer;
}
.consult-more-btn:hover { background: #eff6ff; }
.consult-main-card { position: relative; padding: 34px; min-height: 500px; }
.consult-answer-badge {
    width: fit-content; min-height: 32px; border-radius: 999px; background: #eff6ff; color: #2563eb;
    padding: 8px 13px; display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 850; margin-bottom: 18px;
}
.consult-main-card h2 {
    margin: 0; color: #0f172a; font-size: 26px; line-height: 1.28; font-weight: 900; letter-spacing: -0.03em;
}
.consult-answer-meta {
    display: flex; align-items: center; gap: 10px; margin: 16px 0 24px; color: #64748b; font-size: 15px; font-weight: 600; flex-wrap: wrap;
}
.consult-info-note {
    border: 1px solid #bfdbfe; border-left: 4px solid #2563eb; border-radius: 12px;
    background: #f8fbff; color: #1e3a8a; padding: 14px 16px; display: flex; gap: 12px;
    align-items: flex-start; margin-bottom: 24px; font-size: 15px; line-height: 1.55; font-weight: 600;
}
.consult-info-note i { margin-top: 2px; color: #2563eb; flex-shrink: 0; }
.consult-answer-content { color: #334155; font-size: 16px; line-height: 1.75; font-weight: 500; }
.consult-answer-content p { margin: 0 0 14px; }
.consult-answer-content h3 { margin: 24px 0 10px; color: #0f172a; font-size: 19px; font-weight: 900; }
.consult-answer-content ul { margin: 10px 0 20px; padding: 0; list-style: none; display: grid; gap: 10px; }
.consult-answer-content li { position: relative; padding-left: 26px; }
.consult-answer-content li::before {
    content: "✓"; position: absolute; left: 0; top: 3px; width: 18px; height: 18px;
    border-radius: 999px; background: #16a34a; color: #fff; display: flex; align-items: center;
    justify-content: center; font-size: 11px; font-weight: 900;
}
.consult-important-note {
    margin-top: 20px; border: 1px solid #bfdbfe; border-radius: 12px; background: #f8fbff;
