@model CauHoiTuVan
@{
    ViewData["Title"] = "Trả lời tư vấn";
}

<h2>Trả lời câu hỏi tư vấn</h2>

<section class="detail-card mb-3">
    <p><strong>Người gửi:</strong> @Model.TenNguoiGui</p>
    <p><strong>Ngày gửi:</strong> @Model.NgayGui.ToString("dd/MM/yyyy HH:mm")</p>
    <hr />
    <p><strong>Câu hỏi:</strong></p>
    <p>@Model.CauHoi</p>
</section>

<form asp-action="traLoi" method="post" class="col-md-8">
    @Html.AntiForgeryToken()
    <input type="hidden" name="maCauHoi" value="@Model.MaCauHoi" />
    <div class="mb-3">
        <label class="form-label">Câu trả lời</label>
        <textarea name="cauTraLoi" rows="5" class="form-control">@Model.CauTraLoi</textarea>
    </div>
    <button type="submit" class="btn btn-primary">Gửi câu trả lời</button>
</form>
