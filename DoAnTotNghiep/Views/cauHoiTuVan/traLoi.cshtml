@model cauHoiTuVanModels
@{
    ViewData["Title"] = "Trả lời tư vấn";
}

<h2>Trả lời câu hỏi</h2>
<div class="mb-3">
    <strong>Người gửi:</strong> @Model.tenNguoiGui
</div>
<div class="border p-3 mb-3">@Model.cauHoi</div>
<form asp-action="traLoi" method="post" class="col-md-8">
    @Html.AntiForgeryToken()
    <input type="hidden" name="maCauHoi" value="@Model.maCauHoi" />
    <div class="mb-3">
        <label class="form-label">Câu trả lời</label>
        <textarea name="cauTraLoi" rows="5" class="form-control">@Model.cauTraLoi</textarea>
    </div>
    <button type="submit" class="btn btn-primary">Lưu trả lời</button>
    <a asp-action="index" class="btn btn-link">Quay lại</a>
</form>
