@* Khu vực giao diện của view guiCauHoi.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model cauHoiTuVanModels
@{
    ViewData["Title"] = "Gửi câu hỏi";
}

<h2>Gửi câu hỏi tư vấn</h2>
@* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
<form asp-action="guiCauHoi" method="post" class="col-md-8">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="cauHoi" class="form-label">Câu hỏi</label>
        <textarea asp-for="cauHoi" rows="5" class="form-control"></textarea>
        <span asp-validation-for="cauHoi" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Gửi</button>
</form>
