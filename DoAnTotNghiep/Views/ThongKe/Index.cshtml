@* Khu vực giao diện của view Index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model ThongKeViewModel
@{
    ViewData["Title"] = "Thống kê";
}

<h2>Thống kê tổng quan</h2>

<style>
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
    .stat-box { border: 1px solid #ddd; border-radius: 6px; padding: 16px; background: #fff; }
    .stat-box strong { display: block; font-size: 28px; }
    .stat-box span { color: #555; }
</style>

<div class="stat-grid">
    <div class="stat-box"><strong>@Model.TongSoTaiKhoan</strong><span>Tổng số tài khoản</span></div>
    <div class="stat-box"><strong>@Model.TongSoNguoiDung</strong><span>Tổng số người dùng</span></div>
    <div class="stat-box"><strong>@Model.TongSoAdmin</strong><span>Tổng số admin</span></div>
    <div class="stat-box"><strong>@Model.TongSoHoSoSucKhoe</strong><span>Tổng số hồ sơ sức khỏe</span></div>
    <div class="stat-box"><strong>@Model.TongSoVaccineDangSuDung</strong><span>Vaccine đang sử dụng</span></div>
    <div class="stat-box"><strong>@Model.TongSoLichTiem</strong><span>Tổng số lịch tiêm</span></div>
    <div class="stat-box"><strong>@Model.TongSoLichTiemChuaTiem</strong><span>Lịch tiêm chưa tiêm</span></div>
    <div class="stat-box"><strong>@Model.TongSoLichTiemDaTiem</strong><span>Lịch tiêm đã tiêm</span></div>
    <div class="stat-box"><strong>@Model.TongSoLichTiemQuaHan</strong><span>Lịch tiêm quá hạn</span></div>
    <div class="stat-box"><strong>@Model.TongSoCauHoiChuaTraLoi</strong><span>Câu hỏi chưa trả lời</span></div>
    <div class="stat-box"><strong>@Model.TongSoCauHoiDaTraLoi</strong><span>Câu hỏi đã trả lời</span></div>
    <div class="stat-box"><strong>@Model.TongSoBaiVietDangHienThi</strong><span>Bài viết đang hiển thị</span></div>
</div>
