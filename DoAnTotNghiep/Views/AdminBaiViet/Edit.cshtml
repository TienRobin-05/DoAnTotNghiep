@* Khu vực giao diện của view Edit.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model BaiVietCamNang
@{
    ViewData["Title"] = "Sửa bài viết";
}

<h2>Sửa bài viết</h2>

@* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
@if (ViewBag.ThongBao != null)
{
    @* Khu vực thông báo phản hồi kết quả xử lý, ví dụ thành công, lỗi nhập liệu hoặc lỗi nghiệp vụ. *@
    <div class="alert alert-danger">@ViewBag.ThongBao</div>
}

@* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
<form asp-action="Edit" method="post" class="col-md-8">
    @Html.AntiForgeryToken()
    <input asp-for="MaBaiViet" type="hidden" />
    <div class="mb-3">
        <label class="form-label">Tiêu đề</label>
        <input asp-for="TieuDe" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Nội dung</label>
        <textarea asp-for="NoiDung" rows="10" class="form-control"></textarea>
    </div>
    <div class="form-check mb-3">
        <input asp-for="TrangThai" class="form-check-input" />
        <label class="form-check-label">Hiển thị</label>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
