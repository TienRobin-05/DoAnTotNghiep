@* Khu vực giao diện của view Edit.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model BaiVietCamNang
@{
    ViewData["Title"] = "Sửa bài viết";
}

<h2>Sửa bài viết</h2>

@* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
<form asp-action="Edit" method="post" enctype="multipart/form-data" class="col-md-8">
    @Html.AntiForgeryToken()
    <input asp-for="MaBaiViet" type="hidden" />
    <input asp-for="AnhDaiDien" type="hidden" />
    <input asp-for="LuotXem" type="hidden" />
    <input asp-for="MaTaiKhoan" type="hidden" />
    <input asp-for="NgayTao" type="hidden" />
    <div class="mb-3">
        <label class="form-label">Tiêu đề</label>
        <input asp-for="TieuDe" class="form-control" placeholder="Nhập tiêu đề bài viết..." />
    </div>
    <div class="mb-3">
        <label class="form-label">Slug</label>
        <input asp-for="Slug" class="form-control" placeholder="Tự tạo nếu để trống" />
    </div>
    <div class="mb-3">
        <label class="form-label">Loại bài viết</label>
        <select asp-for="LoaiBaiViet" class="form-select">
            <option value="Tin tức">Tin tức</option>
            <option value="Cẩm nang sức khỏe">Cẩm nang sức khỏe</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả ngắn</label>
        <textarea asp-for="MoTaNgan" rows="3" class="form-control" placeholder="Nhập mô tả ngắn hiển thị ngoài danh sách..."></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Ảnh đại diện</label>
        @if (!string.IsNullOrWhiteSpace(Model.AnhDaiDien))
        {
            <div class="article-form-preview">
                <img src="@Model.AnhDaiDien" alt="@Model.TieuDe" />
            </div>
        }
        <input type="file" name="anhDaiDienFile" class="form-control mt-3" accept=".jpg,.jpeg,.png,.webp" />
        <div class="item-meta">Để trống nếu muốn giữ ảnh hiện tại. Hỗ trợ JPG, PNG, WEBP, tối đa 2MB.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Nội dung</label>
        <textarea asp-for="NoiDung" rows="10" class="form-control"></textarea>
    </div>
    <div class="form-check mb-3">
        <input asp-for="TrangThai" class="form-check-input" />
        <label class="form-check-label">Xuất bản</label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="NoiBat" class="form-check-input" />
        <label class="form-check-label">Đánh dấu là bài viết nổi bật</label>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
