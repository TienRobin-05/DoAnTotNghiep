@* Khu vực giao diện của view Index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<BaiVietCamNang>
@{
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="list-page-head">
    <div>
        <h2 class="admin-page-title">Quản lý tin tức &amp; cẩm nang sức khỏe</h2>
        <p class="admin-page-subtitle">Thêm và quản lý các bài viết hiển thị cho người dùng - @Model.Count bài viết trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm bài viết</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state empty-action">
        <div>
            <strong>Chưa có bài viết</strong>
            <span>Thêm bài viết để người dùng có nội dung tham khảo về vaccine và chăm sóc sức khỏe.</span>
        </div>
        <a asp-action="Create" class="btn btn-primary">Thêm bài viết</a>
    </div>
}
else
{
<section class="list-card">
<table class="table list-table">
    <thead>
        <tr>
            <th>Bài viết</th>
            <th>Loại</th>
            <th>Trạng thái</th>
            <th>Nổi bật</th>
            <th>Lượt xem</th>
            <th>Ngày đăng</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <div class="admin-article-cell">
                    <div class="admin-article-thumb">
                        @if (!string.IsNullOrWhiteSpace(item.AnhDaiDien))
                        {
                            <img src="@item.AnhDaiDien" alt="@item.TieuDe" />
                        }
                    </div>
                    <div>
                        <div class="item-title table-main-text">@item.TieuDe</div>
                        <div class="item-meta table-sub-text">@(string.IsNullOrWhiteSpace(item.MoTaNgan) ? item.Slug : item.MoTaNgan)</div>
                    </div>
                </div>
            </td>
            <td><span class="article-type-pill">@item.LoaiBaiViet</span></td>
            <td>
                <span class="status-badge @(item.TrangThai ? "status-ok" : "status-muted")">
                    @(item.TrangThai ? "Đã xuất bản" : "Đã ẩn")
                </span>
            </td>
            <td>
                <form asp-action="DoiNoiBat" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maBaiViet" value="@item.MaBaiViet" />
                    <input type="hidden" name="noiBat" value="@(!item.NoiBat)" />
                    <button type="submit" class="btn btn-sm @(item.NoiBat ? "btn-warning" : "btn-outline-secondary")">
                        @(item.NoiBat ? "Nổi bật" : "Thường")
                    </button>
                </form>
            </td>
            <td>@item.LuotXem.ToString("N0")</td>
            <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
            <td class="table-actions-cell">
                <div class="table-actions article-actions">
                    <a asp-action="Details" asp-route-maBaiViet="@item.MaBaiViet" class="table-action-btn article-action-btn">Chi tiết</a>
                    <a asp-action="Edit" asp-route-maBaiViet="@item.MaBaiViet" class="table-action-btn article-action-btn">Sửa</a>
                    <div class="table-more-menu">
                        <button type="button" class="table-more-btn js-table-more-btn" title="Thêm thao tác">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <div class="table-more-dropdown">
                            <form asp-action="AnHien" method="post" class="table-more-item-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maBaiViet" value="@item.MaBaiViet" />
                                <input type="hidden" name="trangThai" value="@(!item.TrangThai)" />
                                <button type="submit" class="table-more-item">
                                    <i class="bi @(item.TrangThai ? "bi-eye-slash" : "bi-eye")"></i>
                                    @(item.TrangThai ? "Ẩn" : "Hiện")
                                </button>
                            </form>
                            <button type="button"
                                    class="table-more-item danger js-delete-confirm"
                                    data-delete-url="@Url.Action("DeleteConfirmed", new { maBaiViet = item.MaBaiViet })"
                                    data-delete-title="Xóa bài viết">
                                <i class="bi bi-trash3"></i>
                                Xóa
                            </button>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
</section>
}

<partial name="_ConfirmDeleteModal" />
