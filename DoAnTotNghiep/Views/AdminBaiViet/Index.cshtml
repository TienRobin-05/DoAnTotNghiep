@* Khu vực giao diện của view Index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<BaiVietCamNang>
@{
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="list-page-head">
    <div>
        <h2>Quản lý bài viết cẩm nang</h2>
        <p>@Model.Count bài viết trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm bài viết</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Chưa có bài viết</div>
}
else
{
<section class="list-card">
<table class="table list-table">
    <thead>
        <tr>
            <th>Bài viết</th>
            <th>Tác giả</th>
            <th>Ngày tạo</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <div class="item-title">@item.TieuDe</div>
                <div class="item-meta">Mã bài viết #@item.MaBaiViet</div>
            </td>
            <td>@item.TenTacGia</td>
            <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
            <td>
                <span class="status-badge @(item.TrangThai ? "status-ok" : "status-muted")">
                    @(item.TrangThai ? "Đang hiển thị" : "Đang ẩn")
                </span>
            </td>
            <td class="table-actions">
                <a asp-action="Details" asp-route-maBaiViet="@item.MaBaiViet" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                <a asp-action="Edit" asp-route-maBaiViet="@item.MaBaiViet" class="btn btn-sm btn-outline-primary">Sửa</a>
                <a asp-action="Delete" asp-route-maBaiViet="@item.MaBaiViet" class="btn btn-sm btn-outline-danger">Xóa</a>
                @* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
                <form asp-action="AnHien" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maBaiViet" value="@item.MaBaiViet" />
                    <input type="hidden" name="trangThai" value="@(!item.TrangThai)" />
                    <button type="submit" class="btn btn-sm btn-outline-warning">@(item.TrangThai ? "Ẩn" : "Hiện")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</section>
}
