@* Khu vực giao diện của view Create.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model BaiVietCamNang
@{
    ViewData["Title"] = "Thêm bài viết";
}

<h2>Thêm bài viết</h2>

@* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-8">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Tiêu đề</label>
        <input asp-for="TieuDe" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Loại bài viết</label>
        <select asp-for="LoaiBaiViet" class="form-select">
            <option value="Cẩm nang">Cẩm nang</option>
            <option value="Tin tức">Tin tức</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Ảnh đại diện</label>
        <input type="file" name="anhDaiDienFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
        <div class="item-meta">Hỗ trợ JPG, PNG, WEBP. Dung lượng tối đa 2MB.</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Nội dung</label>
        <textarea asp-for="NoiDung" rows="10" class="form-control"></textarea>
    </div>
    <div class="form-check mb-3">
        <input asp-for="TrangThai" class="form-check-input" />
        <label class="form-check-label">Hiển thị</label>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
