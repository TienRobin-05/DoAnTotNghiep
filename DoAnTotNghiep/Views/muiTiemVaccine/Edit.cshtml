@* Khu vực giao diện của view Edit.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model MuiTiemVaccine
@{
    ViewData["Title"] = "Sửa mũi tiêm vaccine";
}

<h2>Sửa mũi tiêm vaccine</h2>

@* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
<form method="post" class="col-md-8">
    @Html.AntiForgeryToken()
    <input asp-for="MaMuiTiem" type="hidden" />
    <partial name="_FormMuiTiem" model="Model" />
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="IndexTheoVaccine" asp-route-maVaccine="@Model.MaVaccine" class="btn btn-link">Quay lại</a>
</form>
