@* Khu vực giao diện của view Index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<MuiTiemVaccine>
@{
    ViewData["Title"] = "Quản lý mũi tiêm vaccine";
}

<div class="list-page-head">
    <div>
        <h2>Quản lý mũi tiêm vaccine</h2>
        <p>@Model.Count mũi tiêm đang được cấu hình</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm mũi tiêm</a>
</div>

<section class="list-card">
@if (Model.Count == 0)
{
    <div class="empty-state">Chưa có dữ liệu mũi tiêm.</div>
}
else
{
<table class="table list-table">
    <thead>
        <tr>
            <th>Vaccine</th>
            <th>Mũi</th>
            <th>Lịch khuyến nghị</th>
            <th>Khoảng cách</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        var tuoiKhuyenNghi = item.DoTuoiKhuyenNghi.HasValue
            ? $"{item.DoTuoiKhuyenNghi} {item.DonViTuoi}"
            : "Chưa cấu hình";
        var khoangCach = item.KhoangCachNgay.HasValue && item.KhoangCachNgay.Value > 0
            ? $"{item.KhoangCachNgay} ngày"
            : "Theo tuổi";
        <tr>
            <td>
                <div class="item-title">@item.TenVaccine</div>
                <div class="item-meta">Mã mũi #@item.MaMuiTiem</div>
            </td>
            <td>
                <span class="dose-pill">Mũi @item.SoMui</span>
                <div class="item-meta">@item.TenMui</div>
            </td>
            <td>@tuoiKhuyenNghi</td>
            <td><span class="soft-badge">@khoangCach</span></td>
            <td class="table-actions">
                <a asp-action="Details" asp-route-id="@item.MaMuiTiem" class="btn btn-sm btn-light">Chi tiết</a>
                <a asp-action="Edit" asp-route-id="@item.MaMuiTiem" class="btn btn-sm btn-outline-primary">Sửa</a>
                <a asp-action="Delete" asp-route-id="@item.MaMuiTiem" class="btn btn-sm btn-outline-danger">Xóa</a>
                <a asp-action="IndexTheoVaccine" asp-route-maVaccine="@item.MaVaccine" class="btn btn-sm btn-outline-info">Theo vaccine</a>
            </td>
        </tr>
    }
    </tbody>
</table>
}
</section>
