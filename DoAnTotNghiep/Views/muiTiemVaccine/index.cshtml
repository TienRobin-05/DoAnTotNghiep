@model List<muiTiemVaccineModels>
@{
    ViewData["Title"] = "Mũi tiêm vaccine";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mũi tiêm vaccine</h2>
    <a asp-action="them" class="btn btn-primary">Thêm mũi tiêm</a>
</div>

<table class="table table-bordered table-striped">
    <thead><tr><th>Vaccine</th><th>Số mũi</th><th>Tên mũi</th><th>Tuổi khuyến nghị</th><th>Khoảng cách ngày</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.tenVaccine</td>
            <td>@item.soMui</td>
            <td>@item.tenMui</td>
            <td>@item.doTuoiKhuyenNghi @item.donViTuoi</td>
            <td>@item.khoangCachNgay</td>
            <td><a asp-action="sua" asp-route-id="@item.maMuiTiem" class="btn btn-sm btn-outline-primary">Sửa</a></td>
        </tr>
    }
    </tbody>
</table>
