@* Khu vực giao diện của view IndexTheoVaccine.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<MuiTiemVaccine>
@{
    ViewData["Title"] = "Mũi tiêm theo vaccine";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mũi tiêm của vaccine: @ViewBag.TenVaccine</h2>
    <a asp-action="Create" asp-route-maVaccine="@ViewBag.MaVaccine" class="btn btn-primary">Thêm mũi tiêm</a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">@TempData["ThongBao"]</div>
}

@* Khu vực bảng dùng để hiển thị danh sách dữ liệu theo từng cột, giúp người dùng dễ theo dõi và thao tác. *@
<section class="card">
@if (Model.Count == 0)
{
    <div class="alert alert-info">Chưa có dữ liệu</div>
}
else
{
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Số mũi</th>
            <th>Tên mũi</th>
            <th>Độ tuổi tối thiểu</th>
            <th>Độ tuổi tối đa</th>
            <th>Độ tuổi khuyến nghị</th>
            <th>Đơn vị tuổi</th>
            <th>Khoảng cách ngày</th>
            <th>Ghi chú</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.SoMui</td>
            <td>@item.TenMui</td>
            <td>@item.DoTuoiToiThieu</td>
            <td>@item.DoTuoiToiDa</td>
            <td>@item.DoTuoiKhuyenNghi</td>
            <td>@item.DonViTuoi</td>
            <td>@item.KhoangCachNgay</td>
            <td>@item.GhiChu</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.MaMuiTiem" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                <a asp-action="Edit" asp-route-id="@item.MaMuiTiem" class="btn btn-sm btn-outline-primary">Sửa</a>
                <a asp-action="Delete" asp-route-id="@item.MaMuiTiem" class="btn btn-sm btn-outline-danger">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
}
</section>

<a asp-controller="Vaccine" asp-action="Index" class="btn btn-link">Quay lại danh sách vaccine</a>
