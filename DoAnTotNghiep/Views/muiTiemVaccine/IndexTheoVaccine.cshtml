@* Khu vực giao diện của view IndexTheoVaccine.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<MuiTiemVaccine>
@{
    ViewData["Title"] = "Mũi tiêm theo vaccine";
}

<div class="list-page-head">
    <div>
        <h2>@ViewBag.TenVaccine</h2>
        <p>@Model.Count mũi tiêm trong phác đồ</p>
    </div>
    <a asp-action="Create" asp-route-maVaccine="@ViewBag.MaVaccine" class="btn btn-primary">Thêm mũi tiêm</a>
</div>

<section class="list-card">
@if (Model.Count == 0)
{
    <div class="empty-state">Chưa có dữ liệu mũi tiêm cho vaccine này.</div>
}
else
{
<table class="table list-table">
    <thead>
        <tr>
            <th>Mũi tiêm</th>
            <th>Độ tuổi</th>
            <th>Khoảng cách</th>
            <th>Ghi chú</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        var doTuoi = item.DoTuoiToiThieu.HasValue || item.DoTuoiToiDa.HasValue
            ? $"{item.DoTuoiToiThieu?.ToString() ?? "0"} - {item.DoTuoiToiDa?.ToString() ?? "không giới hạn"} {item.DonViTuoi}"
            : "Chưa cấu hình";
        var tuoiKhuyenNghi = item.DoTuoiKhuyenNghi.HasValue
            ? $"Khuyến nghị: {item.DoTuoiKhuyenNghi} {item.DonViTuoi}"
            : "Chưa có tuổi khuyến nghị";
        var khoangCach = item.KhoangCachNgay.HasValue && item.KhoangCachNgay.Value > 0
            ? $"{item.KhoangCachNgay} ngày"
            : "Theo độ tuổi";
        var ghiChu = string.IsNullOrWhiteSpace(item.GhiChu) ? "Không có" : item.GhiChu;
        <tr>
            <td>
                <span class="dose-pill">Mũi @item.SoMui</span>
                <div class="item-title">@item.TenMui</div>
            </td>
            <td>
                <div>@doTuoi</div>
                <div class="item-meta">@tuoiKhuyenNghi</div>
            </td>
            <td><span class="soft-badge">@khoangCach</span></td>
            <td class="text-truncate-cell">@ghiChu</td>
            <td class="table-actions">
                <a asp-action="Details" asp-route-id="@item.MaMuiTiem" class="btn btn-sm btn-light">Chi tiết</a>
                <a asp-action="Edit" asp-route-id="@item.MaMuiTiem" class="btn btn-sm btn-outline-primary">Sửa</a>
                <button type="button"
                        class="btn btn-sm btn-outline-danger js-delete-confirm"
                        data-delete-url="@Url.Action("Delete", new { id = item.MaMuiTiem })"
                        data-delete-title="Xóa mũi tiêm">
                    Xóa
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>
}
</section>

<a asp-controller="Vaccine" asp-action="Index" class="btn btn-link mt-2">Quay lại danh sách vaccine</a>

<partial name="_ConfirmDeleteModal" />
