@model MuiTiemVaccine
@{
    ViewData["Title"] = "Chi tiết mũi tiêm";
}

<h2>Chi tiết mũi tiêm vaccine</h2>

<table class="table table-bordered col-md-8">
    <tr><th>Mã mũi tiêm</th><td>@Model.MaMuiTiem</td></tr>
    <tr><th>Vaccine</th><td>@Model.TenVaccine</td></tr>
    <tr><th>Số mũi</th><td>@Model.SoMui</td></tr>
    <tr><th>Tên mũi</th><td>@Model.TenMui</td></tr>
    <tr><th>Độ tuổi tối thiểu</th><td>@Model.DoTuoiToiThieu</td></tr>
    <tr><th>Độ tuổi tối đa</th><td>@Model.DoTuoiToiDa</td></tr>
    <tr><th>Độ tuổi khuyến nghị</th><td>@Model.DoTuoiKhuyenNghi</td></tr>
    <tr><th>Đơn vị tuổi</th><td>@Model.DonViTuoi</td></tr>
    <tr><th>Khoảng cách ngày</th><td>@Model.KhoangCachNgay</td></tr>
    <tr><th>Ghi chú</th><td style="white-space: pre-wrap">@Model.GhiChu</td></tr>
</table>

<a asp-action="Edit" asp-route-id="@Model.MaMuiTiem" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-link">Quay lại</a>
