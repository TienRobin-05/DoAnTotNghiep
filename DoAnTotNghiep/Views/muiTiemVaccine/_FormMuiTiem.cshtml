@* Khu vực giao diện của view _FormMuiTiem.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model MuiTiemVaccine

<div class="mb-3">
    <label asp-for="MaVaccine" class="form-label">Vaccine</label>
    @if (Model.MaVaccine > 0)
    {
        @* Mũi tiêm được quản lý theo vaccine đang chọn; hidden input giữ đúng maVaccine khi submit. *@
        <input type="hidden" name="MaVaccine" value="@Model.MaVaccine" />
        <select asp-for="MaVaccine" asp-items="ViewBag.DanhSachVaccine" class="form-select" disabled>
            <option value="0">-- Chọn vaccine --</option>
        </select>
    }
    else
    {
        <select asp-for="MaVaccine" asp-items="ViewBag.DanhSachVaccine" class="form-select">
            <option value="0">-- Chọn vaccine --</option>
        </select>
    }
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="SoMui" class="form-label">Số mũi</label>
        <input asp-for="SoMui" type="number" class="form-control" />
    </div>
    <div class="col-md-8 mb-3">
        <label asp-for="TenMui" class="form-label">Tên mũi</label>
        <input asp-for="TenMui" class="form-control" />
    </div>
</div>
<div class="row">
    <div class="col-md-3 mb-3">
        <label asp-for="DoTuoiToiThieu" class="form-label">Tuổi tối thiểu</label>
        <input asp-for="DoTuoiToiThieu" type="number" class="form-control" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="DoTuoiToiDa" class="form-label">Tuổi tối đa</label>
        <input asp-for="DoTuoiToiDa" type="number" class="form-control" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="DoTuoiKhuyenNghi" class="form-label">Tuổi khuyến nghị</label>
        <input asp-for="DoTuoiKhuyenNghi" type="number" class="form-control" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="DonViTuoi" class="form-label">Đơn vị tuổi</label>
        <select asp-for="DonViTuoi" class="form-select">
            <option value="">-- Chọn đơn vị --</option>
            <option value="ngày">ngày</option>
            <option value="tuần">tuần</option>
            <option value="tháng">tháng</option>
            <option value="năm">năm</option>
        </select>
    </div>
</div>
<div class="mb-3">
    <label asp-for="KhoangCachNgay" class="form-label">Khoảng cách ngày</label>
    <input asp-for="KhoangCachNgay" type="number" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="GhiChu" class="form-label">Ghi chú</label>
    <textarea asp-for="GhiChu" rows="4" class="form-control"></textarea>
</div>
