@model ThongTinCaNhanViewModel

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<section class="profile-page">
    <div class="profile-card">
        <h1>Thông tin cá nhân</h1>
        <p>Thông tin tài khoản đang đăng nhập.</p>

        <div class="mb-3">
            <label class="form-label">Họ tên</label>
            <input class="form-control" value="@Model.HoTen" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">Số điện thoại</label>
            <input class="form-control" value="@Model.SoDienThoai" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" value="@Model.Email" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">Giới tính</label>
            <input class="form-control" value="@Model.GioiTinh" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">Ngày tháng năm sinh</label>
            <input class="form-control" value="@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "")" readonly />
        </div>
    </div>
</section>
