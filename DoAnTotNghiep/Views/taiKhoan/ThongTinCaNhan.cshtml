@model ThongTinCaNhanViewModel

@{
    Layout = "_UserLayout";
    ViewData["Title"] = "Thông tin cá nhân";
}

<style>
    .profile-page {
        display: flex;
        justify-content: center;
        width: 100%;
        padding: 10px 0 56px;
    }

    .profile-card {
        width: min(100%, 960px);
        border: 1px solid #dbe7ec;
        border-radius: 8px;
        background: #ffffff;
        padding: 32px 36px;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.08);
    }

    .profile-header {
        margin-bottom: 26px;
        padding-bottom: 18px;
        border-bottom: 1px solid #edf2f5;
    }

    .profile-header h1 {
        margin: 0 0 8px;
        color: #0f172a;
        font-size: 30px;
        font-weight: 850;
        line-height: 1.2;
    }

    .profile-header p {
        margin: 0;
        color: #64748b;
        font-size: 16px;
        font-weight: 650;
    }

    .profile-form {
        display: grid;
        gap: 18px;
        max-width: 760px;
    }

    .profile-field {
        display: grid;
        gap: 8px;
    }

    .profile-field .form-label {
        margin: 0;
        color: #334155;
        font-size: 15px;
        font-weight: 750;
    }

    .profile-field .form-control,
    .profile-field .form-select {
        min-height: 46px;
        border: 1px solid #cfd8e6;
        border-radius: 8px;
        padding: 10px 12px;
        color: #1f2937;
        background: #ffffff;
        font-size: 15px;
    }

    .profile-field .form-control:focus,
    .profile-field .form-select:focus {
        border-color: #0b63ce;
        box-shadow: 0 0 0 3px rgba(11, 99, 206, 0.12);
    }

    .profile-field .form-control[readonly] {
        color: #64748b;
        background: #f1f5f9;
        cursor: not-allowed;
    }

    .profile-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 8px;
        padding-top: 8px;
    }

    .profile-actions .btn {
        min-height: 44px;
        border-radius: 8px;
        padding: 9px 16px;
        font-weight: 800;
    }

    .profile-actions .btn-primary {
        border-color: #0b63ce;
        background: #0b63ce;
        color: #ffffff;
    }

    .profile-actions .btn-secondary {
        border-color: #cbd5e1;
        background: #ffffff;
        color: #334155;
    }

    @@media (max-width: 640px) {
        .profile-page {
            padding-bottom: 32px;
        }

        .profile-card {
            padding: 24px 18px;
        }

        .profile-header h1 {
            font-size: 26px;
        }

        .profile-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .profile-actions .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

<section class="profile-page">
    <div class="profile-card">
        <div class="profile-header">
            <h1>Thông tin cá nhân</h1>
            <p>Cập nhật thông tin tài khoản đang đăng nhập.</p>
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger">@ViewBag.ThongBao</div>
        }

        <form asp-action="ThongTinCaNhan" method="post" class="profile-form">
            @Html.AntiForgeryToken()

            <div class="profile-field">
                <label asp-for="HoTen" class="form-label">Họ tên</label>
                <input asp-for="HoTen" class="form-control" autocomplete="name" />
            </div>

            <div class="profile-field">
                <label class="form-label">Số điện thoại</label>
                <input class="form-control" value="@Model.SoDienThoai" readonly />
            </div>

            <div class="profile-field">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
            </div>

            <div class="profile-field">
                <label asp-for="GioiTinh" class="form-label">Giới tính</label>
                <select asp-for="GioiTinh" class="form-select">
                    <option value="">Chọn giới tính</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>

            <div class="profile-field">
                <label asp-for="NgaySinh" class="form-label">Ngày tháng năm sinh</label>
                <input asp-for="NgaySinh" type="date" class="form-control" value="@(Model.NgaySinh?.ToString("yyyy-MM-dd") ?? "")" />
            </div>

            <div class="profile-actions">
                <button type="submit" class="btn btn-primary">Cập nhật thông tin</button>
                <a class="btn btn-secondary" href="javascript:history.back()">Quay lại</a>
            </div>
        </form>
    </div>
</section>
