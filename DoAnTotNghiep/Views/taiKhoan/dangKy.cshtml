@* Khu vực giao diện của view DangKy.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<h2>Đăng ký tài khoản</h2>

@* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
@if (ViewBag.ThongBao != null)
{
    @* Khu vực thông báo phản hồi kết quả xử lý, ví dụ thành công, lỗi nhập liệu hoặc lỗi nghiệp vụ. *@
    <div class="alert alert-danger">@ViewBag.ThongBao</div>
}

@* Khu vực form cho phép người dùng nhập dữ liệu và gửi request về Controller để xử lý. *@
<form method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Họ tên</label>
        <input name="hoTen" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input name="email" type="email" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Số điện thoại</label>
        <input name="soDienThoai" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Mật khẩu</label>
        <input name="matKhau" type="password" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Nhập lại mật khẩu</label>
        <input name="nhapLaiMatKhau" type="password" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Đăng ký</button>
    <a asp-action="DangNhap" class="btn btn-link">Đăng nhập</a>
</form>
