@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}

<section class="auth-card">
    <h1 class="auth-title">Đăng nhập</h1>
    <p class="auth-subtitle">Vui lòng đăng nhập để tiếp tục sử dụng hệ thống</p>

    @if (TempData["ThongBao"] != null)
    {
        <div class="auth-alert success">@TempData["ThongBao"]</div>
    }

    @if (ViewBag.ThongBao != null)
    {
        <div class="auth-alert error">@ViewBag.ThongBao</div>
    }

    <form method="post" autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Số điện thoại đăng nhập</label>
            <div class="input-box">
                <input
                    type="text"
                    name="soDienThoaiDangNhap"
                    id="soDienThoaiDangNhap"
                    autocomplete="off"
                    autocorrect="off"
                    autocapitalize="off"
                    spellcheck="false"
                    placeholder="Nhập số điện thoại" />
            </div>
        </div>

        <div class="form-group">
            <label>Mật khẩu</label>
            <div class="input-box">
                <input
                    type="password"
                    name="matKhauDangNhap"
                    id="matKhauDangNhap"
                    autocomplete="new-password"
                    placeholder="Nhập mật khẩu" />
            </div>
        </div>

        <div class="form-row">
            <a class="auth-link" asp-action="QuenMatKhau">Quên mật khẩu?</a>
        </div>

        <button type="submit" class="auth-button">Đăng nhập</button>

        <div class="auth-divider">hoặc</div>

        <div class="auth-switch">
            Chưa có tài khoản?
            <a class="auth-link" asp-action="DangKy">Đăng ký ngay</a>
        </div>
    </form>
</section>
