@* Trang chủ chính sau khi người dùng đăng nhập. *@
@{
    Layout = "_UserLayout";
    ViewData["Title"] = "Trang chủ người dùng";
    var hoTen = ViewBag.HoTen as string ?? "Người dùng";
    var soThongBaoChuaDoc = ViewBag.SoThongBaoChuaDoc is int soThongBao ? soThongBao : 0;
    var soMuiSapDenHan = ViewBag.SoMuiSapDenHan is int sapDenHan ? sapDenHan : 0;
    var soMuiHoanThanh = ViewBag.SoMuiHoanThanh is int hoanThanh ? hoanThanh : 0;
    var thongBaoMoiNhat = ViewBag.ThongBaoMoiNhat as List<ThongBao> ?? new List<ThongBao>();
    var danhSachHoSo = ViewBag.DanhSachHoSo as List<HoSoSucKhoe> ?? new List<HoSoSucKhoe>();
    var lichTiemSapToi = ViewBag.LichTiemSapToi as List<LichTiem> ?? new List<LichTiem>();
}

<style>
    .welcome {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: center;
    }
    .welcome h1 {
        margin: 0 0 8px;
        font-size: 28px;
    }
    .welcome p {
        margin: 0;
        color: #6b7280;
    }
    .today {
        color: #4b5563;
        text-align: right;
        line-height: 1.5;
    }
    .stats {
        margin-top: 20px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }
    .stat-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 20px;
    }
    .stat-title {
        color: #374151;
        font-weight: bold;
        margin-bottom: 10px;
    }
    .stat-number {
        font-size: 34px;
        color: #0b63ce;
        font-weight: bold;
    }
    .stat-note {
        color: #6b7280;
        margin-top: 4px;
    }
    .content {
        margin-top: 20px;
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 20px;
    }
    .right-column {
        display: grid;
        gap: 20px;
    }
    .status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 6px;
        background: #eef2f7;
        color: #374151;
        font-weight: bold;
    }
    .status-due { background: #fff2d8; color: #b45309; }
    .status-done { background: #dcfce7; color: #15803d; }
    .status-late { background: #fee2e2; color: #b91c1c; }
    .list {
        display: grid;
        gap: 12px;
    }
    .list-item {
        padding-bottom: 12px;
        border-bottom: 1px solid #e5e7eb;
    }
    .list-item:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }
    .list-item strong {
        display: block;
        margin-bottom: 4px;
    }
    .list-item span,
    .list-item small {
        color: #6b7280;
    }
    .profile-actions {
        margin-top: 8px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .note {
        margin-top: 20px;
        padding: 14px 18px;
        border-radius: 8px;
        background: #eaf4ff;
        color: #0b4f9c;
    }

    @@media (max-width: 900px) {
        .welcome { align-items: flex-start; flex-direction: column; }
        .today { text-align: left; }
        .stats { grid-template-columns: repeat(2, 1fr); }
        .content { grid-template-columns: 1fr; }
    }

    @@media (max-width: 600px) {
        .stats { grid-template-columns: 1fr; }
    }
</style>

<section class="card welcome">
    <div>
        <h1>Xin chào, @hoTen</h1>
        <p>Đây là trang tổng quan giúp bạn theo dõi hồ sơ, lịch tiêm và thông báo nhắc lịch.</p>
    </div>
    <div class="today">
        <div>@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</div>
        <div>@DateTime.Now.ToString("HH:mm")</div>
    </div>
</section>

<section class="stats">
    <article class="stat-card">
        <div class="stat-title">Hồ sơ sức khỏe</div>
        <div class="stat-number">@danhSachHoSo.Count</div>
        <div class="stat-note">Hồ sơ</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">Mũi sắp đến hạn</div>
        <div class="stat-number">@soMuiSapDenHan</div>
        <div class="stat-note">Mũi tiêm</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">Mũi đã hoàn thành</div>
        <div class="stat-number">@soMuiHoanThanh</div>
        <div class="stat-note">Mũi tiêm</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">Thông báo chưa đọc</div>
        <div class="stat-number">@soThongBaoChuaDoc</div>
        <div class="stat-note">Thông báo</div>
    </article>
</section>

<section class="content">
    <article class="card">
        <div class="section-head">
            <h2 class="section-title">Lịch tiêm sắp tới</h2>
            <a class="btn btn-primary" href="/LichTiem/ChonHoSo">Xem tất cả</a>
        </div>

        @if (lichTiemSapToi.Count == 0)
        {
            <div class="empty">Chưa có lịch tiêm sắp tới.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Hồ sơ</th>
                        <th>Vaccine</th>
                        <th>Mũi tiêm</th>
                        <th>Ngày dự kiến</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lich in lichTiemSapToi)
                    {
                        var cssTrangThai = lich.TrangThai == "Sắp đến hạn" ? "status-due" : lich.TrangThai == "Quá hạn" ? "status-late" : lich.TrangThai == "Đã tiêm" ? "status-done" : "";
                        <tr>
                            <td>@lich.HoTenHoSo</td>
                            <td>@lich.TenVaccine</td>
                            <td>@lich.TenMui</td>
                            <td>@lich.NgayTiemDuKien.ToString("dd/MM/yyyy")</td>
                            <td><span class="status @cssTrangThai">@lich.TrangThai</span></td>
                            <td><a class="btn" href="/LichTiem/CapNhatDaTiem?maLichTiem=@lich.MaLichTiem">Cập nhật</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </article>

    <div class="right-column">
        <article class="card">
            <div class="section-head">
                <h2 class="section-title">Thông báo gần đây</h2>
                <a class="btn" href="/ThongBao/Index">Xem tất cả</a>
            </div>
            @if (thongBaoMoiNhat.Count == 0)
            {
                <div class="empty">Bạn chưa có thông báo mới.</div>
            }
            else
            {
                <div class="list">
                    @foreach (var tb in thongBaoMoiNhat)
                    {
                        <a class="list-item" href="/ThongBao/Details/@tb.MaThongBao">
                            <strong>@tb.TieuDe</strong>
                            <span>@tb.NoiDung</span>
                            <small>@tb.NgayGui.ToString("dd/MM/yyyy HH:mm")</small>
                        </a>
                    }
                </div>
            }
        </article>

        <article class="card">
            <div class="section-head">
                <h2 class="section-title">Hồ sơ sức khỏe</h2>
                <a class="btn btn-primary" href="/HoSoSucKhoe/Create">Thêm hồ sơ</a>
            </div>
            @if (danhSachHoSo.Count == 0)
            {
                <div class="empty">Bạn chưa có hồ sơ sức khỏe.</div>
            }
            else
            {
                <div class="list">
                    @foreach (var hoSo in danhSachHoSo.Take(4))
                    {
                        <div class="list-item">
                            <strong>@hoSo.HoTen</strong>
                            <span>@hoSo.NgaySinh.ToString("dd/MM/yyyy") - @hoSo.GioiTinh</span>
                            <div class="profile-actions">
                                <a class="btn btn-primary" href="/LichTiem/Index?maHoSo=@hoSo.MaHoSo">Xem lịch</a>
                                <a class="btn" href="/HoSoSucKhoe/Edit/@hoSo.MaHoSo">Cập nhật</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    </div>
</section>

<div class="note">
    Lưu ý: Hãy cập nhật đầy đủ thông tin sức khỏe để hệ thống tạo lịch tiêm và nhắc lịch chính xác hơn.
</div>
