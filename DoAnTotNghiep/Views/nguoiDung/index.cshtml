<section class="dashboard-page">
    <section class="dashboard-hero">
        <div class="hero-copy">
            <div class="hero-eyebrow"><i class="bi bi-heart-pulse"></i> Pharmacy City</div>
            <h1><span>Chủ động sức khỏe -</span><span>Đúng hẹn tiêm chủng</span></h1>
            <p>Cùng theo dõi hồ sơ, lịch tiêm và nhắc lịch thông minh<br />cho bạn và gia đình trong một dashboard y tế hiện đại.</p>
        </div>
        <div class="hero-visual">
            <img src="/images/hero/health-hero.png" alt="Minh họa hồ sơ sức khỏe, vaccine và lịch tiêm chủng" />
        </div>
        <div class="reminder-card">
            <a class="reminder-card-link" href="/LichTiem/ChonHoSo" aria-label="Xem lịch tiêm"></a>
            <div class="reminder-head"><div class="reminder-title"><i class="bi bi-bell-fill"></i><span>Tự động nhắc lịch</span></div><label class="switch" for="tuDongNhacLichSwitch" aria-label="Tự động nhắc lịch"><input type="checkbox" id="tuDongNhacLichSwitch" checked /><span aria-hidden="true"></span></label></div>
            <div class="reminder-date"><i class="bi bi-calendar-event"></i><span>@ngayHienTai</span><i class="reminder-arrow bi bi-arrow-right-short"></i></div>
        </div>
    </section>

    <section class="dashboard-stats" aria-label="Thống kê nhanh">
        <article class="stat-card stat-blue"><i class="stat-icon bi bi-people-fill"></i><div><strong>Hồ sơ của tôi</strong><div class="stat-value">@danhSachHoSo.Count</div><span>Hồ sơ sức khỏe</span></div><i class="stat-trend bi bi-arrow-up-right"></i></article>
        <article class="stat-card stat-green"><i class="stat-icon bi bi-calendar-event"></i><div><strong>Lịch sắp tới</strong><div class="stat-value">@soMuiSapToi</div><span>Mũi tiêm sắp tới</span></div><i class="stat-trend bi bi-arrow-up-right"></i></article>
        <article class="stat-card stat-purple"><i class="stat-icon bi bi-shield-check"></i><div><strong>Mũi đã hoàn thành</strong><div class="stat-value">@soMuiHoanThanh</div><span>Mũi đã tiêm</span></div><i class="stat-trend bi bi-arrow-up-right"></i></article>
        <article class="stat-card stat-orange"><i class="stat-icon bi bi-capsule-pill"></i><div><strong>Tổng số vaccine</strong><div class="stat-value">@tongSoVaccine</div><span>Vaccine trong hệ thống</span></div><i class="stat-trend bi bi-arrow-up-right"></i></article>
    </section>

    <section class="dashboard-cta">
        <div class="cta-copy"><span class="cta-icon"><i class="bi bi-folder-plus"></i></span><div><h2>Thêm hồ sơ sức khỏe để bắt đầu</h2><p>Tạo hồ sơ đầu tiên để hệ thống tự lập lịch tiêm và theo dõi nhắc lịch cho bạn.</p></div></div>
        <a class="primary-action" href="/HoSoSucKhoe/Create"><i class="bi bi-plus-lg"></i> Thêm hồ sơ mới</a>
    </section>

    <section class="dashboard-main-grid">
        <div class="dashboard-left">
        <article class="dashboard-panel vaccination-schedule-card">
            <div class="panel-head"><div class="panel-title"><i class="bi bi-calendar2-week"></i><div><h2>Lịch tiêm</h2></div></div></div>
            <div class="schedule-tabs" aria-label="Bộ lọc lịch tiêm">
                <a class="active" href="/LichTiem/ChonHoSo">Tất cả (@(soMuiQuaHan + soMuiHomNay + soMuiSapToi + soMuiHoanThanh))</a>
                <a href="/LichTiem/ChonHoSo">Sắp tới (@soMuiSapToi)</a>
                <a href="/LichTiem/ChonHoSo">Quá hạn (@soMuiQuaHan)</a>
                <a href="/LichSuTiem/ChonHoSo">Đã hoàn thành (@soMuiHoanThanh)</a>
            </div>
            <div class="schedule-body">
                <a class="schedule-state late" href="/LichTiem/ChonHoSo"><span class="state-icon"><i class="bi bi-alarm"></i></span><span class="state-content"><strong>Quá hạn (@soMuiQuaHan)</strong>@if (lichTiemQuaHan.Count == 0){<p>Không có mũi quá hạn.</p>}else{<p>Cần cập nhật các mũi đã quá ngày dự kiến.</p><ul>@foreach (var lich in lichTiemQuaHan.Take(3)){<li><b>@lich.TenVaccine</b><span>@lich.TenMui - @lich.HoTenHoSo</span><em>Quá hạn</em><span>@lich.NgayTiemDuKien.ToString("dd/MM/yyyy")</span></li>}</ul>}</span><i class="state-arrow bi bi-chevron-right"></i></a>
                <a class="schedule-state today" href="/LichTiem/ChonHoSo"><span class="state-icon"><i class="bi bi-hourglass-split"></i></span><span class="state-content"><strong>Hôm nay (@soMuiHomNay)</strong>@if (lichTiemHomNay.Count == 0){<p>Hôm nay chưa có lịch tiêm.</p>}else{<p>Các mũi cần thực hiện trong hôm nay.</p><ul>@foreach (var lich in lichTiemHomNay.Take(3)){<li><b>@lich.TenVaccine</b><span>@lich.TenMui - @lich.HoTenHoSo</span><em>Hôm nay</em><span>@lich.NgayTiemDuKien.ToString("dd/MM/yyyy")</span></li>}</ul>}</span><i class="state-arrow bi bi-chevron-right"></i></a>
                <a class="schedule-state upcoming" href="/LichTiem/ChonHoSo"><span class="state-icon"><i class="bi bi-syringe"></i></span><span class="state-content"><strong>Sắp tới (@soMuiSapToi)</strong>@if (lichTiemSapToi.Count == 0){<p>Chưa có lịch sắp tới.</p>}else{<p>Các mũi tiêm sắp đến hạn.</p><ul>@foreach (var lich in lichTiemSapToi.Take(3)){<li><b>@lich.TenVaccine</b><span>@lich.TenMui - @lich.HoTenHoSo</span><em>Sắp tới</em><span>@lich.NgayTiemDuKien.ToString("dd/MM/yyyy")</span></li>}</ul>}</span><i class="state-arrow bi bi-chevron-right"></i></a>
                <a class="schedule-state completed" href="/LichSuTiem/ChonHoSo"><span class="state-icon"><i class="bi bi-check2-circle"></i></span><span class="state-content"><strong>Đã hoàn thành (@soMuiHoanThanh)</strong><p>Xem lại các mũi tiêm đã hoàn thành trong lịch sử tiêm chủng.</p></span><i class="state-arrow bi bi-chevron-right"></i></a>
            </div>
        </article>

        <section class="health-news-section" aria-label="Cẩm nang và tin tức sức khỏe">
            <header class="health-news-heading">
                <h2>CẨM NANG &amp; TIN TỨC SỨC KHỎE</h2>
                <p>Cập nhật thông tin y tế mới nhất và những kiến thức hữu ích</p>
            </header>

            @if (baiVietNoiBat.Count > 0)
            {
                <section class="health-news-slider" aria-label="Bài viết nổi bật">
                    <div class="swiper health-news-swiper">
                        <div class="swiper-wrapper">
                            @for (var i = 0; i < baiVietNoiBat.Count; i++)
                            {
                                var baiViet = baiVietNoiBat[i];
                                <article class="swiper-slide">
                                    <div class="featured-news-slide">
                                        <div class="featured-news-copy">
                                            <span class="featured-news-badge">CẨM NANG NỔI BẬT</span>
                                            <h3>@baiViet.TieuDe</h3>
                                            <p>@RutGonBaiViet(baiViet.NoiDung, 210)</p>
                                            <a class="featured-news-action" href="/BaiVietCamNang/Details?maBaiViet=@baiViet.MaBaiViet">Xem chi tiết</a>
                                        </div>
                                        <div class="featured-news-image">
                                            <img src="@AnhBaiViet(baiViet, i)" alt="@baiViet.TieuDe" />
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                        <div class="swiper-button-prev" aria-label="Bài trước"></div>
                        <div class="swiper-button-next" aria-label="Bài tiếp theo"></div>
                        <div class="swiper-pagination"></div>
                    </div>
                </section>
            }
            else
            {
                <div class="health-news-empty">Chưa có bài viết nổi bật để hiển thị.</div>
            }
        </section>
        </div>

        <div class="dashboard-right">
            <article class="dashboard-panel recent-notification-card">
                <div class="panel-head"><div class="panel-title"><i class="bi bi-megaphone"></i><div><h2>Thông báo gần đây</h2><p>Hiển thị thông báo trong 10 ngày gần nhất</p></div></div><a class="head-link" href="/ThongBao/Index">Xem tất cả</a></div>
                @if (thongBaoMoiNhat.Count == 0){<div class="empty-visual"><i class="bi bi-bell"></i><strong>Chưa có thông báo gần đây.</strong><p>Bạn sẽ nhận được thông báo mới tại đây.</p></div>}else{<div class="soft-list">@for (var i = 0; i < thongBaoMoiNhat.Count; i++){var tb = thongBaoMoiNhat[i]; var hiddenClass = i >= 3 ? "notification-hidden" : string.Empty;<a class="notification-item recent-notification-item @hiddenClass" href="/ThongBao/Details/@tb.MaThongBao"><span class="notification-icon"><i class="bi bi-bell"></i></span><span class="notification-content"><strong>@tb.TieuDe</strong><span>@RutGon(tb.NoiDung)</span></span><small class="notice-time">@tb.NgayGui.ToString("dd/MM HH:mm")</small><span class="notice-dot"></span></a>}</div>@if (thongBaoMoiNhat.Count > 3){<div class="recent-notification-more"><button type="button" id="btnXemThemThongBao">Xem thêm</button></div>}}
            </article>

            <article class="dashboard-panel health-profile-card">
                <div class="panel-head"><div class="panel-title"><i class="bi bi-clipboard2-pulse"></i><div><h2>Hồ sơ sức khỏe</h2></div></div><a class="head-link" href="/HoSoSucKhoe/Index">Xem tất cả</a></div>
                @if (danhSachHoSo.Count == 0){<div class="empty-visual green"><i class="bi bi-journal-medical"></i><strong>Bạn chưa có hồ sơ sức khỏe.</strong><p>Tạo hồ sơ để bắt đầu theo dõi và quản lý sức khỏe.</p><a class="secondary-action" href="/HoSoSucKhoe/Create"><i class="bi bi-plus-lg"></i> Thêm hồ sơ mới</a></div>}else{<div class="soft-list">@foreach (var hoSo in danhSachHoSo.Take(7)){<div class="profile-item"><span class="avatar" aria-hidden="true"><i class="bi bi-person-fill"></i></span><span class="profile-info"><strong>@hoSo.HoTen</strong><span>@hoSo.NgaySinh.ToString("dd/MM/yyyy") - @hoSo.GioiTinh</span></span><a class="secondary-action" href="/LichTiem/Index?maHoSo=@hoSo.MaHoSo">Xem hồ sơ</a></div>}<a class="secondary-action" href="/HoSoSucKhoe/Create"><i class="bi bi-plus-lg"></i> Thêm hồ sơ mới</a></div>}
            </article>
        </div>
    </section>

</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("btnXemThemThongBao");
        if (btn) {
            btn.addEventListener("click", function () {
                document.querySelectorAll(".recent-notification-item.notification-hidden").forEach(function (item) { item.classList.remove("notification-hidden"); });
                btn.style.display = "none";
            });
        }

        if (window.Swiper && document.querySelector(".health-news-swiper")) {
            new Swiper(".health-news-swiper", {
                loop: true,
                speed: 650,
                autoplay: {
                    delay: 5000,
                    disableOnInteraction: false,
                    pauseOnMouseEnter: true
                },
                pagination: {
                    el: ".health-news-swiper .swiper-pagination",
                    clickable: true
                },
                navigation: {
                    nextEl: ".health-news-swiper .swiper-button-next",
                    prevEl: ".health-news-swiper .swiper-button-prev"
                }
            });
        }
    });
</script>
