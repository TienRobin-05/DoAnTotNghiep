@{
    Layout = "_UserLayout";
    ViewData["Title"] = "Trang người dùng";

    var hoTen = ViewBag.HoTen as string ?? "Người dùng";
    var soMuiQuaHan = ViewBag.SoMuiQuaHan is int quaHan ? quaHan : 0;
    var soMuiHomNay = ViewBag.SoMuiHomNay is int homNay ? homNay : 0;
    var soMuiSapToi = ViewBag.SoMuiSapDenHan is int sapToi ? sapToi : 0;

    var lichTiemQuaHan = ViewBag.LichTiemQuaHan as List<LichTiem> ?? new List<LichTiem>();
    var lichTiemHomNay = ViewBag.LichTiemHomNay as List<LichTiem> ?? new List<LichTiem>();
    var lichTiemSapToi = ViewBag.LichTiemSapToi as List<LichTiem> ?? new List<LichTiem>();
    var thongBaoMoiNhat = ViewBag.ThongBaoMoiNhat as List<ThongBao> ?? new List<ThongBao>();
    var danhSachHoSo = ViewBag.DanhSachHoSo as List<HoSoSucKhoe> ?? new List<HoSoSucKhoe>();

    string RutGon(string noiDung, int doDai = 86)
    {
        if (string.IsNullOrWhiteSpace(noiDung))
        {
            return string.Empty;
        }

        var ketQua = noiDung.Trim()
            .Replace("Hồ sơ ", "")
            .Replace("vaccine ", "")
            .Replace("Vui lòng ", "");

        var viTri = ketQua.IndexOf("Khoảng cách", StringComparison.OrdinalIgnoreCase);
        if (viTri >= 0)
        {
            ketQua = ketQua[..viTri].Trim();
        }

        return ketQua.Length <= doDai ? ketQua : ketQua[..doDai].TrimEnd() + "...";
    }

    string LayChuCai(string hoTenHoSo)
    {
        if (string.IsNullOrWhiteSpace(hoTenHoSo))
        {
            return "HS";
        }

        var cacTu = hoTenHoSo.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (cacTu.Length == 1)
        {
            return cacTu[0].Length >= 2 ? cacTu[0][..2].ToUpperInvariant() : cacTu[0].ToUpperInvariant();
        }

        return $"{cacTu[^2][0]}{cacTu[^1][0]}".ToUpperInvariant();
    }

    string LopMauHoSo(string hoTenHoSo)
    {
        return hoTenHoSo switch
        {
            "Bé Khôi" => "profile-color-1",
            "Mẹ Hoa" => "profile-color-2",
            "Bố Minh" => "profile-color-3",
            "Bé Bình" => "profile-color-4",
            "Lan Anh" => "profile-color-5",
            "Bé An" => "profile-color-1",
            _ => "profile-color-default"
        };
    }
}

<style>
    .page {
        max-width: 1540px;
    }

    .home-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 16px;
    }

    .home-header h1 {
        margin: 0 0 6px;
        color: #111827;
        font-size: 24px;
        font-weight: 800;
    }

    .home-header p,
    .home-date {
        margin: 0;
        color: #64748b;
    }

    .home-name {
        color: #0b63ce;
    }

    .home-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 400px;
        gap: 16px;
        align-items: start;
    }

    .panel {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 6px 18px rgba(15, 42, 77, 0.06);
        overflow: hidden;
    }

    .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        border-bottom: 1px solid #eef2f7;
    }

    .panel-head h2 {
        margin: 0;
        color: #111827;
        font-size: 19px;
        font-weight: 800;
    }

    .head-link {
        color: #0b63ce;
        font-weight: 700;
        white-space: nowrap;
    }

    .schedule-body {
        padding: 14px 16px 16px;
    }

    .schedule-group {
        margin-bottom: 18px;
    }

    .schedule-group:last-child {
        margin-bottom: 0;
    }

    .group-title {
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 800;
    }

    .title-late {
        color: #dc2626;
    }

    .title-today {
        color: #ca8a04;
    }

    .title-upcoming {
        color: #16a34a;
    }

    .schedule-table {
        width: 100%;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }

    .schedule-table table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 14px;
    }

    .col-profile {
        width: 16%;
    }

    .col-vaccine {
        width: 17%;
    }

    .col-dose {
        width: 17%;
    }

    .col-date {
        width: 18%;
    }

    .col-status {
        width: 17%;
    }

    .col-action {
        width: 15%;
    }

    .schedule-table th,
    .schedule-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #eef2f7;
        text-align: left;
        vertical-align: middle;
        overflow-wrap: anywhere;
    }

    .schedule-table tr:last-child td {
        border-bottom: 0;
    }

    .schedule-table th {
        color: #334155;
        background: #f8fafc;
        font-size: 14px;
        font-weight: 700;
    }

    .table-late th {
        background: #f8fafc;
    }

    .table-today th {
        background: #fffbeb;
    }

    .table-upcoming th {
        background: #f0fdf4;
    }

    .date-late {
        color: #dc2626;
        font-weight: 800;
    }

    .date-today {
        color: #ca8a04;
        font-weight: 800;
    }

    .date-upcoming {
        color: #111827;
        font-weight: 800;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 78px;
        padding: 4px 9px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

    .badge-late {
        color: #dc2626;
        background: #fee2e2;
    }

    .badge-today {
        color: #a16207;
        background: #fef3c7;
    }

    .badge-upcoming {
        color: #15803d;
        background: #dcfce7;
    }

    .badge-not-injected,
    .badge-muted {
        color: #475569;
        background: #e2e8f0;
    }

    .badge-done {
        color: #166534;
        background: #dcfce7;
    }

    .badge-advice {
        color: #a16207;
        background: #fef3c7;
    }

    .profile-name {
        color: #0b63ce;
        font-weight: 700;
    }

    .group-link {
        display: inline-block;
        margin-top: 9px;
        font-size: 14px;
        font-weight: 700;
    }

    .link-late {
        color: #0b63ce;
    }

    .link-today {
        color: #ca8a04;
    }

    .link-upcoming {
        color: #16a34a;
    }

    .empty-row {
        padding: 12px;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        color: #64748b;
        background: #ffffff;
    }

    .side-column {
        display: grid;
        gap: 14px;
    }

    .side-list {
        display: grid;
    }

    .notice-item,
    .profile-item {
        display: grid;
        gap: 10px;
        align-items: center;
        padding: 12px 14px;
        border-bottom: 1px solid #eef2f7;
        color: inherit;
    }

    .notice-item {
        grid-template-columns: 12px minmax(0, 1fr) auto;
        gap: 8px;
    }

    .profile-item {
        grid-template-columns: 38px minmax(0, 1fr) auto;
    }

    .notice-item:last-child,
    .profile-item:last-child {
        border-bottom: 0;
    }

    .avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 50%;
        font-size: 13px;
        font-weight: 800;
        flex: 0 0 auto;
        overflow: hidden;
        justify-self: center;
    }

    .notice-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #dbeafe;
        justify-self: center;
    }

    .notice-item:nth-child(1) .notice-dot {
        background: #fee2e2;
    }

    .notice-item:nth-child(2) .notice-dot {
        background: #ffedd5;
    }

    .notice-item:nth-child(3) .notice-dot {
        background: #dcfce7;
    }

    .notice-item:nth-child(4) .notice-dot {
        background: #dbeafe;
    }

    .avatar {
        color: #0b63ce;
        background: #eaf4ff;
    }

    .profile-item:nth-child(1) .avatar {
        color: #be123c;
        background: #ffe4e6;
    }

    .profile-item:nth-child(2) .avatar {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .profile-item:nth-child(3) .avatar {
        color: #15803d;
        background: #dcfce7;
    }

    .profile-item:nth-child(4) .avatar {
        color: #7c3aed;
        background: #ede9fe;
    }

    .profile-item:nth-child(5) .avatar {
        color: #b45309;
        background: #fef3c7;
    }

    .notice-item strong,
    .profile-item strong {
        display: block;
        margin-bottom: 3px;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
    }

    .notice-content span,
    .profile-info span {
        display: -webkit-box;
        overflow: hidden;
        color: #64748b;
        font-size: 13px;
        line-height: 1.4;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .notice-content span {
        max-height: 39px;
    }

    .notice-time {
        color: #94a3b8;
        font-size: 11px;
        white-space: nowrap;
    }

    .profile-item .btn {
        white-space: nowrap;
    }

    .add-profile {
        display: block;
        margin: 12px 14px 14px;
        text-align: center;
    }

    .home-header .btn,
    .home-grid .btn {
        font-size: 14px;
        font-weight: 700;
    }

    .home-header .btn-sm,
    .home-grid .btn-sm {
        padding: 6px 10px;
        font-size: 13px;
    }

    .home-grid .btn-outline-warning {
        color: #a16207;
        border-color: #eab308;
    }

    @@media (max-width: 1050px) {
        .home-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 420px) {
        .profile-item,
        .notice-item {
            grid-template-columns: 38px minmax(0, 1fr);
        }

        .notice-item {
            grid-template-columns: 12px minmax(0, 1fr);
        }

        .profile-item .btn,
        .notice-time {
            grid-column: 2;
            justify-self: start;
        }
    }

    @@media (max-width: 760px) {
        .home-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .schedule-table {
            overflow-x: auto;
        }

        .schedule-table table {
            min-width: 720px;
        }
    }
</style>

<section class="home-header">
    <div>
        <h1>Xin chào, <span class="home-name">@hoTen</span></h1>
        <p>Cùng theo dõi sức khỏe và lịch tiêm của bạn và gia đình.</p>
    </div>
    <div class="home-date">@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</div>
</section>

<section class="home-grid">
    <article class="panel">
        <div class="panel-head">
            <h2>Lịch tiêm</h2>
        </div>

        <div class="schedule-body">
            <div class="schedule-group">
                <h3 class="group-title title-late">Quá hạn (@soMuiQuaHan)</h3>
                @if (lichTiemQuaHan.Count == 0)
                {
                    <div class="empty-row">Không có mũi quá hạn.</div>
                }
                else
                {
                    <div class="schedule-table table-late">
                        <table>
                            <colgroup>
                                <col class="col-profile" />
                                <col class="col-vaccine" />
                                <col class="col-dose" />
                                <col class="col-date" />
                                <col class="col-status" />
                                <col class="col-action" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Hồ sơ</th>
                                    <th>Vaccine</th>
                                    <th>Mũi</th>
                                    <th>Ngày dự kiến</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lich in lichTiemQuaHan)
                                {
                                    <tr>
                                        <td><span class="profile-name @LopMauHoSo(lich.HoTenHoSo)">@lich.HoTenHoSo</span></td>
                                        <td>@lich.TenVaccine</td>
                                        <td>@lich.TenMui</td>
                                        <td class="date-late">@lich.NgayTiemDuKien.ToString("dd/MM/yyyy")</td>
                                        <td><span class="status-badge badge-late">Quá hạn</span></td>
                                        <td><a class="btn btn-sm btn-outline-danger" href="/LichTiem/CapNhatDaTiem?maLichTiem=@lich.MaLichTiem">Cập nhật</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <a class="group-link link-late" href="/LichTiem/ChonHoSo">Xem tất cả (@soMuiQuaHan)</a>
                }
            </div>

            <div class="schedule-group">
                <h3 class="group-title title-today">Hôm nay (@soMuiHomNay)</h3>
                @if (lichTiemHomNay.Count == 0)
                {
                    <div class="empty-row">Hôm nay chưa có lịch tiêm.</div>
                }
                else
                {
                    <div class="schedule-table table-today">
                        <table>
                            <colgroup>
                                <col class="col-profile" />
                                <col class="col-vaccine" />
                                <col class="col-dose" />
                                <col class="col-date" />
                                <col class="col-status" />
                                <col class="col-action" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Hồ sơ</th>
                                    <th>Vaccine</th>
                                    <th>Mũi</th>
                                    <th>Ngày dự kiến</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lich in lichTiemHomNay)
                                {
                                    <tr>
                                        <td><span class="profile-name @LopMauHoSo(lich.HoTenHoSo)">@lich.HoTenHoSo</span></td>
                                        <td>@lich.TenVaccine</td>
                                        <td>@lich.TenMui</td>
                                        <td class="date-today">@lich.NgayTiemDuKien.ToString("dd/MM/yyyy")</td>
                                        <td><span class="status-badge badge-today">Hôm nay</span></td>
                                        <td><a class="btn btn-sm btn-outline-warning" href="/LichTiem/CapNhatDaTiem?maLichTiem=@lich.MaLichTiem">Cập nhật</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <a class="group-link link-today" href="/LichTiem/ChonHoSo">Xem tất cả (@soMuiHomNay)</a>
                }
            </div>

            <div class="schedule-group">
                <h3 class="group-title title-upcoming">Sắp tới (@soMuiSapToi)</h3>
                @if (lichTiemSapToi.Count == 0)
                {
                    <div class="empty-row">Chưa có lịch sắp tới.</div>
                }
                else
                {
                    <div class="schedule-table table-upcoming">
                        <table>
                            <colgroup>
                                <col class="col-profile" />
                                <col class="col-vaccine" />
                                <col class="col-dose" />
                                <col class="col-date" />
                                <col class="col-status" />
                                <col class="col-action" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Hồ sơ</th>
                                    <th>Vaccine</th>
                                    <th>Mũi</th>
                                    <th>Ngày dự kiến</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lich in lichTiemSapToi)
                                {
                                    <tr>
                                        <td><span class="profile-name @LopMauHoSo(lich.HoTenHoSo)">@lich.HoTenHoSo</span></td>
                                        <td>@lich.TenVaccine</td>
                                        <td>@lich.TenMui</td>
                                        <td class="date-upcoming">@lich.NgayTiemDuKien.ToString("dd/MM/yyyy")</td>
                                        <td><span class="status-badge badge-upcoming">Sắp tới</span></td>
                                        <td><a class="btn btn-sm btn-outline-primary" href="/LichTiem/Index?maHoSo=@lich.MaHoSo">Chi tiết</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <a class="group-link link-upcoming" href="/LichTiem/ChonHoSo">Xem tất cả (@soMuiSapToi)</a>
                }
            </div>
        </div>
    </article>

    <div class="side-column">
        <article class="panel">
            <div class="panel-head">
                <h2>Thông báo gần đây</h2>
                <a class="head-link" href="/ThongBao/Index">Xem tất cả</a>
            </div>

            @if (thongBaoMoiNhat.Count == 0)
            {
                <div class="empty-row" style="margin: 14px;">Chưa có thông báo.</div>
            }
            else
            {
                <div class="side-list">
                    @foreach (var tb in thongBaoMoiNhat)
                    {
                        <a class="notice-item" href="/ThongBao/Details/@tb.MaThongBao">
                            <span class="notice-dot"></span>
                            <span class="notice-content">
                                <strong>@tb.TieuDe</strong>
                                <span>@RutGon(tb.NoiDung)</span>
                            </span>
                            <small class="notice-time">@tb.NgayGui.ToString("HH:mm")</small>
                        </a>
                    }
                </div>
            }
        </article>

        <article class="panel">
            <div class="panel-head">
                <h2>Hồ sơ</h2>
                <a class="head-link" href="/HoSoSucKhoe/Index">Xem tất cả</a>
            </div>

            @if (danhSachHoSo.Count == 0)
            {
                <div class="empty-row" style="margin: 14px;">Bạn chưa có hồ sơ sức khỏe.</div>
            }
            else
            {
                <div class="side-list">
                    @foreach (var hoSo in danhSachHoSo.Take(5))
                    {
                        <div class="profile-item">
                            <span class="avatar">@LayChuCai(hoSo.HoTen)</span>
                            <span class="profile-info">
                                <strong>@hoSo.HoTen</strong>
                                <span>@hoSo.NgaySinh.ToString("dd/MM/yyyy") - @hoSo.GioiTinh</span>
                            </span>
                            <a class="btn btn-sm btn-outline-primary" href="/LichTiem/Index?maHoSo=@hoSo.MaHoSo">Xem hồ sơ</a>
                        </div>
                    }
                </div>
            }

            <a class="btn btn-sm btn-outline-primary add-profile" href="/HoSoSucKhoe/Create">+ Thêm hồ sơ mới</a>
        </article>
    </div>
</section>
