    .recent-notification-card,
    .health-profile-card {
        transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
    }

    .recent-notification-card .panel-title i,
    .health-profile-card .panel-title i {
        transition: transform .22s ease, box-shadow .22s ease;
    }

    .recent-notification-card:hover,
    .health-profile-card:hover {
        transform: translateY(-4px);
        border-color: #BFD8F6;
        box-shadow: 0 22px 44px rgba(23, 50, 92, .14);
    }

    .recent-notification-card:hover .panel-title i,
    .health-profile-card:hover .panel-title i {
        transform: scale(1.08);
        box-shadow: 0 12px 24px rgba(30, 99, 240, .16);
    }

    .dashboard-left {
        display: grid;
        min-width: 0;
        gap: 24px;
    }

    .health-news-section {
        display: grid;
        min-width: 0;
        gap: 22px;
        margin-top: 0;
        color: #0F172A;
    }

    .health-news-heading,
    .health-news-slider {
        border: 1px solid #DCE8FA;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 12px 26px rgba(15, 23, 42, .06);
    }

    .health-news-heading {
        padding: 20px;
    }

    .health-news-heading h2 {
        margin: 0 0 8px;
        color: #0F172A;
        font-size: 20px;
        font-weight: 900;
        letter-spacing: 0;
    }

    .health-news-heading p {
        margin: 0;
        color: #64748B;
        font-size: 15px;
        line-height: 1.55;
    }

    .health-news-slider {
        position: relative;
        overflow: hidden;
        height: 320px;
        margin-bottom: 18px;
        background: #F8FAFC;
    }

    .health-news-swiper,
    .health-news-swiper .swiper-wrapper,
    .health-news-swiper .swiper-slide {
        height: 100%;
    }

    .featured-news-slide {
        display: grid;
        grid-template-columns: 46% 54%;
        height: 100%;
        overflow: hidden;
    }

    .featured-news-copy {
        display: flex;
        min-width: 0;
        flex-direction: column;
        justify-content: center;
        padding: 22px;
        background: linear-gradient(135deg, #ffffff 0%, #F8FAFC 100%);
    }

    .featured-news-badge {
        width: fit-content;
        max-width: 100%;
        border-radius: 999px;
        color: #2563EB;
        background: #EAF2FF;
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .featured-news-badge {
        margin-bottom: 10px;
        padding: 6px 10px;
    }

    .featured-news-copy h3 {
        display: -webkit-box;
        margin: 0 0 12px;
        overflow: hidden;
        color: #0F172A;
        font-size: 21px;
        font-weight: 900;
        line-height: 1.28;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .featured-news-copy p {
        display: -webkit-box;
        margin: 0 0 20px;
        overflow: hidden;
        color: #475569;
        font-size: 13px;
        line-height: 1.55;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    .featured-news-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
        min-height: 38px;
        padding: 9px 13px;
        border-radius: 12px;
        color: #ffffff;
        background: #2563EB;
        font-weight: 850;
        box-shadow: 0 12px 20px rgba(37, 99, 235, .2);
    }

    .featured-news-action:hover {
        color: #ffffff;
        background: #1D4ED8;
    }

    .featured-news-image {
        min-width: 0;
        height: 100%;
        overflow: hidden;
        background: #EAF2FF;
    }

    .featured-news-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .health-news-slider .swiper-button-prev,
    .health-news-slider .swiper-button-next {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        color: #2563EB;
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 10px 20px rgba(15, 23, 42, .16);
    }

    .health-news-slider .swiper-button-prev::after,
    .health-news-slider .swiper-button-next::after {
        font-size: 13px;
        font-weight: 900;
    }

    .health-news-slider .swiper-pagination-bullet {
        width: 8px;
        height: 8px;
        background: #CBD5E1;
        opacity: 1;
    }

    .health-news-slider .swiper-pagination-bullet-active {
        width: 24px;
        border-radius: 999px;
        background: #2563EB;
    }

    .health-news-empty {
        padding: 28px;
        border: 1px dashed #CBD5E1;
        border-radius: 16px;
        color: #64748B;
        background: #F8FAFC;
        text-align: center;
        font-weight: 750;
    }

    @@media (max-width: 760px) {
        .health-news-heading {
            padding: 18px;
        }

        .health-news-slider {
            height: auto;
            margin-bottom: 0;
        }

        .featured-news-slide {
            display: flex;
            flex-direction: column-reverse;
        }

        .featured-news-image {
            height: 190px;
        }

        .featured-news-copy {
            padding: 20px;
        }

        .featured-news-copy h3 {
            font-size: 22px;
        }

        .health-news-slider .swiper-button-prev,
        .health-news-slider .swiper-button-next {
            width: 32px;
            height: 32px;
        }

    }

    :root {
        --pc-primary: #2563EB;
        --pc-secondary: #3B82F6;
        --pc-bg: #F5F9FF;
        --pc-card: #FFFFFF;
        --pc-border: #E2E8F0;
        --pc-success: #22C55E;
        --pc-warning: #F59E0B;
        --pc-danger: #EF4444;
        --pc-purple: #8B5CF6;
        --pc-text: #1E293B;
        --pc-muted: #64748B;
        --pc-blue-soft: #EFF6FF;
        --pc-green-soft: #ECFDF5;
        --pc-purple-soft: #F5F3FF;
        --pc-orange-soft: #FFF7ED;
        --pc-red-soft: #FEF2F2;
        --pc-shadow: 0 18px 42px rgba(37, 99, 235, .08);
        --pc-shadow-hover: 0 24px 54px rgba(30, 41, 59, .14);
    }

    body {
        background: var(--pc-bg);
    }

    .page {
        max-width: 1480px;
        padding: 24px 32px 32px;
    }

    .dashboard-page {
        gap: 24px;
        color: var(--pc-text);
    }

    .dashboard-hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 37fr) minmax(0, 40fr) minmax(240px, 23fr);
        min-height: 380px;
        gap: 24px;
        align-items: center;
        padding: 34px 40px;
        border: 1px solid #D9E8FF;
        border-radius: 28px;
        background:
            radial-gradient(circle at 47% 10%, rgba(125, 211, 252, .22) 0 70px, transparent 72px),
            radial-gradient(circle at 98% 3%, rgba(191, 219, 254, .42) 0 34px, transparent 36px),
            radial-gradient(circle at 88% 96%, rgba(147, 197, 253, .28) 0 86px, transparent 88px),
            linear-gradient(110deg, #FFFFFF 0%, #EEF7FF 45%, #DCEBFF 100%);
        box-shadow: var(--pc-shadow);
        overflow: hidden;
    }

    .dashboard-hero::before,
    .dashboard-hero::after {
        content: "";
        position: absolute;
