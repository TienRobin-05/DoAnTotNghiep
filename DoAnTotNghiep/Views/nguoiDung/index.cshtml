@{
    Layout = "_UserLayout";
    ViewData["Title"] = "Trang người dùng";

    var hoTen = ViewBag.HoTen as string ?? "Người dùng";
    var soMuiQuaHan = ViewBag.SoMuiQuaHan is int quaHan ? quaHan : 0;
    var soMuiHomNay = ViewBag.SoMuiHomNay is int homNay ? homNay : 0;
    var soMuiSapToi = ViewBag.SoMuiSapDenHan is int sapToi ? sapToi : 0;
    var soMuiHoanThanh = ViewBag.SoMuiHoanThanh is int hoanThanh ? hoanThanh : 0;
    var tongSoVaccine = ViewBag.TongSoVaccine is int soVaccine ? soVaccine : 0;
    var lichTiemQuaHan = ViewBag.LichTiemQuaHan as List<LichTiem> ?? new List<LichTiem>();
    var lichTiemHomNay = ViewBag.LichTiemHomNay as List<LichTiem> ?? new List<LichTiem>();
    var lichTiemSapToi = ViewBag.LichTiemSapToi as List<LichTiem> ?? new List<LichTiem>();
    var thongBaoMoiNhat = ViewBag.ThongBaoMoiNhat as List<ThongBao> ?? new List<ThongBao>();
    var danhSachHoSo = ViewBag.DanhSachHoSo as List<HoSoSucKhoe> ?? new List<HoSoSucKhoe>();
    var camNangTinTuc = ViewBag.CamNangTinTucDashboard as DashboardCamNangTinTucViewModel ?? new DashboardCamNangTinTucViewModel();
    var baiVietNoiBat = camNangTinTuc.BaiVietNoiBat;
    var baiVietMoiNhat = camNangTinTuc.BaiVietMoiNhat;
    var ngayHienTai = DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"));

    string RutGon(string noiDung, int doDai = 96)
    {
        if (string.IsNullOrWhiteSpace(noiDung)) return string.Empty;
        var ketQua = noiDung.Trim();
        return ketQua.Length <= doDai ? ketQua : ketQua[..doDai].TrimEnd() + "...";
    }

    string RutGonBaiViet(string noiDung, int doDai = 130)
    {
        if (string.IsNullOrWhiteSpace(noiDung)) return "Thông tin y tế hữu ích giúp bạn chủ động chăm sóc sức khỏe và theo dõi lịch tiêm.";
        var tomTat = noiDung.Replace("\r", " ").Replace("\n", " ").Trim();
        while (tomTat.Contains("  ")) tomTat = tomTat.Replace("  ", " ");
        return tomTat.Length <= doDai ? tomTat : tomTat[..doDai].TrimEnd() + "...";
    }

    string AnhBaiViet(BaiVietCamNang baiViet, int viTri = 0)
    {
        if (!string.IsNullOrWhiteSpace(baiViet.AnhDaiDien)) return baiViet.AnhDaiDien;
        var anhMacDinh = new[]
        {
            "/images/articles/lich-tiem-tre-nho.svg",
            "/images/articles/chuan-bi-truoc-tiem.svg",
            "/images/articles/theo-doi-sau-tiem.svg",
            "/images/articles/lich-su-tiem-chung.svg"
        };
        return anhMacDinh[viTri % anhMacDinh.Length];
    }
}

