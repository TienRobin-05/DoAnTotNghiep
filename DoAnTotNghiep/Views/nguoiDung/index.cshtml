        </div>
        <div class="hero-visual" aria-hidden="true">
            <div class="hero-circle"></div><span class="hero-leaf"><i class="bi bi-flower1"></i></span><span class="hero-family"><i class="bi bi-people-fill"></i></span><span class="hero-shield"><i class="bi bi-shield-check"></i></span><span class="hero-calendar"><i class="bi bi-calendar2-check"></i></span><span class="hero-vial"><i class="bi bi-capsule-pill"></i></span>
