@{
    ViewData["Title"] = "Trang quản trị";
}

<h2>Xin chào Admin @ViewBag.HoTen</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="border p-3"><strong>@ViewBag.SoTaiKhoan</strong><br />Tài khoản</div></div>
    <div class="col-md-3"><div class="border p-3"><strong>@ViewBag.SoVaccine</strong><br />Vaccine</div></div>
    <div class="col-md-3"><div class="border p-3"><strong>@ViewBag.SoLichTiem</strong><br />Lịch tiêm</div></div>
    <div class="col-md-3"><div class="border p-3"><strong>@ViewBag.SoCauHoiChoTraLoi</strong><br />Câu hỏi chờ trả lời</div></div>
</div>

<div class="list-group col-md-5">
    <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="taiKhoan">Quản lý tài khoản</a>
    <a class="list-group-item list-group-item-action" asp-controller="vaccine" asp-action="index">Quản lý vaccine</a>
    <a class="list-group-item list-group-item-action" asp-controller="muiTiemVaccine" asp-action="index">Quản lý mũi tiêm</a>
    <a class="list-group-item list-group-item-action" asp-controller="baiViet" asp-action="index">Quản lý bài viết</a>
    <a class="list-group-item list-group-item-action" asp-controller="cauHoiTuVan" asp-action="index">Quản lý câu hỏi tư vấn</a>
    <a class="list-group-item list-group-item-action" href="#">Thống kê</a>
    <a class="list-group-item list-group-item-action text-danger" asp-controller="TaiKhoan" asp-action="DangXuat">Đăng xuất</a>
</div>
