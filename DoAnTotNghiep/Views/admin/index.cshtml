@{
    ViewData["Title"] = "Trang quản trị";
    Layout = "_AdminLayout";

    var hoTen = ViewBag.HoTen as string ?? "Quản trị viên";
    var danhSachVaccine = ViewBag.DanhSachVaccine as List<Vaccine> ?? new List<Vaccine>();
    var cauHoiMoi = ViewBag.CauHoiMoi as List<CauHoiTuVan> ?? new List<CauHoiTuVan>();
    var baiVietMoi = ViewBag.BaiVietMoi as List<BaiVietCamNang> ?? new List<BaiVietCamNang>();
}

<section class="card welcome">
    <div>
        <h1>Xin chào, @hoTen</h1>
        <p>Đây là trang tổng quan dành cho quản trị viên.</p>
    </div>
    <div class="today">
        <div>@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</div>
        <div>@DateTime.Now.ToString("HH:mm")</div>
    </div>
</section>

<section class="stats">
    <article class="stat-card">
        <div class="stat-title">Tổng vaccine</div>
        <div class="stat-number">@(ViewBag.SoVaccine ?? 0)</div>
        <div class="stat-note">Vaccine</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">Tổng mũi tiêm</div>
        <div class="stat-number">@(ViewBag.SoMuiTiem ?? 0)</div>
        <div class="stat-note">Mũi tiêm</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">Bài viết cẩm nang</div>
        <div class="stat-number">@(ViewBag.SoBaiViet ?? 0)</div>
        <div class="stat-note">Bài viết</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">Câu hỏi chờ trả lời</div>
        <div class="stat-number">@(ViewBag.SoCauHoiChoTraLoi ?? 0)</div>
        <div class="stat-note">Câu hỏi</div>
    </article>
</section>

<section class="content">
    <article class="card">
        <div class="section-head">
            <h2 class="section-title">Danh mục vaccine</h2>
            <a class="btn btn-primary" href="/vaccine/create">Thêm vaccine</a>
        </div>

        @if (danhSachVaccine.Count == 0)
        {
            <div class="empty">Chưa có dữ liệu vaccine.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Tên vaccine</th>
                        <th>Nhóm</th>
                        <th>Độ tuổi áp dụng</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vaccine in danhSachVaccine)
                    {
                        <tr>
                            <td>@vaccine.TenVaccine</td>
                            <td>@(vaccine.NhomVaccine ?? "Chưa phân nhóm")</td>
                            <td>@HienThiDoTuoi(vaccine)</td>
                            <td>
                                @if (vaccine.TrangThai)
                                {
                                    <span class="status status-active">Đang dùng</span>
                                }
                                else
                                {
                                    <span class="status status-hide">Tạm ẩn</span>
                                }
                            </td>
                            <td><a class="btn btn-sm" href="/vaccine/edit/@vaccine.MaVaccine">Sửa</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </article>

    <div class="right-column">
        <article class="card">
            <div class="section-head">
                <h2 class="section-title">Câu hỏi tư vấn mới</h2>
                <a class="btn" href="/cauHoiTuVan/index">Xem tất cả</a>
            </div>

            @if (cauHoiMoi.Count == 0)
            {
                <div class="empty">Chưa có câu hỏi tư vấn.</div>
            }
            else
            {
                <div class="list">
                    @foreach (var cauHoi in cauHoiMoi)
                    {
                        <a class="list-item" href="/cauHoiTuVan/traLoi/@cauHoi.MaCauHoi">
                            <strong>@(cauHoi.TenNguoiGui ?? "Người dùng")</strong>
                            <span>@cauHoi.CauHoi</span><br />
                            <small>@cauHoi.NgayGui.ToString("dd/MM/yyyy HH:mm") - @cauHoi.TrangThai</small>
                        </a>
                    }
                </div>
            }
        </article>

        <article class="card">
            <div class="section-head">
                <h2 class="section-title">Bài viết cẩm nang</h2>
                <a class="btn" href="/AdminBaiViet/Index">Xem tất cả</a>
            </div>

            @if (baiVietMoi.Count == 0)
            {
                <div class="empty">Chưa có bài viết cẩm nang.</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Tiêu đề</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var baiViet in baiVietMoi)
                        {
                            <tr>
                                <td>@baiViet.TieuDe</td>
                                <td>
                                    @if (baiViet.TrangThai)
                                    {
                                        <span class="status status-active">Đã đăng</span>
                                    }
                                    else
                                    {
                                        <span class="status status-hide">Bản nháp</span>
                                    }
                                </td>
                                <td><a class="btn btn-sm" href="/AdminBaiViet/Edit?maBaiViet=@baiViet.MaBaiViet">Sửa</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </article>
    </div>
</section>

<div class="note">
    Lưu ý: Quản trị viên cần cập nhật đầy đủ vaccine, mũi tiêm, bài viết và phản hồi câu hỏi tư vấn để hệ thống hoạt động chính xác.
</div>

@functions {
    private static string HienThiDoTuoi(Vaccine vaccine)
    {
        if (vaccine.DoTuoiToiThieu == null && vaccine.DoTuoiToiDa == null)
        {
            return "Chưa nhập";
        }

        var donVi = string.IsNullOrWhiteSpace(vaccine.DonViTuoi) ? "tháng" : vaccine.DonViTuoi;
        if (vaccine.DoTuoiToiThieu != null && vaccine.DoTuoiToiDa != null)
        {
            return $"{vaccine.DoTuoiToiThieu}-{vaccine.DoTuoiToiDa} {donVi}";
        }

        if (vaccine.DoTuoiToiThieu != null)
        {
            return $"Từ {vaccine.DoTuoiToiThieu} {donVi}";
        }

        return $"Đến {vaccine.DoTuoiToiDa} {donVi}";
    }
}
