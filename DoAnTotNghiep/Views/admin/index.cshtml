@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "_AdminLayout";
}

<section class="admin-dashboard">
    <header class="dashboard-top">
        <div>
            <h1>Bảng điều khiển</h1>
            <p>Tổng quan hoạt động của hệ thống quản lý tiêm chủng.</p>
        </div>

        <div class="dashboard-tools">
            <label class="dashboard-search" aria-label="Tìm kiếm">
                <i class="bi bi-search"></i>
                <input type="search" placeholder="Tìm kiếm..." />
                <span>⌘ K</span>
            </label>
            <button type="button" class="notification-button" aria-label="Thông báo">
                <i class="bi bi-bell"></i>
                <span>3</span>
            </button>
            <details class="admin-user-menu">
                <summary>
                    <span class="admin-avatar"><i class="bi bi-person-fill"></i></span>
                    <span>
                        <strong>Quản trị viên</strong>
                        <small>Admin</small>
                    </span>
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <div class="admin-user-dropdown">
                    <a href="/TaiKhoan/DangXuat">Đăng xuất</a>
                </div>
            </details>
        </div>
    </header>

    <section class="dashboard-stats-grid" aria-label="Thống kê tổng quan">
        <article class="dashboard-stat-card blue">
            <span class="stat-icon"><i class="bi bi-shield-plus"></i></span>
            <span class="stat-copy">
                <span>Tổng vaccine</span>
                <strong>@Model.TotalVaccines.ToString("N0")</strong>
                <small>Vaccine</small>
                <a href="/vaccine/index">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
            </span>
        </article>
        <article class="dashboard-stat-card green">
            <span class="stat-icon"><i class="bi bi-syringe"></i></span>
            <span class="stat-copy">
                <span>Tổng mũi tiêm</span>
                <strong>@Model.TotalInjectionDoses.ToString("N0")</strong>
                <small>Mũi tiêm</small>
                <a href="/muiTiemVaccine/index">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
            </span>
        </article>
        <article class="dashboard-stat-card violet">
            <span class="stat-icon"><i class="bi bi-newspaper"></i></span>
            <span class="stat-copy">
                <span>Bài viết cẩm nang</span>
                <strong>@Model.TotalGuideArticles.ToString("N0")</strong>
                <small>Bài viết</small>
                <a href="/AdminBaiViet/Index">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
            </span>
        </article>
        <article class="dashboard-stat-card orange">
            <span class="stat-icon"><i class="bi bi-chat-dots"></i></span>
            <span class="stat-copy">
                <span>Câu hỏi chờ trả lời</span>
                <strong>@Model.PendingQuestions.ToString("N0")</strong>
                <small>Câu hỏi</small>
                <a href="/cauHoiTuVan/index">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
            </span>
        </article>
    </section>

    <section class="dashboard-main-grid">
        <div class="dashboard-column">
            <article class="dashboard-card vaccine-card">
                <div class="card-head">
                    <h2>Danh mục vaccine</h2>
                    <a class="primary-small" href="/vaccine/create"><i class="bi bi-plus-lg"></i> Thêm vaccine</a>
                </div>

                @if (Model.RecentVaccines.Count == 0)
                {
                    <div class="dashboard-empty">Chưa có dữ liệu vaccine.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="dashboard-table">
                            <thead>
                                <tr>
                                    <th>Tên vaccine</th>
                                    <th>Nhóm</th>
                                    <th>Độ tuổi áp dụng</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vaccine in Model.RecentVaccines)
                                {
                                    <tr>
                                        <td><strong>@vaccine.TenVaccine</strong></td>
                                        <td>@(string.IsNullOrWhiteSpace(vaccine.NhomVaccine) ? "Chưa phân nhóm" : vaccine.NhomVaccine)</td>
                                        <td>@HienThiDoTuoi(vaccine)</td>
                                        <td>
                                            <span class="dashboard-status @(vaccine.TrangThai ? "active" : "inactive")">
                                                @(vaccine.TrangThai ? "Đang dùng" : "Ngừng dùng")
                                            </span>
                                        </td>
                                        <td><a class="outline-small" href="/vaccine/edit/@vaccine.MaVaccine">Sửa</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <a class="card-more" href="/vaccine/index">Xem tất cả vaccine <i class="bi bi-arrow-right"></i></a>
                }
            </article>

            <article class="dashboard-card">
                <div class="card-head">
                    <h2>Bài viết cẩm nang mới nhất</h2>
                    <a class="text-link" href="/AdminBaiViet/Index">Xem tất cả <i class="bi bi-arrow-right"></i></a>
                </div>

                @if (Model.LatestGuideArticles.Count == 0)
                {
                    <div class="dashboard-empty">Chưa có bài viết cẩm nang.</div>
                }
                else
                {
                    <div class="article-list">
                        @foreach (var article in Model.LatestGuideArticles)
                        {
                            <a class="article-row" href="/AdminBaiViet/Edit?maBaiViet=@article.MaBaiViet">
                                <span class="article-thumb">
                                    @if (!string.IsNullOrWhiteSpace(article.AnhDaiDien))
                                    {
                                        <img src="@article.AnhDaiDien" alt="@article.TieuDe" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image"></i>
                                    }
                                </span>
                                <span class="article-copy">
                                    <strong>@article.TieuDe</strong>
                                    <span>@RutGon(article.MoTaNgan, 130)</span>
                                    <small>@article.NgayTao.ToString("dd/MM/yyyy") · @HienThiLuotXem(article.LuotXem) lượt xem</small>
                                </span>
                            </a>
                        }
                    </div>
                }
            </article>
        </div>

        <div class="dashboard-column">
            <article class="dashboard-card">
                <div class="card-head">
                    <h2>Câu hỏi tư vấn mới</h2>
                    <a class="text-link" href="/cauHoiTuVan/index">Xem tất cả <i class="bi bi-arrow-right"></i></a>
                </div>

                @if (Model.RecentQuestions.Count == 0)
                {
                    <div class="dashboard-empty">Chưa có câu hỏi tư vấn.</div>
                }
                else
                {
                    <div class="question-feed">
                        @foreach (var question in Model.RecentQuestions)
                        {
                            var answered = string.Equals(question.TrangThai, "Đã trả lời", StringComparison.OrdinalIgnoreCase);
                            var tenNguoiGui = string.IsNullOrWhiteSpace(question.TenNguoiGui) ? "Người dùng" : question.TenNguoiGui;
                            <a class="question-feed-item" href="/cauHoiTuVan/traLoi/@question.MaCauHoi">
                                <span class="question-avatar">@LayChuCai(tenNguoiGui)</span>
                                <span class="question-feed-copy">
                                    <strong>@tenNguoiGui</strong>
                                    <span>@RutGon(question.CauHoi, 90)</span>
                                    <small>@question.NgayGui.ToString("dd/MM/yyyy HH:mm") · @(answered ? "Đã trả lời" : "Chờ trả lời")</small>
                                </span>
                                <span class="dashboard-status @(answered ? "active" : "pending")">@(answered ? "Đã trả lời" : "Chờ trả lời")</span>
                            </a>
                        }
                    </div>
                }
            </article>

            <article class="dashboard-card">
                <div class="card-head">
                    <h2>Hoạt động hệ thống</h2>
                </div>
                <div class="system-grid">
                    <div class="system-item blue"><i class="bi bi-person-plus"></i><span>Người dùng mới (7 ngày)</span><strong>@Model.NewUsers7Days.ToString("N0")</strong></div>
                    <div class="system-item green"><i class="bi bi-file-earmark-text"></i><span>Bài viết mới (7 ngày)</span><strong>@Model.NewArticles7Days.ToString("N0")</strong></div>
                    <div class="system-item violet"><i class="bi bi-calendar2-week"></i><span>Lịch hẹn sắp tới</span><strong>@Model.UpcomingAppointments.ToString("N0")</strong></div>
                    <div class="system-item blue"><i class="bi bi-shield-check"></i><span>Vaccine đang dùng</span><strong>@Model.ActiveVaccines.ToString("N0")</strong></div>
                    <div class="system-item green"><i class="bi bi-chat-square-check"></i><span>Câu hỏi đã trả lời (7 ngày)</span><strong>@Model.AnsweredQuestions7Days.ToString("N0")</strong></div>
                    <div class="system-item violet"><i class="bi bi-clipboard2-pulse"></i><span>Mũi tiêm đã ghi nhận</span><strong>@Model.RecordedInjections.ToString("N0")</strong></div>
                </div>
                <p class="system-updated">Cập nhật lúc @Model.LastUpdated.ToString("HH:mm, dd/MM/yyyy")</p>
            </article>
        </div>
    </section>
</section>

<style>
    .admin-dashboard {
        color: #0f172a;
    }

    .dashboard-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
    }

    .dashboard-top h1 {
        margin: 0;
        color: #0f172a;
        font-size: 30px;
        font-weight: 800;
        letter-spacing: 0;
    }

    .dashboard-top p {
        margin: 7px 0 0;
        color: #64748b;
        font-size: 15px;
    }

    .dashboard-tools {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .dashboard-search {
        display: grid;
        grid-template-columns: 20px minmax(0, 1fr) auto;
        align-items: center;
        gap: 9px;
        width: 310px;
        height: 44px;
        padding: 0 12px;
        border: 1px solid #dbe5f0;
        border-radius: 10px;
        color: #64748b;
        background: #ffffff;
    }

    .dashboard-search input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        color: #0f172a;
        background: transparent;
        font: inherit;
    }

    .dashboard-search span {
        padding: 3px 7px;
        border-radius: 7px;
        color: #64748b;
        background: #f1f5f9;
        font-size: 12px;
        font-weight: 800;
    }

    .notification-button {
        position: relative;
        width: 44px;
        height: 44px;
        border: 1px solid #dbe5f0;
        border-radius: 12px;
        color: #0f172a;
        background: #ffffff;
        font-size: 18px;
    }

    .notification-button span {
        position: absolute;
        top: -5px;
        right: -4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        border-radius: 999px;
        color: #ffffff;
        background: #ef4444;
        font-size: 11px;
        font-weight: 800;
    }

    .admin-user-menu {
        position: relative;
    }

    .admin-user-menu summary {
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr) 16px;
        align-items: center;
        gap: 10px;
        min-width: 190px;
        min-height: 48px;
        padding: 7px 12px;
        border: 1px solid #dbe5f0;
        border-radius: 12px;
        background: #ffffff;
        cursor: pointer;
        list-style: none;
    }

    .admin-user-menu summary::-webkit-details-marker {
        display: none;
    }

    .admin-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        color: #64748b;
        background: #eef2f7;
    }

    .admin-user-menu strong,
    .admin-user-menu small {
        display: block;
    }

    .admin-user-menu strong {
        color: #0f172a;
        font-size: 14px;
        font-weight: 800;
    }

    .admin-user-menu small {
        color: #64748b;
        font-size: 12px;
        margin-top: 2px;
    }

    .admin-user-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 170px;
        padding: 8px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #ffffff;
        box-shadow: 0 18px 40px rgba(15, 23, 42, .14);
        z-index: 30;
    }

    .admin-user-dropdown a {
        display: block;
        padding: 9px 10px;
        border-radius: 8px;
        color: #0f172a;
        font-weight: 700;
    }

    .admin-user-dropdown a:hover {
        color: #0866d8;
        background: #eff6ff;
    }

    .dashboard-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 20px;
    }

    .dashboard-stat-card {
        display: grid;
        grid-template-columns: 58px minmax(0, 1fr);
        gap: 16px;
        min-height: 150px;
        padding: 24px;
        border: 1px solid #e5edf7;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .04);
    }

    .stat-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: 16px;
        font-size: 26px;
    }

    .blue .stat-icon,
    .system-item.blue i {
        color: #0d6efd;
        background: #eaf3ff;
    }

    .green .stat-icon,
    .system-item.green i {
        color: #16a34a;
        background: #dcfce7;
    }

    .violet .stat-icon,
    .system-item.violet i {
        color: #7c3aed;
        background: #ede9fe;
    }

    .orange .stat-icon {
        color: #c2410c;
        background: #ffedd5;
    }

    .stat-copy {
        display: grid;
        align-content: start;
        gap: 5px;
        min-width: 0;
    }

    .stat-copy span {
        color: #334155;
        font-size: 14px;
        font-weight: 800;
    }

    .stat-copy strong {
        color: #0866d8;
        font-size: 34px;
        font-weight: 850;
        line-height: 1;
    }

    .stat-copy small {
        color: #64748b;
        font-size: 13px;
        font-weight: 650;
    }

    .stat-copy a,
    .card-more,
    .text-link {
        color: #0866d8;
        font-size: 14px;
        font-weight: 800;
    }

    .stat-copy a {
        margin-top: 8px;
    }

    .dashboard-main-grid {
        display: grid;
        grid-template-columns: 1.08fr .92fr;
        gap: 20px;
        align-items: start;
    }

    .dashboard-column {
        display: grid;
        gap: 20px;
        min-width: 0;
    }

    .dashboard-card {
        border: 1px solid #e5edf7;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .04);
        padding: 20px;
        overflow: hidden;
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 16px;
    }

    .card-head h2 {
        margin: 0;
        color: #0f172a;
        font-size: 20px;
        font-weight: 850;
        letter-spacing: 0;
    }

    .primary-small,
    .outline-small {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: 8px;
        font-weight: 800;
        white-space: nowrap;
    }

    .primary-small {
        min-height: 40px;
        padding: 10px 16px;
        color: #ffffff;
        background: #0d6efd;
    }

    .outline-small {
        min-height: 32px;
        padding: 6px 12px;
        border: 1px solid #0d6efd;
        color: #0d6efd;
        background: #ffffff;
        font-size: 13px;
    }

    .table-wrap {
        overflow-x: auto;
    }

    .dashboard-table {
        width: 100%;
        min-width: 760px;
        border-collapse: collapse;
    }

    .dashboard-table th {
        padding: 12px;
        color: #64748b;
        background: #f8fafc;
        font-size: 12px;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .02em;
    }

    .dashboard-table td {
        height: 56px;
        padding: 12px;
        border-bottom: 1px solid #edf2f7;
        color: #334155;
        font-size: 14px;
        vertical-align: middle;
    }

    .dashboard-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .dashboard-table strong {
        color: #0f172a;
    }

    .dashboard-status {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 850;
        white-space: nowrap;
    }

    .dashboard-status.active {
        color: #15803d;
        background: #dcfce7;
    }

    .dashboard-status.pending {
        color: #c2410c;
        background: #ffedd5;
    }

    .dashboard-status.inactive {
        color: #64748b;
        background: #e2e8f0;
    }

    .card-more {
        display: inline-flex;
        margin-top: 14px;
    }

    .question-feed,
    .article-list {
        display: grid;
    }

    .question-feed-item {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr) auto;
        align-items: center;
        gap: 12px;
        min-height: 72px;
        padding: 12px 0;
        border-bottom: 1px solid #edf2f7;
        color: inherit;
    }

    .question-feed-item:last-child,
    .article-row:last-child {
        border-bottom: 0;
    }

    .question-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        color: #0866d8;
        background: #eaf3ff;
        font-weight: 850;
    }

    .question-feed-copy,
    .article-copy {
        display: grid;
        gap: 4px;
        min-width: 0;
    }

    .question-feed-copy strong,
    .article-copy strong {
        color: #0f172a;
        font-weight: 850;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .question-feed-copy span,
    .article-copy span,
    .question-feed-copy small,
    .article-copy small {
        color: #64748b;
        font-size: 13px;
        line-height: 1.45;
    }

    .question-feed-copy span,
    .article-copy span {
        display: -webkit-box;
        overflow: hidden;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .article-row {
        display: grid;
        grid-template-columns: 120px minmax(0, 1fr);
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid #edf2f7;
        color: inherit;
    }

    .article-thumb {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 120px;
        height: 80px;
        overflow: hidden;
        border-radius: 8px;
        color: #0866d8;
        background: #eaf3ff;
        font-size: 28px;
    }

    .article-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .system-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .system-item {
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
        min-height: 58px;
        padding: 12px;
        border: 1px solid #edf2f7;
        border-radius: 12px;
        background: #ffffff;
    }

    .system-item i {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        font-size: 18px;
    }

    .system-item span {
        color: #475569;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.35;
    }

    .system-item strong {
        color: #0f172a;
        font-size: 18px;
        font-weight: 850;
    }

    .system-updated {
        margin: 14px 0 0;
        color: #64748b;
        font-size: 13px;
        text-align: right;
    }

    .dashboard-empty {
        padding: 20px;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        color: #64748b;
        background: #f8fafc;
        font-weight: 750;
    }

    @@media (max-width: 1280px) {
        .dashboard-stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-main-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 820px) {
        .dashboard-top,
        .dashboard-tools {
            align-items: stretch;
            flex-direction: column;
        }

        .dashboard-search,
        .admin-user-menu summary {
            width: 100%;
        }

        .dashboard-stats-grid,
        .system-grid {
            grid-template-columns: 1fr;
        }

        .question-feed-item {
            grid-template-columns: 44px minmax(0, 1fr);
        }

        .question-feed-item .dashboard-status {
            grid-column: 2;
            justify-self: start;
        }
    }

    @@media (max-width: 560px) {
        .dashboard-stat-card,
        .article-row {
            grid-template-columns: 1fr;
        }
    }
</style>

@functions {
    private static string HienThiDoTuoi(Vaccine vaccine)
    {
        if (vaccine.DoTuoiToiThieu == null && vaccine.DoTuoiToiDa == null)
        {
            return "Chưa nhập";
        }

        var donVi = string.IsNullOrWhiteSpace(vaccine.DonViTuoi) ? "tháng" : vaccine.DonViTuoi;
        if (vaccine.DoTuoiToiThieu != null && vaccine.DoTuoiToiDa != null)
        {
            return $"{vaccine.DoTuoiToiThieu}-{vaccine.DoTuoiToiDa} {donVi}";
        }

        if (vaccine.DoTuoiToiThieu != null)
        {
            return $"Từ {vaccine.DoTuoiToiThieu} {donVi}";
        }

        return $"Đến {vaccine.DoTuoiToiDa} {donVi}";
    }

    private static string RutGon(string? noiDung, int gioiHan)
    {
        if (string.IsNullOrWhiteSpace(noiDung))
        {
            return "Chưa có mô tả.";
        }

        var text = noiDung.Trim();
        return text.Length <= gioiHan ? text : text[..gioiHan].TrimEnd() + "...";
    }

    private static string LayChuCai(string hoTen)
    {
        var text = string.IsNullOrWhiteSpace(hoTen) ? "A" : hoTen.Trim();
        return text[..1].ToUpperInvariant();
    }

    private static string HienThiLuotXem(int luotXem)
    {
        return luotXem >= 1000 ? $"{luotXem / 1000d:0.#}k" : luotXem.ToString("N0");
    }
}
