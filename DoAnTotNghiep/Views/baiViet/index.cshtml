@* Khu vực giao diện của view index.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model List<baiVietCamNangModels>
@{
    ViewData["Title"] = "Bài viết cẩm nang";
    var laAdmin = string.Equals(Context.Session.GetString("VaiTro"), "Admin", StringComparison.OrdinalIgnoreCase);
}

<div class="list-page-head">
    <div>
        <h2>Bài viết cẩm nang</h2>
        <p>@Model.Count bài viết trong hệ thống</p>
    </div>
    @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
    @if (laAdmin)
    {
        <a asp-action="them" class="btn btn-primary">Thêm bài viết</a>
    }
</div>

<section class="list-card">
<table class="table list-table">
    <thead><tr><th>Bài viết</th><th>Tác giả</th><th>Ngày tạo</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
    <tbody>
    @* Vòng lặp bên dưới duyệt danh sách dữ liệu do Controller truyền sang để hiển thị từng dòng/từng mục trên giao diện. *@
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <div class="item-title">@item.tieuDe</div>
                <div class="item-meta">Mã bài viết #@item.maBaiViet</div>
            </td>
            <td>@item.tenTacGia</td>
            <td>@item.ngayTao.ToString("dd/MM/yyyy")</td>
            <td>
                <span class="status-badge @(item.trangThai ? "status-ok" : "status-muted")">
                    @(item.trangThai ? "Hiển thị" : "Ẩn")
                </span>
            </td>
            <td class="table-actions">
                <a asp-action="chiTiet" asp-route-id="@item.maBaiViet" class="btn btn-sm btn-outline-secondary">Xem</a>
                @* Khối điều kiện bên dưới chỉ hiển thị nội dung khi dữ liệu hoặc trạng thái tương ứng tồn tại. *@
                @if (laAdmin)
                {
                    <a asp-action="sua" asp-route-id="@item.maBaiViet" class="btn btn-sm btn-outline-primary">Sửa</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</section>
