@* Khu vực giao diện của view chiTiet.
   View này nhận dữ liệu từ Controller/Model và hiển thị cho người dùng theo đúng chức năng của màn hình. *@
@model baiVietCamNangModels
@{
    ViewData["Title"] = Model.tieuDe;
}

<h2>@Model.tieuDe</h2>
<p class="text-muted">Tác giả: @Model.tenTacGia - @Model.ngayTao.ToString("dd/MM/yyyy")</p>
<div class="border p-3 mb-3" style="white-space: pre-wrap">@Model.noiDung</div>
<a asp-action="index" class="btn btn-link">Quay lại</a>
